				x.TextColor3 = Color3.fromRGB(255, 255, 255); x.Text = "✕"; x.ZIndex = 1702
				C.Corner(x, Z100.Theme.Tokens.Radius.Pill)
				x.MouseButton1Click:Connect(function() v:Destroy() end)
