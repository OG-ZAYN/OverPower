	-- [SECTION D : BLOCKS, REPORTS, DM PERMISSIONS, PRESENCE & NOTIFS]
	-- ===================================================================== --
	function Backend.FetchMyBlocks()
		local raw = DB.Get(Nodes.Blocks .. "/" .. Z100.MyUid)
		State.Blocks = type(raw) == "table" and raw or {}
		return State.Blocks
	end

	function Backend.IsBlocked(uid)
		local uStr = Util.NormalizeUid(uid)
		return uStr ~= nil and State.Blocks[uStr] == true
	end

	function Backend.IsBlockedBy(uid)
		local uStr = Util.NormalizeUid(uid)
		return uStr ~= nil and State.BlockedBy[uStr] == true
	end

	function Backend.BlockUser(uid)
		local uStr = Util.NormalizeUid(uid)
		if not uStr or uStr == Z100.MyUid then return false end
		DB.Put(Nodes.Blocks .. "/" .. Z100.MyUid .. "/" .. uStr, true)
		State.Blocks[uStr] = true
		Backend.UnfollowUser(uStr)
		Backend.RemoveFollower(uStr)
		return true
	end

	function Backend.UnblockUser(uid)
		local uStr = Util.NormalizeUid(uid)
		if not uStr then return false end
		DB.Delete(Nodes.Blocks .. "/" .. Z100.MyUid .. "/" .. uStr)
		State.Blocks[uStr] = nil
		return true
	end

	function Backend.ReportUser(targetUid, reason)
		local tStr = Util.NormalizeUid(targetUid)
		if not tStr then return false, "Invalid user." end
		local rId = "UR_" .. tostring(Util.Now()) .. "_" .. Util.GenerateKey(4)
		local ok, err = DB.Put(Nodes.Reports .. "/" .. rId, {
			id = rId,
			targetUid = tStr,
			reporterUid = Z100.MyUid,
			reporterName = Z100.MyName,
			reason = tostring(reason or "Inappropriate"):sub(1, 140),
			timestamp = Util.Now(),
		})
		return ok, err
	end

	function Backend.CanMessageUser(targetUid)
		local tStr = Util.NormalizeUid(targetUid)
		if not tStr or tStr == Z100.MyUid then return false, "Invalid recipient." end
		if Backend.IsBlocked(tStr) or Backend.IsBlockedBy(tStr) then return false, "Messaging blocked." end
		local prof = Backend.FetchProfile(tStr, false)
		local perm = (prof and prof.privacy and prof.privacy.dmPermission) or "Everyone"
		if perm == "None" then return false, "User has disabled DMs." end
		if perm == "Followers" and not Backend.IsFollowing(tStr) then return false, "Only followers can DM this user." end
		if perm == "Mutuals" and not Backend.IsMutual(tStr) then return false, "Only mutual followers can DM this user." end
		return true, nil
	end

	function Backend.HeartbeatPresence()
		DB.PutAsync(Nodes.Presence .. "/" .. Z100.MyUid, Util.Now())
		State.Presence[Z100.MyUid] = Util.Now()
	end

	function Backend.FetchPresence(uid)
		local uStr = Util.NormalizeUid(uid)
		if not uStr then return false end
		if Players:GetPlayerByUserId(tonumber(uStr) or 0) then
			State.Presence[uStr] = Util.Now()
			return true
		end
		local ts = tonumber(DB.Get(Nodes.Presence .. "/" .. uStr)) or 0
		State.Presence[uStr] = ts
		return (Util.Now() - ts) <= 65
	end

	function Backend.IsOnlineCached(uid)
		local uStr = Util.NormalizeUid(uid)
		if not uStr then return false end
		if Players:GetPlayerByUserId(tonumber(uStr) or 0) then return true end
		return (Util.Now() - (tonumber(State.Presence[uStr]) or 0)) <= 65
	end

	function Backend.SendNotif(targetUid, nType, title, message)
		local tStr = Util.NormalizeUid(targetUid)
		if not tStr then return end
		local nId = "N_" .. tostring(Util.Now()) .. "_" .. Util.GenerateKey(4)
		DB.PutAsync(Nodes.Notifs .. "/" .. tStr .. "/" .. nId, {
			id = nId,
			type = tostring(nType or "info"),
			title = tostring(title or "Notification"):sub(1, 50),
			message = tostring(message or ""):sub(1, 140),
			fromUid = Z100.MyUid,
			timestamp = Util.Now(),
			read = false,
		})
	end

	function Backend.FetchMyNotifs(silent)
		local raw = DB.Get(Nodes.Notifs .. "/" .. Z100.MyUid)
		local list, unread = {}, 0
		if type(raw) == "table" then
			for id, item in pairs(raw) do
				if type(item) == "table" then
					item.id = item.id or id
					table.insert(list, item)
					if item.read ~= true then
						unread = unread + 1
						if not silent and not State.SeenNotifIds[item.id] then
							State.SeenNotifIds[item.id] = true
							if State.Prefs.NotifyFollows then
								Z100.UI.ShowToast(item.title, item.message, Z100.Theme.Get().Accent, item.fromUid)
							end
						end
					end
					State.SeenNotifIds[item.id] = true
				end
			end
		end
		table.sort(list, function(a, b) return (tonumber(a.timestamp) or 0) > (tonumber(b.timestamp) or 0) end)
		State.Notifs = list
		State.UnreadNotifs = unread
		return list
	end

	function Backend.MarkNotifRead(nId)
		if not nId then return end
		DB.PutAsync(Nodes.Notifs .. "/" .. Z100.MyUid .. "/" .. tostring(nId) .. "/read", true)
	end

	function Backend.MarkAllNotifsRead()
		for _, item in ipairs(State.Notifs) do
			if item.read ~= true and item.id then
				item.read = true
				DB.PutAsync(Nodes.Notifs .. "/" .. Z100.MyUid .. "/" .. item.id .. "/read", true)
			end
		end
		State.UnreadNotifs = 0
		if Z100.UI.UpdateBadges then Z100.UI.UpdateBadges() end
	end

