	-- Compact Modal Fitted Inside 400x380 Window (Zero Overflow)
	function C.OpenModal(props)
		local host = Z100.UI.ModalLayer or Z100.UI.MainFrame
		if not host then return nil end

		local modalName = props.Name or "ZaynV100_ActiveModal"
		local old = host:FindFirstChild(modalName)
		if old then old:Destroy() end

		local p = Z100.Theme.Get()
		local backdrop = Instance.new("Frame", host)
		backdrop.Name = modalName
		backdrop.Size = UDim2.new(1, 0, 1, 0)
		backdrop.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		backdrop.BackgroundTransparency = 0.42
		backdrop.ClipsDescendants = true
		backdrop.Active = true
		backdrop.ZIndex = props.ZIndex or 300

		local catcher = Instance.new("TextButton", backdrop)
		catcher.Size = UDim2.new(1, 0, 1, 0); catcher.BackgroundTransparency = 1; catcher.Text = ""; catcher.ZIndex = backdrop.ZIndex + 1

		local maxW = math.min(props.Width or 348, 368)
		local maxH = math.min(props.FixedHeight or 310, 336)

		local box = Instance.new("Frame", backdrop)
		box.Name = "ModalCard"
		if props.FixedHeight then
			box.Size = UDim2.new(0, maxW, 0, maxH)
		else
			box.Size = UDim2.new(0, maxW, 0, 0)
			box.AutomaticSize = Enum.AutomaticSize.Y
		end
		box.Position = UDim2.new(0.5, 0, 0.5, 0)
		box.AnchorPoint = Vector2.new(0.5, 0.5)
		box.BackgroundColor3 = p.Surface
		box.BorderSizePixel = 0
		box.ClipsDescendants = true
		box.ZIndex = backdrop.ZIndex + 2
		C.Corner(box, Z100.Theme.Tokens.Radius.MD)
		C.Stroke(box, props.AccentColor or p.BorderGlow, 1.3, 0.15)

		local function closeFn()
			if not backdrop or not backdrop.Parent then return end
			if type(props.OnClose) == "function" then pcall(props.OnClose) end
			backdrop:Destroy()
		end

		if props.CloseOnBackdrop ~= false then
			catcher.MouseButton1Click:Connect(closeFn)
		end

		local hdr = Instance.new("Frame", box)
		hdr.Size = UDim2.new(1, 0, 0, 36)
		hdr.BackgroundColor3 = p.SurfaceElev
		hdr.BorderSizePixel = 0
		hdr.ZIndex = box.ZIndex + 1

		local titleLbl = Instance.new("TextLabel", hdr)
		titleLbl.Size = UDim2.new(1, -44, 1, 0); titleLbl.Position = UDim2.new(0, 10, 0, 0)
		titleLbl.BackgroundTransparency = 1; titleLbl.Font = Z100.Theme.Tokens.Fonts.Heading; titleLbl.TextSize = 11.5
		titleLbl.TextColor3 = props.AccentColor or p.TextPrimary; titleLbl.TextXAlignment = Enum.TextXAlignment.Left
		titleLbl.ClipsDescendants = true; titleLbl.Text = tostring(props.Title or "Modal"); titleLbl.ZIndex = hdr.ZIndex + 1

		local closeBtn = Instance.new("TextButton", hdr)
		closeBtn.Size = UDim2.new(0, 24, 0, 24); closeBtn.Position = UDim2.new(1, -30, 0.5, -12)
		closeBtn.BackgroundColor3 = p.Card; closeBtn.Font = Z100.Theme.Tokens.Fonts.Heading; closeBtn.TextSize = 11
		closeBtn.TextColor3 = p.TextSecondary; closeBtn.Text = "✕"; closeBtn.ZIndex = hdr.ZIndex + 1
		C.Corner(closeBtn, Z100.Theme.Tokens.Radius.XS)
		closeBtn.MouseButton1Click:Connect(closeFn)

		local body = Instance.new("Frame", box)
		body.Name = "ModalBody"
		if props.FixedHeight then
			body.Size = UDim2.new(1, 0, 1, -36)
		else
			body.Size = UDim2.new(1, 0, 0, 0)
			body.AutomaticSize = Enum.AutomaticSize.Y
		end
		body.Position = UDim2.new(0, 0, 0, 36)
		body.BackgroundTransparency = 1
		body.ClipsDescendants = true
		body.ZIndex = box.ZIndex + 1
		C.Padding(body, 10, 10, 10, 10)
		if props.UseList ~= false then
			C.ListLayout(body, 8)
		end

		return { Backdrop = backdrop, Card = box, Body = body, Close = closeFn }
	end

