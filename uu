	function C.PromptDialog(title, placeholder, confirmLabel, onConfirm)
		local modal = C.OpenModal({ Name = "ZaynV100_PromptDialog", Title = title or "Enter Details", Width = 320 })
		if not modal then return end
		local _, box = C.TextInput(modal.Body, { Placeholder = placeholder or "Type here...", LayoutOrder = 1, ZIndex = modal.Body.ZIndex + 1 })
		local row = Instance.new("Frame", modal.Body)
		row.Size = UDim2.new(1, 0, 0, 30); row.BackgroundTransparency = 1; row.LayoutOrder = 2; row.ZIndex = modal.Body.ZIndex + 1
		C.Button(row, { Size = UDim2.new(0.48, 0, 1, 0), Variant = "secondary", Text = "Cancel", TextSize = 10, ZIndex = row.ZIndex + 1, OnClick = modal.Close })
		C.Button(row, {
			Size = UDim2.new(0.48, 0, 1, 0), Position = UDim2.new(0.52, 0, 0, 0),
			Variant = "primary", Text = confirmLabel or "Submit", TextSize = 10, ZIndex = row.ZIndex + 1,
			OnClick = function()
				local val = box.Text:match("^%s*(.-)%s*$") or ""
				if val ~= "" then modal.Close(); if type(onConfirm) == "function" then task.spawn(onConfirm, val) end end
			end,
		})
	end

