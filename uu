					img.Size = UDim2.new(1, -4, 1, -4)
					img.Position = UDim2.new(0.5, 0, 0.5, 0)
					img.AnchorPoint = Vector2.new(0.5, 0.5)
					img.BackgroundTransparency = 1
					img.ScaleType = Enum.ScaleType.Crop
					img.ZIndex = 28
					C.Corner(img, Z100.Theme.Tokens.Radius.Pill)
					Util.LoadAvatarHeadshot(img, bucket.uid, prof and prof.customAvatar)
					Z100.Anim.ApplyStoryRing(avHold, bucket.ring)

					local uLbl = Instance.new("TextLabel", item)
					uLbl.Size = UDim2.new(1, 0, 0, 14)
					uLbl.Position = UDim2.new(0, 0, 1, -14)
					uLbl.BackgroundTransparency = 1
					uLbl.Font = Z100.Theme.Tokens.Fonts.Title
					uLbl.TextSize = 8.5
					uLbl.TextColor3 = p.TextPrimary
					uLbl.ClipsDescendants = true
					uLbl.Text = (bucket.uid == Z100.MyUid) and "Your Story" or acc.DisplayName
					uLbl.ZIndex = 27

					item.MouseButton1Click:Connect(function()
						Z100.Stories.OpenViewer(bucket.uid, bucket.stories, 1)
					end)
				end
			end

			-- 2. My Active Stories Manager
			local myCard = C.Card(scroll, { Name = "MyActiveStoriesCard", LayoutOrder = 3, PadY = 8, PadX = 10, ZIndex = 24 })
			C.SectionHeader(myCard, "🎞️ My Active Stories (" .. tostring(#myStories) .. ")", nil, 1)

			if #myStories == 0 then
				local em = Instance.new("TextLabel", myCard)
				em.Size = UDim2.new(1, 0, 0, 22); em.BackgroundTransparency = 1; em.Font = Z100.Theme.Tokens.Fonts.Body
				em.TextSize = 9.5; em.TextColor3 = p.TextMuted; em.TextXAlignment = Enum.TextXAlignment.Left
				em.Text = "You have no active stories in the last 24h."; em.LayoutOrder = 2; em.ZIndex = 25
			else
				for idx, st in ipairs(myStories) do
					local row = Instance.new("Frame", myCard)
					row.Size = UDim2.new(1, 0, 0, 48)
					row.BackgroundColor3 = p.SurfaceElev
					row.ClipsDescendants = true
					row.LayoutOrder = idx + 1
					row.ZIndex = 25
					C.Corner(row, Z100.Theme.Tokens.Radius.XS)

					local thumb = Instance.new("ImageLabel", row)
					thumb.Size = UDim2.new(0, 36, 0, 36); thumb.Position = UDim2.new(0, 6, 0.5, -18)
					thumb.BackgroundColor3 = p.BgRoot; thumb.ScaleType = Enum.ScaleType.Crop; thumb.ZIndex = 26
					C.Corner(thumb, Z100.Theme.Tokens.Radius.XS)
					Util.LoadImageSafe(thumb, st.imageRef)

					local info = Instance.new("TextLabel", row)
					info.Size = UDim2.new(1, -138, 1, -6); info.Position = UDim2.new(0, 48, 0, 3)
					info.BackgroundTransparency = 1; info.Font = Z100.Theme.Tokens.Fonts.Body; info.TextSize = 9.5
					info.TextColor3 = p.TextPrimary; info.TextXAlignment = Enum.TextXAlignment.Left
					info.TextWrapped = true; info.ClipsDescendants = true; info.RichText = true; info.ZIndex = 26
					local cap = (st.caption and st.caption ~= "") and st.caption:sub(1, 26) or "Photo Story"
					local musTag = (type(st.music) == "table" and st.music.title) and (" • ♫ " .. tostring(st.music.title):sub(1, 14)) or ""
					info.Text = string.format("<b>%s</b>\n<font color='#%s' size='9'>%s • %s%s</font>",
						Util.EscapeRichText(cap), p.TextSecondary:ToHex(), tostring(st.privacy or "Public"),
						Util.TimeAgo(st.createdAt), Util.EscapeRichText(musTag))

					C.Button(row, {
						Size = UDim2.new(0, 46, 0, 24), Position = UDim2.new(1, -84, 0.5, -12),
						Variant = "primary", Text = "View", TextSize = 9, ZIndex = 26,
						OnClick = function() Z100.Stories.OpenViewer(Z100.MyUid, myStories, idx) end,
					})
					C.Button(row, {
						Size = UDim2.new(0, 30, 0, 24), Position = UDim2.new(1, -34, 0.5, -12),
						Variant = "danger", Text = "🗑", TextSize = 10, ZIndex = 26,
						OnClick = function()
							C.ConfirmDialog("Delete Story", "Permanently delete this active story?", "Delete", "danger", function()
								local ok, msg = Backend.DeleteStory(Z100.MyUid, st.id)
								Z100.UI.ShowToast(ok and "🗑 Deleted" or "⚠️ Error", msg, p.Danger)
								Z100.Router.Navigate("Stories")
							end)
						end,
					})
				end
			end
		end)
	end

	-- ===================================================================== --
	-- [SECTION B : STORY CREATION EDITOR WITH 15-SEC CUSTOM MUSIC TRIMMER]
	-- ===================================================================== --
	function Z100.Screens.RenderStoryEditor(host)
		if not host or not host.Parent then return end

		storyEditorSeq = storyEditorSeq + 1
		Z100.Music.StopAudio("ZaynV100_StoryAudio")
		local p = Z100.Theme.Get()

		if Z100.UI.HeaderTitle then Z100.UI.HeaderTitle.Text = "CREATE STORY" end
		if Z100.UI.HeaderSub then Z100.UI.HeaderSub.Text = "Photo & custom 15s music clip" end

		local scroll = Instance.new("ScrollingFrame", host)
		scroll.Name = "ZaynV100_StoryEditorScroll"
		scroll.Size = UDim2.new(1, 0, 1, 0)
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.ScrollBarThickness = 2
		scroll.ScrollBarImageColor3 = p.Accent
		scroll.ClipsDescendants = true
		scroll.ZIndex = 22

		local list = C.ListLayout(scroll, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Center)
		C.Padding(scroll, 8, 10, 18, 10)
		C.AttachAutoCanvas(scroll, list, 22)

		local prof = State.Profiles[Z100.MyUid]
		local defaultPriv = (prof and prof.privacy and prof.privacy.storyPrivacy) or "Public"

		local draft = {
			imageRef = "",
			caption = "",
			overlayText = "",
			sticker = "",
			bgHex = "obsidian",
			privacy = defaultPriv,
			music = Z100.Stories.DraftMusic,
		}

		-- 1. COMPACT LIVE PREVIEW CANVAS
		local pvCard = C.Card(scroll, {
			Name = "StoryLivePreviewWrap",
			LayoutOrder = 1,
			FixedHeight = true,
			Size = UDim2.new(1, 0, 0, 154),
			StrokeColor = p.BorderGlow,
			Padding = false,
			UseList = false,
			ZIndex = 24,
		})

		local canvas = Instance.new("Frame", pvCard)
		canvas.Size = UDim2.new(0, 108, 0, 142)
		canvas.Position = UDim2.new(0.5, 0, 0.5, 0)
		canvas.AnchorPoint = Vector2.new(0.5, 0.5)
		canvas.BackgroundColor3 = Z100.Stories.Backgrounds[1].c1
		canvas.ClipsDescendants = true
		canvas.ZIndex = 25
		C.Corner(canvas, Z100.Theme.Tokens.Radius.SM)

		local pvGrad = Instance.new("UIGradient", canvas)
		pvGrad.Rotation = 135
		pvGrad.Color = ColorSequence.new(Z100.Stories.Backgrounds[1].c1, Z100.Stories.Backgrounds[1].c2)

		local pvImg = Instance.new("ImageLabel", canvas)
		pvImg.Size = UDim2.new(1, 0, 1, 0); pvImg.BackgroundTransparency = 1; pvImg.ScaleType = Enum.ScaleType.Crop; pvImg.Image = ""; pvImg.ZIndex = 26

		local pvHint = Instance.new("TextLabel", canvas)
		pvHint.Size = UDim2.new(1, -10, 0, 40); pvHint.Position = UDim2.new(0, 5, 0.5, -20); pvHint.BackgroundTransparency = 1
		pvHint.Font = Z100.Theme.Tokens.Fonts.Title; pvHint.TextSize = 9; pvHint.TextColor3 = p.TextSecondary; pvHint.TextWrapped = true
		pvHint.Text = "◎ Live Preview\nPaste Asset ID / URL"; pvHint.ZIndex = 27

		local pvSticker = Instance.new("TextLabel", canvas)
		pvSticker.Size = UDim2.new(0, 32, 0, 32); pvSticker.Position = UDim2.new(1, -36, 0, 6); pvSticker.BackgroundTransparency = 1
		pvSticker.Font = Z100.Theme.Tokens.Fonts.Heading; pvSticker.TextSize = 20; pvSticker.Text = ""; pvSticker.ZIndex = 28

		local pvOverlay = Instance.new("TextLabel", canvas)
		pvOverlay.Size = UDim2.new(1, -10, 0, 24); pvOverlay.Position = UDim2.new(0, 5, 0.46, -12)
		pvOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0); pvOverlay.BackgroundTransparency = 1
		pvOverlay.Font = Z100.Theme.Tokens.Fonts.Heading; pvOverlay.TextSize = 10; pvOverlay.TextColor3 = Color3.fromRGB(255, 255, 255)
		pvOverlay.TextWrapped = true; pvOverlay.Text = ""; pvOverlay.ZIndex = 28
		C.Corner(pvOverlay, Z100.Theme.Tokens.Radius.XS)

		local pvMusicPill = Instance.new("TextLabel", canvas)
		pvMusicPill.Size = UDim2.new(1, -8, 0, 16); pvMusicPill.Position = UDim2.new(0, 4, 0, 4)
		pvMusicPill.BackgroundColor3 = Color3.fromRGB(10, 14, 24); pvMusicPill.BackgroundTransparency = 0.22
		pvMusicPill.Font = Z100.Theme.Tokens.Fonts.Title; pvMusicPill.TextSize = 8; pvMusicPill.TextColor3 = Color3.fromRGB(0, 240, 195)
		pvMusicPill.ClipsDescendants = true; pvMusicPill.Visible = false; pvMusicPill.ZIndex = 28
		C.Corner(pvMusicPill, Z100.Theme.Tokens.Radius.Pill)

		local pvCaption = Instance.new("TextLabel", canvas)
		pvCaption.Size = UDim2.new(1, -8, 0, 26); pvCaption.Position = UDim2.new(0, 4, 1, -28)
		pvCaption.BackgroundColor3 = Color3.fromRGB(0, 0, 0); pvCaption.BackgroundTransparency = 0.42
		pvCaption.Font = Z100.Theme.Tokens.Fonts.Body; pvCaption.TextSize = 8.5; pvCaption.TextColor3 = Color3.fromRGB(255, 255, 255)
		pvCaption.TextWrapped = true; pvCaption.Visible = false; pvCaption.ZIndex = 28
		C.Corner(pvCaption, Z100.Theme.Tokens.Radius.XS)

		local function syncPreview()
			local bgObj = Z100.Stories.BackgroundMap[draft.bgHex] or Z100.Stories.Backgrounds[1]
			canvas.BackgroundColor3 = bgObj.c1
			pvGrad.Color = ColorSequence.new(bgObj.c1, bgObj.c2)
			if draft.imageRef ~= "" then
				pvHint.Visible = false
				Util.LoadImageSafe(pvImg, draft.imageRef)
			else
				pvImg.Image = ""; pvHint.Visible = true
			end
			pvOverlay.Text = draft.overlayText
			pvOverlay.BackgroundTransparency = (draft.overlayText ~= "") and 0.45 or 1
			pvSticker.Text = draft.sticker
			pvCaption.Text = draft.caption
			pvCaption.Visible = (draft.caption ~= "")
			if type(draft.music) == "table" and tostring(draft.music.videoId or "") ~= "" then
				pvMusicPill.Visible = true
				pvMusicPill.Text = "♫ " .. tostring(draft.music.title or "Track"):sub(1, 14)
			else
				pvMusicPill.Visible = false
			end
		end
		syncPreview()

		-- 2. EDITOR CONTROLS CARD
		local ctrl = C.Card(scroll, { Name = "StoryEditorControls", LayoutOrder = 2, PadY = 8, PadX = 10, ZIndex = 24 })

		C.TextInput(ctrl, {
			Placeholder = "🖼️ Photo: Asset ID or Image URL...",
			LayoutOrder = 1, ZIndex = 25,
			OnChange = function(v) draft.imageRef = v:gsub("^%s+", ""):gsub("%s+$", ""); syncPreview() end,
		})
		C.TextInput(ctrl, {
			Placeholder = "✍️ Caption (optional)...",
			LayoutOrder = 2, ZIndex = 25,
			OnChange = function(v) draft.caption = v:sub(1, Z100.Config.Limits.StoryCaptionMax); syncPreview() end,
		})
		C.TextInput(ctrl, {
			Placeholder = "🔤 Center Text Overlay (optional)...",
			LayoutOrder = 3, ZIndex = 25,
			OnChange = function(v) draft.overlayText = v:sub(1, Z100.Config.Limits.StoryOverlayMax); syncPreview() end,
		})

		-- Stickers Strip
		local stkScroll = Instance.new("ScrollingFrame", ctrl)
		stkScroll.Size = UDim2.new(1, 0, 0, 28); stkScroll.BackgroundTransparency = 1; stkScroll.ScrollBarThickness = 0
		stkScroll.ScrollingDirection = Enum.ScrollingDirection.X; stkScroll.AutomaticCanvasSize = Enum.AutomaticSize.X
		stkScroll.CanvasSize = UDim2.new(0, 0, 0, 0); stkScroll.LayoutOrder = 4; stkScroll.ZIndex = 25
		C.ListLayout(stkScroll, 4, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

		for idx, em in ipairs(Z100.Stories.QuickStickers) do
			C.Button(stkScroll, {
				Size = UDim2.new(0, 26, 0, 24), Variant = "secondary",
				Text = em == "" and "Off" or em, TextSize = em == "" and 8.5 or 12,
				LayoutOrder = idx, ZIndex = 26,
				OnClick = function() draft.sticker = em; syncPreview() end,
			})
		end

		-- Background Swatches
		local bgRow = Instance.new("Frame", ctrl)
		bgRow.Size = UDim2.new(1, 0, 0, 24); bgRow.BackgroundTransparency = 1; bgRow.LayoutOrder = 5; bgRow.ZIndex = 25
		C.ListLayout(bgRow, 4, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

		for idx, bgObj in ipairs(Z100.Stories.Backgrounds) do
			local sw = Instance.new("TextButton", bgRow)
			sw.Size = UDim2.new(0.158, 0, 1, 0); sw.BackgroundColor3 = bgObj.c2; sw.AutoButtonColor = false
			sw.Font = Z100.Theme.Tokens.Fonts.Title; sw.TextSize = 8; sw.TextColor3 = Color3.fromRGB(255, 255, 255)
			sw.Text = bgObj.name; sw.LayoutOrder = idx; sw.ZIndex = 26
			C.Corner(sw, Z100.Theme.Tokens.Radius.XS)
			Instance.new("UIGradient", sw).Color = ColorSequence.new(bgObj.c1, bgObj.c2)
			sw.MouseButton1Click:Connect(function() draft.bgHex = bgObj.id; syncPreview() end)
		end

		-- 3. STORY MUSIC TRIMMER BOX (CUSTOM START SEC + MAX 15 SEC CLIP)
		local musicBox = C.Card(ctrl, {
			Name = "StoryMusicAttachment",
			LayoutOrder = 6,
			BackgroundColor3 = p.SurfaceElev,
			StrokeColor = Color3.fromRGB(0, 210, 175),
			PadY = 8,
			PadX = 8,
			ListGap = 6,
			ZIndex = 25,
		})

		local mLbl = Instance.new("TextLabel", musicBox)
		mLbl.Size = UDim2.new(1, 0, 0, 16); mLbl.BackgroundTransparency = 1; mLbl.Font = Z100.Theme.Tokens.Fonts.Title
		mLbl.TextSize = 9.5; mLbl.TextColor3 = Color3.fromRGB(0, 238, 195); mLbl.TextXAlignment = Enum.TextXAlignment.Left
		mLbl.ClipsDescendants = true; mLbl.LayoutOrder = 1; mLbl.ZIndex = 26

		local function updateMusicLbl()
			local hasPass = Backend.HasMusicStudioPass(Z100.MyUid)
			if not hasPass then
				mLbl.Text = "🔒 Story Music Locked — ₹" .. tostring(Backend.GetMusicPassPrice()) .. " Studio Pass"
			elseif type(draft.music) == "table" and tostring(draft.music.videoId or "") ~= "" then
				mLbl.Text = string.format("♫ %s (%ds • %ds clip)",
					tostring(draft.music.title):sub(1, 18),
					math.floor(draft.music.startTime or 0),
					math.clamp(math.floor(draft.music.clipDuration or 15), 3, 15))
			else
				mLbl.Text = "♫ Story Music: None (Tap Pick Song)"
			end
		end
		updateMusicLbl()

		local mBtnRow = Instance.new("Frame", musicBox)
		mBtnRow.Size = UDim2.new(1, 0, 0, 26); mBtnRow.BackgroundTransparency = 1; mBtnRow.LayoutOrder = 2; mBtnRow.ZIndex = 26
		C.ListLayout(mBtnRow, 4, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

		C.Button(mBtnRow, {
			Size = UDim2.new(0.36, -2, 1, 0), Variant = "success", Text = "♫ Pick Song", TextSize = 9, LayoutOrder = 1, ZIndex = 27,
			OnClick = function()
				if not Backend.HasMusicStudioPass(Z100.MyUid) then
					Z100.UI.ShowToast("🔒 Paid Feature", "Unlock Music Studio Pro in Store.", p.Gold)
					Z100.Router.OpenStore("MusicPass")
					return
				end
				task.spawn(function()
					local tracks = Backend.FetchMyMusicLibrary(true)
					if #tracks == 0 then
						Z100.UI.ShowToast("♫ Library Empty", "Search & save a song in Music Studio first!", p.Info)
						Z100.Router.Navigate("MusicStudio")
						return
					end
					local modal = C.OpenModal({
						Name = "ZaynV100_TrackPicker",
						Title = "♫ Select Song From Library",
						Width = 340,
						FixedHeight = 250,
						AccentColor = Color3.fromRGB(0, 235, 195),
						UseList = false,
					})
					if not modal then return end
					local sc = Instance.new("ScrollingFrame", modal.Body)
					sc.Size = UDim2.new(1, 0, 1, 0); sc.BackgroundTransparency = 1; sc.BorderSizePixel = 0
					sc.ScrollBarThickness = 2; sc.ZIndex = modal.Body.ZIndex + 1
					local sl = C.ListLayout(sc, 5)
					C.AttachAutoCanvas(sc, sl, 8)

					for idx, tr in ipairs(tracks) do
						C.Button(sc, {
							Size = UDim2.new(1, -2, 0, 32), Variant = "secondary",
							Text = "♫ " .. tostring(tr.title):sub(1, 30), TextSize = 9.5,
							LayoutOrder = idx, ZIndex = sc.ZIndex + 1,
							OnClick = function()
								draft.music = {
									videoId = tr.videoId, title = tr.title, artist = tr.artist,
									duration = tr.duration, thumbnail = tr.thumbnail,
									startTime = tr.startTime or 0, clipDuration = 15, volume = tr.volume or 0.7,
								}
								Z100.Stories.SetDraftMusic(draft.music)
								updateMusicLbl()
								syncPreview()
								modal.Close()
							end,
						})
					end
				end)
			end,
		})

		C.Button(mBtnRow, {
			Size = UDim2.new(0.24, -2, 1, 0), Variant = "primary", Text = "🎧 Test", TextSize = 9, LayoutOrder = 2, ZIndex = 27,
			OnClick = function()
				if type(draft.music) == "table" and tostring(draft.music.videoId or "") ~= "" then
					Z100.Music.PlayOnlineTrack(draft.music, "ZaynV100_StoryAudio", function(st, detail)
						if not mLbl or not mLbl.Parent then return end
						if st == "loading" then mLbl.Text = "◐ " .. tostring(detail)
						elseif st == "error" then mLbl.Text = "⚠️ " .. tostring(detail)
						elseif st == "playing" then mLbl.Text = "🔊 Clip: " .. tostring(draft.music.title):sub(1, 20) end
					end)
				else
					Z100.UI.ShowToast("🔇 No Song", "Pick a song first.", p.TextMuted)
				end
			end,
		})

		C.Button(mBtnRow, {
			Size = UDim2.new(0.20, -2, 1, 0), Variant = "secondary", Text = "🔊 Vol", TextSize = 9, LayoutOrder = 3, ZIndex = 27,
			OnClick = function()
				if type(draft.music) ~= "table" then return end
				local vols = { 0.35, 0.7, 1.0 }
				local cur = draft.music.volume or 0.7
				local nextV = vols[1]
				for idx, v in ipairs(vols) do if math.abs(v - cur) < 0.08 then nextV = vols[(idx % #vols) + 1]; break end end
				draft.music.volume = nextV
				updateMusicLbl()
			end,
		})

		C.Button(mBtnRow, {
			Size = UDim2.new(0.18, -2, 1, 0), Variant = "danger", Text = "✕", TextSize = 9.5, LayoutOrder = 4, ZIndex = 27,
			OnClick = function()
				Z100.Music.StopAudio("ZaynV100_StoryAudio")
				draft.music = nil
				Z100.Stories.SetDraftMusic(nil)
				updateMusicLbl()
				syncPreview()
			end,
		})

		-- Custom Cut / Trim Row (Start From Any Line + Max 15 Sec Clip)
		local trimRow = Instance.new("Frame", musicBox)
		trimRow.Size = UDim2.new(1, 0, 0, 28); trimRow.BackgroundTransparency = 1; trimRow.LayoutOrder = 3; trimRow.ZIndex = 26

		C.TextInput(trimRow, {
			Size = UDim2.new(0.49, -2, 1, 0), Height = 28, TextSize = 9.5,
			Placeholder = "Start Sec (e.g. 42)",
			Text = tostring((type(draft.music) == "table" and draft.music.startTime) or 0),
			ZIndex = 27,
			OnChange = function(v)
				if type(draft.music) == "table" then
					draft.music.startTime = math.max(0, math.floor(tonumber(v) or 0))
					updateMusicLbl()
				end
			end,
		})

		local clipWrap = C.TextInput(trimRow, {
			Size = UDim2.new(0.49, -2, 1, 0), Height = 28, TextSize = 9.5,
			Placeholder = "Clip Sec (Max 15)",
			Text = tostring((type(draft.music) == "table" and draft.music.clipDuration) or 15),
			ZIndex = 27,
			OnChange = function(v)
				if type(draft.music) == "table" then
					draft.music.clipDuration = math.clamp(math.floor(tonumber(v) or 15), 3, 15)
					updateMusicLbl()
				end
			end,
		})
		clipWrap.Position = UDim2.new(0.51, 2, 0, 0)

		-- Privacy + Publish
		local privModes = { "Public", "Followers", "Private" }
		local pIdx = 1
		for i, v in ipairs(privModes) do if v == draft.privacy then pIdx = i; break end end

		local privBtn
		privBtn = C.Button(ctrl, {
			Height = 28, Variant = "ghost",
			Text = "🔒 Privacy: " .. draft.privacy .. " (Tap)", TextSize = 9.5, LayoutOrder = 7, ZIndex = 25,
			OnClick = function()
				pIdx = (pIdx % #privModes) + 1
				draft.privacy = privModes[pIdx]
				privBtn.Text = "🔒 Privacy: " .. draft.privacy .. " (Tap)"
			end,
		})

		local pubBusy = false
		local pubBtn
		pubBtn = C.Button(ctrl, {
			Height = 34, Variant = "success",
			Text = "🚀 PUBLISH STORY (24H LIVE)", TextSize = 10.5, LayoutOrder = 8, ZIndex = 25,
			OnClick = function()
				if pubBusy then return end
				pubBusy = true
				pubBtn.Text = "Publishing..."
				Z100.Music.StopAudio("ZaynV100_StoryAudio")
				task.spawn(function()
					local ok, res = Backend.PublishStory(draft)
					pubBusy = false
					if ok then
						Z100.Stories.SetDraftMusic(nil)
						Z100.UI.ShowToast("◎ Story Live!", "Your 24h story is published!", p.Success)
						Z100.Router.Navigate("Stories")
					else
						if pubBtn and pubBtn.Parent then pubBtn.Text = "🚀 PUBLISH STORY (24H LIVE)" end
						Z100.UI.ShowToast("⚠️ Publish Failed", tostring(res), p.Danger)
					end
				end)
			end,
		})
	end

	-- ===================================================================== --
	-- [SECTION C : FULL-SCREEN STORY VIEWER (SYNCED 15S TRIMMED MUSIC)]
	-- ===================================================================== --
	function Z100.Stories.CloseViewer()
		viewerSessionSeq = viewerSessionSeq + 1
		Z100.Music.StopAudio("ZaynV100_StoryAudio")
		if Z100.Stories._progressAnimId then
			Z100.Anim.Unregister(Z100.Stories._progressAnimId)
