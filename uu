	function Z100.Router.GoBack()
		local prev = table.remove(State.ScreenHistory) or "Home"
		Z100.Router.Navigate(prev, nil, true)
	end

	function Z100.Router.RefreshCurrent()
		Z100.Router.Navigate(State.ActiveScreen or "Home", nil, true)
	end

	function Z100.Router.OpenProfile(uid)
		State.ViewingProfileUid = Util.NormalizeUid(uid) or Z100.MyUid
		Z100.Router.Navigate("Profile", State.ViewingProfileUid)
	end

	function Z100.Router.OpenStore(tabId)
		State.StoreTab = tabId or "Decorations"
		Z100.Router.Navigate("Store", State.StoreTab)
	end

	-- ===================================================================== --
	-- [SECTION D : REAL-TIME BACKGROUND SYNC LOOPS (CHAT, DMs & SERVER DJ)]
	-- ===================================================================== --
	local lastBroadcastTs = Util.Now()

	local function syncServerChat()
		local raw = DB.Get(Nodes.ServerChat .. "/" .. State.JobId)
		if type(raw) ~= "table" then return end

		local srvKey = Crypto.ServerSalt .. State.JobId
		local nowTs = Util.Now()
		local newItems = {}

		for msgId, item in pairs(raw) do
			if type(item) == "table" and item.m and item.sign then
				local t = tonumber(item.t) or 0
				if (nowTs - t) > Z100.Config.Limits.ServerChatTTL then
					DB.DeleteAsync(Nodes.ServerChat .. "/" .. State.JobId .. "/" .. tostring(msgId))
				elseif not State.SeenMsgIds[msgId] then
					local dec = Crypto.Decrypt(srvKey, item.m, item.sign)
					if dec then
						State.SeenMsgIds[msgId] = true
						Util.RegisterAccount(item.s, item.s, item.u)
						table.insert(newItems, {
							ID = msgId,
							Sender = tostring(item.s or "User"),
							UserID = tonumber(item.u) or 1,
							Msg = dec,
							Time = t,
							Edited = dec:sub(1, 5) == "[EDT]",
							Reactions = item._rct or {},
						})
					end
				elseif type(item._rct) == "table" then
					Z100.Chat.UpdateBubbleReactions(msgId, item._rct)
				end
			end
		end

		if #newItems > 0 then
			table.sort(newItems, function(a, b) return a.Time < b.Time end)
			for _, msg in ipairs(newItems) do
				table.insert(State.Cache.Server, msg)
				if State.ActiveScreen == "Messages" and State.ChatSubMode == "Server" then
					Z100.Chat.RenderBubble(msg.Sender, msg.UserID, msg.Msg, msg.Time, msg.ID, msg.Edited, msg.Reactions)
				end
			end
		end
	end

	local function syncDMs()
		local raw = DB.Get(Nodes.DMs .. "/" .. Z100.MyNameLower)
		if type(raw) ~= "table" then return end

		local nowTs = Util.Now()
		for partnerLow, conv in pairs(raw) do
			if type(conv) == "table" then
				local dmKey = Crypto.GetDMKey(Z100.MyNameLower, partnerLow)
				State.Cache.DMs[partnerLow] = State.Cache.DMs[partnerLow] or {}
				local newMsgs = {}

				for msgId, item in pairs(conv) do
					if type(item) == "table" and item.m and item.sign then
						local t = tonumber(item.t) or 0
						if (nowTs - t) > Z100.Config.Limits.DMTTL then
							DB.DeleteAsync(Nodes.DMs .. "/" .. Z100.MyNameLower .. "/" .. partnerLow .. "/" .. tostring(msgId))
						elseif not State.SeenMsgIds[msgId] then
							local dec = Crypto.Decrypt(dmKey, item.m, item.sign)
							if dec then
								State.SeenMsgIds[msgId] = true
								Util.RegisterAccount(item.s, item.s, item.u)
								table.insert(newMsgs, {
									ID = msgId,
									Sender = tostring(item.s or partnerLow),
									UserID = tonumber(item.u) or 1,
									Msg = dec,
									Time = t,
									Edited = dec:sub(1, 5) == "[EDT]",
									Reactions = item._rct or {},
								})
							end
						elseif type(item._rct) == "table" then
							Z100.Chat.UpdateBubbleReactions(msgId, item._rct)
						end
					end
				end

				if #newMsgs > 0 then
					table.sort(newMsgs, function(a, b) return a.Time < b.Time end)
					for _, msg in ipairs(newMsgs) do
						table.insert(State.Cache.DMs[partnerLow], msg)
						if State.ActiveScreen == "Messages" and State.ChatSubMode == "DM" and State.ActiveDM == partnerLow then
							Z100.Chat.RenderBubble(msg.Sender, msg.UserID, msg.Msg, msg.Time, msg.ID, msg.Edited, msg.Reactions)
							Z100.Chat.SetLastRead(partnerLow, msg.Time)
						elseif msg.UserID ~= Z100.Player.UserId and State.Prefs.NotifyMessages then
							Z100.UI.ShowToast("✉ @" .. msg.Sender, msg.Msg, Z100.Theme.Get().Accent, msg.UserID, function()
								State.ChatSubMode = "DM"
								State.ActiveDM = partnerLow
								Z100.Router.Navigate("Messages")
							end)
						end
					end
				end
			end
		end
		Z100.UI.UpdateBadges()
	end

	local function syncSystemControls()
		-- 1. Server Chat Lock
		local lk = DB.Get(Nodes.Locks .. "/" .. State.JobId)
		local isLk = (lk == true or lk == "true")
		if isLk ~= State.IsLocked then
			Z100.Chat.SetLockState(isLk)
		end

		-- 2. Global Admin Banner Broadcast
		local bc = DB.Get(Nodes.Broadcasts)
		if type(bc) == "table" and bc.msg and (tonumber(bc.time) or 0) > lastBroadcastTs then
			lastBroadcastTs = tonumber(bc.time)
			Z100.UI.ShowGlobalBanner(bc.msg)
		end

		-- 3. Same-Server Music Broadcast Sync (Sirf Same JobId Server Ke Users Ko Sunai Dega)
		local srvMus = DB.Get(Nodes.ServerMusic .. "/" .. State.JobId)
		if type(srvMus) == "table" and srvMus.id and srvMus.id ~= Music.LastServerBroadcastId then
			Music.LastServerBroadcastId = srvMus.id
			if srvMus.playing == true and State.Prefs.ServerBroadcastListen and not State.Prefs.MuteAllAudio then
				local elapsed = math.max(0, Util.Now() - (tonumber(srvMus.startedAt) or Util.Now()))
				if elapsed < 240 then
					srvMus.startTime = (tonumber(srvMus.startTime) or 0) + elapsed
					Music.PlayOnlineTrack(srvMus, "ZaynV100_MusicAudio")
					Z100.UI.ShowToast("📡 Server DJ • @" .. tostring(srvMus.sender or "User"), tostring(srvMus.title), Z100.Theme.Get().Gold)
				end
			elseif srvMus.playing == false then
				Music.StopAudio("ZaynV100_MusicAudio")
			end
		end
	end

	-- ===================================================================== --
	-- [SECTION E : FINAL BOOT SEQUENCE]
	-- ===================================================================== --
	local envRef = (type(getgenv) == "function" and getgenv()) or _G

	Z100.UI.BuildMasterShell()
	Z100.UI.ApplyDesignTheme()
	Z100.Router.Navigate("Home", nil, true)

	-- Initial Background Hydrate
	task.spawn(function()
		Backend.FetchStoreConfig()
		Backend.FetchEntitlements(Z100.MyUid, true)
		Backend.FetchProfile(Z100.MyUid, true)
		Backend.FetchGraph(Z100.MyUid, true)
		Backend.FetchMyBlocks()
		Backend.FetchMyRequests()
		Backend.FetchMyNotifs(true)
		Backend.HeartbeatPresence()
		Z100.UI.ApplyDesignTheme()
		Z100.UI.UpdateBadges()
	end)

	-- Fast Sync Loop (Server Chat + DMs + Server DJ Broadcast every 2.8s)
	task.spawn(function()
		while not (type(envRef) == "table" and envRef.ZaynV100_Unloading) do
			pcall(syncServerChat)
			pcall(syncDMs)
			pcall(syncSystemControls)
			task.wait(2.8)
		end
	end)

	-- Slow Sync Loop (Presence + Notifications + Follow Requests every 15s)
	task.spawn(function()
		while not (type(envRef) == "table" and envRef.ZaynV100_Unloading) do
			task.wait(15)
			if type(envRef) == "table" and envRef.ZaynV100_Unloading then break end
			pcall(Backend.HeartbeatPresence)
			pcall(Backend.FetchMyRequests)
			pcall(Backend.FetchMyNotifs, false)
			pcall(Z100.UI.UpdateBadges)
		end
	end)

	print("✅ [ZAYN SOCIAL V100] Compact Anti-Lag Edition (400x380) Ready on " .. tostring(Z100.Exec.Name) .. "!")
end
