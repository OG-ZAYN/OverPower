			sTray.BackgroundColor3 = p.Surface; sTray.Visible = false; sTray.ClipsDescendants = true; sTray.ZIndex = 45
			C.Corner(sTray, Z100.Theme.Tokens.Radius.SM); C.Stroke(sTray, p.BorderGlow, 1.2, 0.2)
			chatRefs.StickerTray = sTray

			local sSc = Instance.new("ScrollingFrame", sTray)
