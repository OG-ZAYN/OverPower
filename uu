			repTxt.TextXAlignment = Enum.TextXAlignment.Left; repTxt.RichText = true; repTxt.ClipsDescendants = true; repTxt.ZIndex = 36
			chatRefs.ReplyTxt = repTxt

			local cancelRep = Instance.new("TextButton", repBar)
			cancelRep.Size = UDim2.new(0, 20, 0, 20); cancelRep.Position = UDim2.new(1, -22, 0.5, -10)
			cancelRep.BackgroundColor3 = p.Card; cancelRep.Font = Z100.Theme.Tokens.Fonts.Heading; cancelRep.TextSize = 9
			cancelRep.TextColor3 = p.TextSecondary; cancelRep.Text = "✕"; cancelRep.ZIndex = 36
			C.Corner(cancelRep, Z100.Theme.Tokens.Radius.Pill)
