				task.delay(0.45, function()
					if holding and bubble.Parent then
						holding = false
						Z100.Chat.OpenBubbleMenu(senderName, uidNum, body, msgId, isMe)
					end
				end)
			end
		end)
		bubble.InputEnded:Connect(function() holding = false end)

		Z100.Chat.ScrollToBottom(isMe)
	end

