	function Backend.FetchStoriesFeed()
		local myStories = Backend.FetchUserStories(Z100.MyUid, true)
		local buckets = {}
		local seenUids = { [Z100.MyUid] = true }

		if #myStories > 0 then
			table.insert(buckets, { uid = Z100.MyUid, stories = myStories, ring = Backend.GetStoryRingState(Z100.MyUid) })
		end

		local candidates = {}
		for fUid, val in pairs(State.Following[Z100.MyUid] or {}) do
			if val == true and not seenUids[fUid] then
				seenUids[fUid] = true
				table.insert(candidates, tostring(fUid))
			end
		end
		for _, plr in ipairs(Z100.Services.Players:GetPlayers()) do
			local uStr = tostring(plr.UserId)
			if not seenUids[uStr] and not Backend.IsBlocked(uStr) then
				seenUids[uStr] = true
				table.insert(candidates, uStr)
			end
		end

		for i = 1, math.min(12, #candidates) do
			local uStr = candidates[i]
			local list = Backend.FetchUserStories(uStr, true)
			if #list > 0 then
				table.insert(buckets, { uid = uStr, stories = list, ring = Backend.GetStoryRingState(uStr) })
