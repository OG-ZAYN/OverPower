	function Z100.Crypto.B64Encode(str)
		return (str:gsub(".", function(c)
			local r, b = "", c:byte()
			for idx = 8, 1, -1 do r = r .. (b % 2^idx - b % 2^(idx - 1) > 0 and "1" or "0") end
			return r
		end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(bits)
			if #bits < 6 then return "" end
			local val = 0
			for idx = 1, 6 do val = val + (bits:sub(idx, idx) == "1" and 2^(6 - idx) or 0) end
			return B64:sub(val + 1, val + 1)
		end) .. ({ "", "==", "=" })[#str % 3 + 1]
