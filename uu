		rHold.Name = "ReactContainer"; rHold.AutomaticSize = Enum.AutomaticSize.XY; rHold.BackgroundTransparency = 1
		rHold.LayoutOrder = 4; rHold.ZIndex = bubble.ZIndex + 1
		C.ListLayout(rHold, 4, Enum.FillDirection.Horizontal)
