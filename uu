			if next(Z100._ticks) == nil then return end -- Zero CPU when idle!
			local now = os.clock()
			if now - last < 0.1 then return end -- 10 Hz anti-lag cap
			last = now
			for id, entry in pairs(Z100._ticks) do
				if not entry.obj or not entry.obj.Parent then
					Z100._ticks[id] = nil
				else
					pcall(entry.fn, now)
