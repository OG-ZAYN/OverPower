			cfg.disabledDecorations = type(raw.disabledDecorations) == "table" and raw.disabledDecorations or {}
			cfg.disabledThemes = type(raw.disabledThemes) == "table" and raw.disabledThemes or {}
			cfg.priceOverrides = type(raw.priceOverrides) == "table" and raw.priceOverrides or {}
		end
		return State.StoreConfig
	end

	function Backend.GetBundlePrice() return tonumber(State.StoreConfig.bundlePriceINR) or 300 end
	function Backend.GetMusicPassPrice() return tonumber(State.StoreConfig.musicPassPriceINR) or 1500 end
	function Backend.GetDecorationPrice(id)
		local ov = State.StoreConfig.priceOverrides and State.StoreConfig.priceOverrides[id]
		return tonumber(ov) or tonumber(State.StoreConfig.decorationPriceINR) or 300
	end
	function Backend.GetThemePrice(id)
		local ov = State.StoreConfig.priceOverrides and State.StoreConfig.priceOverrides[id]
		return tonumber(ov) or tonumber(State.StoreConfig.themePriceINR) or 300
	end
	function Backend.IsDecorationEnabled(id)
		return not (State.StoreConfig.disabledDecorations and State.StoreConfig.disabledDecorations[id] == true)
	end
	function Backend.IsThemeEnabled(id)
		return not (State.StoreConfig.disabledThemes and State.StoreConfig.disabledThemes[id] == true)
	end

	local function defaultEntitlements()
		return {
			cosmeticsBundle = false,
			musicStudioPass = false,
			ownedDecorations = {},
			ownedThemes = {},
			ownedBadges = {},
			grantedBy = "",
			grantedAt = 0,
		}
	end

	function Backend.FetchEntitlements(uid, forceRefresh)
		local uStr = Util.NormalizeUid(uid) or Z100.MyUid
		if not forceRefresh and State.Entitlements[uStr] then
			return State.Entitlements[uStr]
		end
		local raw = DB.Get(Nodes.Entitlements .. "/" .. uStr)
		local ent = defaultEntitlements()
		if type(raw) == "table" then
			ent.cosmeticsBundle = raw.cosmeticsBundle == true
			ent.musicStudioPass = raw.musicStudioPass == true
			ent.ownedDecorations = type(raw.ownedDecorations) == "table" and raw.ownedDecorations or {}
			ent.ownedThemes = type(raw.ownedThemes) == "table" and raw.ownedThemes or {}
			ent.ownedBadges = type(raw.ownedBadges) == "table" and raw.ownedBadges or {}
			ent.grantedBy = tostring(raw.grantedBy or "")
			ent.grantedAt = tonumber(raw.grantedAt) or 0
		end
		State.Entitlements[uStr] = ent
		return ent
	end

	function Backend.HasCosmeticsBundle(uid)
		local uStr = Util.NormalizeUid(uid) or Z100.MyUid
		if Util.IsAdmin(uStr) then return true end
		local ent = State.Entitlements[uStr]
		return type(ent) == "table" and ent.cosmeticsBundle == true
	end

	function Backend.HasMusicStudioPass(uid)
		local uStr = Util.NormalizeUid(uid) or Z100.MyUid
		if Util.IsAdmin(uStr) then return true end
		local ent = State.Entitlements[uStr]
		return type(ent) == "table" and ent.musicStudioPass == true
	end

	function Backend.OwnsDecoration(uid, decorId)
		if decorId == "none" or decorId == "" then return true end
		local uStr = Util.NormalizeUid(uid) or Z100.MyUid
		if Util.IsAdmin(uStr) or Backend.HasCosmeticsBundle(uStr) then return true end
		local ent = State.Entitlements[uStr]
		return type(ent) == "table" and type(ent.ownedDecorations) == "table" and ent.ownedDecorations[decorId] == true
	end

	function Backend.OwnsTheme(uid, themeId)
		if themeId == "default_base" or themeId == "" then return true end
		local uStr = Util.NormalizeUid(uid) or Z100.MyUid
		if Util.IsAdmin(uStr) or Backend.HasCosmeticsBundle(uStr) then return true end
		local ent = State.Entitlements[uStr]
		return type(ent) == "table" and type(ent.ownedThemes) == "table" and ent.ownedThemes[themeId] == true
	end

	function Backend.SubmitPurchaseTicket(itemType, itemId, itemName, priceINR, discordUser, note)
		local dUser = tostring(discordUser or ""):gsub("^%s+", ""):gsub("%s+$", ""):sub(1, 48)
		if dUser == "" then return false, "Discord username is required." end

		local tkId = "TK_" .. tostring(Util.Now()) .. "_" .. Util.GenerateKey(5)
		local payload = {
			id = tkId,
			uid = Z100.MyUid,
			username = Z100.MyName,
			itemType = tostring(itemType),
			itemId = tostring(itemId),
			itemName = tostring(itemName):sub(1, 64),
			priceINR = math.max(1, math.floor(tonumber(priceINR) or 300)),
			discordUser = dUser,
			note = tostring(note or ""):sub(1, 120),
			status = "pending_verification",
			createdAt = Util.Now(),
		}
		local ok, err = DB.Put(Nodes.PurchaseTickets .. "/" .. tkId, payload)
		if not ok then return false, err end
		return true, tkId
	end

	function Backend.FetchMyPurchaseTickets()
		local raw = DB.Get(Nodes.PurchaseTickets)
		local out = {}
		if type(raw) == "table" then
			for id, tk in pairs(raw) do
				if type(tk) == "table" and tostring(tk.uid) == Z100.MyUid then
					tk.id = tk.id or id
					table.insert(out, tk)
				end
			end
		end
		table.sort(out, function(a, b) return (tonumber(a.createdAt) or 0) > (tonumber(b.createdAt) or 0) end)
		return out
	end

	-- ===================================================================== --
	-- [SECTION B : PROFILES & IDENTITY]
	-- ===================================================================== --
	local function buildBadgesFor(uStr, ent)
		local badges = {}
		if Util.IsAdmin(uStr) then table.insert(badges, "OWNER") end
		if type(ent) == "table" then
			if ent.cosmeticsBundle then table.insert(badges, "VIP"); table.insert(badges, "ELITE") end
			if ent.musicStudioPass then table.insert(badges, "STUDIO") end
			if type(ent.ownedBadges) == "table" then
				for bKey, v in pairs(ent.ownedBadges) do
					if v == true and not table.find(badges, bKey) then table.insert(badges, bKey) end
				end
			end
		end
		return badges
	end

	function Backend.FetchProfile(uid, forceRefresh)
		local uStr = Util.NormalizeUid(uid) or Z100.MyUid
		if not forceRefresh and State.Profiles[uStr] then
			return State.Profiles[uStr]
		end

		local ent = Backend.FetchEntitlements(uStr, forceRefresh)
		local raw = DB.Get(Nodes.Profiles .. "/" .. uStr)
		local acc = Util.GetAccountByUid(uStr)

		local prof = {
			uid = uStr,
			username = (type(raw) == "table" and raw.username) or acc.Username,
			displayName = (type(raw) == "table" and raw.displayName) or acc.DisplayName,
			customAvatar = (type(raw) == "table" and tostring(raw.customAvatar or "")) or "",
			theme = (type(raw) == "table" and tostring(raw.theme or "default_base")) or "default_base",
			decoration = (type(raw) == "table" and tostring(raw.decoration or "none")) or "none",
			privacy = {
				isPrivate = type(raw) == "table" and type(raw.privacy) == "table" and raw.privacy.isPrivate == true,
				allowFollows = not (type(raw) == "table" and type(raw.privacy) == "table" and raw.privacy.allowFollows == false),
				hideLists = type(raw) == "table" and type(raw.privacy) == "table" and raw.privacy.hideLists == true,
				dmPermission = (type(raw) == "table" and type(raw.privacy) == "table" and raw.privacy.dmPermission) or "Everyone",
				storyPrivacy = (type(raw) == "table" and type(raw.privacy) == "table" and raw.privacy.storyPrivacy) or "Public",
			},
			badges = buildBadgesFor(uStr, ent),
			updatedAt = (type(raw) == "table" and tonumber(raw.updatedAt)) or Util.Now(),
		}

		-- Strict ownership check on display
		if not Backend.OwnsTheme(uStr, prof.theme) then prof.theme = "default_base" end
		if not Backend.OwnsDecoration(uStr, prof.decoration) then prof.decoration = "none" end

		if uStr == Z100.MyUid then
			prof.username = Z100.MyName
			if type(raw) ~= "table" then
				DB.PutAsync(Nodes.Profiles .. "/" .. uStr, prof)
			end
			DB.PutAsync(Nodes.UserIndex .. "/" .. Z100.MyNameLower, {
				uid = uStr,
				username = Z100.MyName,
				displayName = prof.displayName,
				updatedAt = Util.Now(),
			})
		end

		Util.RegisterAccount(prof.username, prof.displayName, tonumber(uStr) or 1)
		State.Profiles[uStr] = prof
		return prof
	end

	function Backend.SaveMyProfile(patch)
		if type(patch) ~= "table" then return false, "Invalid profile data." end
		local cur = Backend.FetchProfile(Z100.MyUid, false)
		Backend.FetchEntitlements(Z100.MyUid, true)

		local nextTheme = patch.theme ~= nil and tostring(patch.theme) or cur.theme
		local nextDecor = patch.decoration ~= nil and tostring(patch.decoration) or cur.decoration

		if not Backend.OwnsTheme(Z100.MyUid, nextTheme) then
			return false, "You do not own this Profile Theme."
		end
		if not Backend.OwnsDecoration(Z100.MyUid, nextDecor) then
			return false, "You do not own this Avatar Decoration."
		end

		local nextDisp = patch.displayName ~= nil and tostring(patch.displayName):gsub("^%s+", ""):gsub("%s+$", ""):sub(1, Z100.Config.Limits.DisplayNameMax) or cur.displayName
		if nextDisp == "" then nextDisp = Z100.Player.DisplayName end

		local payload = {
			uid = Z100.MyUid,
			username = Z100.MyName,
			displayName = nextDisp,
			customAvatar = patch.customAvatar ~= nil and tostring(patch.customAvatar):gsub("^%s+", ""):gsub("%s+$", "") or cur.customAvatar,
			theme = nextTheme,
			decoration = nextDecor,
			privacy = type(patch.privacy) == "table" and patch.privacy or cur.privacy,
			updatedAt = Util.Now(),
		}

		local ok, err = DB.Put(Nodes.Profiles .. "/" .. Z100.MyUid, payload)
		if not ok then return false, err end

		payload.badges = buildBadgesFor(Z100.MyUid, State.Entitlements[Z100.MyUid])
		State.Profiles[Z100.MyUid] = payload
		DB.PutAsync(Nodes.UserIndex .. "/" .. Z100.MyNameLower, {
			uid = Z100.MyUid,
			username = Z100.MyName,
			displayName = payload.displayName,
			updatedAt = Util.Now(),
		})
		return true, "Profile updated!"
	end

	-- ===================================================================== --
	-- [SECTION C : SOCIAL GRAPH (FOLLOWERS, FOLLOWING, REQUESTS & SUGGESTED)]
	-- ===================================================================== --
	function Backend.FetchGraph(uid, forceRefresh)
		local uStr = Util.NormalizeUid(uid) or Z100.MyUid
		if not forceRefresh and State.Followers[uStr] and State.Following[uStr] then
			return State.Followers[uStr], State.Following[uStr]
		end
		local fers = DB.Get(Nodes.Followers .. "/" .. uStr)
		local fing = DB.Get(Nodes.Following .. "/" .. uStr)
		State.Followers[uStr] = type(fers) == "table" and fers or {}
		State.Following[uStr] = type(fing) == "table" and fing or {}
		return State.Followers[uStr], State.Following[uStr]
	end

	function Backend.GetFollowerCount(uid) return Util.CountKeys(State.Followers[Util.NormalizeUid(uid) or Z100.MyUid]) end
	function Backend.GetFollowingCount(uid) return Util.CountKeys(State.Following[Util.NormalizeUid(uid) or Z100.MyUid]) end

	function Backend.IsFollowing(targetUid)
		local tStr = Util.NormalizeUid(targetUid)
		return tStr ~= nil and type(State.Following[Z100.MyUid]) == "table" and State.Following[Z100.MyUid][tStr] == true
	end

	function Backend.IsFollowedBy(targetUid)
		local tStr = Util.NormalizeUid(targetUid)
		return tStr ~= nil and type(State.Followers[Z100.MyUid]) == "table" and State.Followers[Z100.MyUid][tStr] == true
	end

	function Backend.IsMutual(targetUid)
		return Backend.IsFollowing(targetUid) and Backend.IsFollowedBy(targetUid)
	end

	function Backend.HasSentRequestTo(targetUid)
		local tStr = Util.NormalizeUid(targetUid)
		return tStr ~= nil and State.SentRequests[tStr] == true
	end

	function Backend.FollowUser(targetUid)
		local tStr = Util.NormalizeUid(targetUid)
		if not tStr or tStr == Z100.MyUid then return false, "Invalid user." end
		if Backend.IsBlocked(tStr) or Backend.IsBlockedBy(tStr) then return false, "Blocked account." end

		local prof = Backend.FetchProfile(tStr, false)
		if prof and prof.privacy and prof.privacy.allowFollows == false then
			return false, "This user has disabled new followers."
		end

		if prof and prof.privacy and prof.privacy.isPrivate then
			local ok, err = DB.Put(Nodes.FollowRequests .. "/" .. tStr .. "/" .. Z100.MyUid, {
				uid = Z100.MyUid,
				username = Z100.MyName,
				displayName = Z100.Player.DisplayName,
				time = Util.Now(),
			})
			if not ok then return false, err end
			State.SentRequests[tStr] = true
			Backend.SendNotif(tStr, "follow_request", "📩 Follow Request", "@" .. Z100.MyName .. " requested to follow you.")
			return true, "Follow request sent!"
		end

		local ok1, err1 = DB.Put(Nodes.Following .. "/" .. Z100.MyUid .. "/" .. tStr, true)
		if not ok1 then return false, err1 end
		DB.PutAsync(Nodes.Followers .. "/" .. tStr .. "/" .. Z100.MyUid, true)

		State.Following[Z100.MyUid] = State.Following[Z100.MyUid] or {}
		State.Following[Z100.MyUid][tStr] = true
		State.Followers[tStr] = State.Followers[tStr] or {}
		State.Followers[tStr][Z100.MyUid] = true

		Backend.SendNotif(tStr, "follow", "👥 New Follower", "@" .. Z100.MyName .. " started following you.")
		return true, "Now following!"
	end

	function Backend.UnfollowUser(targetUid)
		local tStr = Util.NormalizeUid(targetUid)
		if not tStr then return false, "Invalid user." end
		DB.Delete(Nodes.Following .. "/" .. Z100.MyUid .. "/" .. tStr)
		DB.DeleteAsync(Nodes.Followers .. "/" .. tStr .. "/" .. Z100.MyUid)
		if State.Following[Z100.MyUid] then State.Following[Z100.MyUid][tStr] = nil end
		if State.Followers[tStr] then State.Followers[tStr][Z100.MyUid] = nil end
		return true, "Unfollowed."
	end

	function Backend.RemoveFollower(followerUid)
		local fStr = Util.NormalizeUid(followerUid)
		if not fStr then return false, "Invalid user." end
		DB.Delete(Nodes.Followers .. "/" .. Z100.MyUid .. "/" .. fStr)
		DB.DeleteAsync(Nodes.Following .. "/" .. fStr .. "/" .. Z100.MyUid)
		if State.Followers[Z100.MyUid] then State.Followers[Z100.MyUid][fStr] = nil end
		return true, "Follower removed."
	end

	function Backend.FetchMyRequests()
		local raw = DB.Get(Nodes.FollowRequests .. "/" .. Z100.MyUid)
		State.Requests = type(raw) == "table" and raw or {}
		return State.Requests
	end

	function Backend.AcceptFollowRequest(reqUid)
		local rStr = Util.NormalizeUid(reqUid)
		if not rStr then return false, "Invalid user." end
		DB.Put(Nodes.Followers .. "/" .. Z100.MyUid .. "/" .. rStr, true)
		DB.PutAsync(Nodes.Following .. "/" .. rStr .. "/" .. Z100.MyUid, true)
		DB.DeleteAsync(Nodes.FollowRequests .. "/" .. Z100.MyUid .. "/" .. rStr)
		State.Requests[rStr] = nil
		State.Followers[Z100.MyUid] = State.Followers[Z100.MyUid] or {}
		State.Followers[Z100.MyUid][rStr] = true
		Backend.SendNotif(rStr, "follow_accepted", "✅ Request Accepted", "@" .. Z100.MyName .. " accepted your follow request.")
		return true, "Follow request accepted!"
	end

	function Backend.DeclineFollowRequest(reqUid)
		local rStr = Util.NormalizeUid(reqUid)
		if not rStr then return false, "Invalid user." end
		DB.Delete(Nodes.FollowRequests .. "/" .. Z100.MyUid .. "/" .. rStr)
		State.Requests[rStr] = nil
		return true, "Request declined."
	end

	function Backend.CancelFollowRequest(targetUid)
		local tStr = Util.NormalizeUid(targetUid)
		if not tStr then return false, "Invalid user." end
		DB.Delete(Nodes.FollowRequests .. "/" .. tStr .. "/" .. Z100.MyUid)
		State.SentRequests[tStr] = nil
		return true, "Request cancelled."
	end

	function Backend.FetchSuggestedUsers(limit)
		local out, seen = {}, { [Z100.MyUid] = true }
		local maxN = limit or 6
		for _, plr in ipairs(Players:GetPlayers()) do
			local uStr = tostring(plr.UserId)
			if not seen[uStr] and not Backend.IsBlocked(uStr) then
				seen[uStr] = true
				table.insert(out, { uid = uStr, username = plr.Name, displayName = plr.DisplayName, inServer = true })
				if #out >= maxN then return out end
			end
		end
		return out
	end

