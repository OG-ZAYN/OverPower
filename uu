			local vTray = Instance.new("Frame", root)
			vTray.Size = UDim2.new(1, -16, 0, 150); vTray.Position = UDim2.new(0, 8, 1, -196)
			vTray.BackgroundColor3 = p.Surface; vTray.Visible = false; vTray.ClipsDescendants = true; vTray.ZIndex = 46
			C.Corner(vTray, Z100.Theme.Tokens.Radius.SM); C.Stroke(vTray, p.BorderGlow, 1.2, 0.2)
			chatRefs.VaultTray = vTray

			local vInWrap, vUrlBox = C.TextInput(vTray, { Size = UDim2.new(1, -74, 0, 26), Height = 26, TextSize = 9.5, Placeholder = "Image ID or URL...", ZIndex = 47 })
			vInWrap.Position = UDim2.new(0, 6, 0, 6)

