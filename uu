	local function parseDurationSeconds(raw)
		if type(raw) == "number" then return math.max(0, math.floor(raw)) end
		local s = tostring(raw or "")
		local h, m, sec = s:match("^(%d+):(%d+):(%d+)$")
		if h then return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(sec) end
		local m2, sec2 = s:match("^(%d+):(%d+)$")
		if m2 then return tonumber(m2) * 60 + tonumber(sec2) end
		return math.max(0, math.floor(tonumber(s) or 0))
	end

	local function cleanJsonStr(s)
		return tostring(s or "")
			:gsub("\\u0026", "&")
			:gsub("\\u003c", "<")
			:gsub("\\u003e", ">")
			:gsub('\\"', '"')
			:gsub("\\/", "/")
	end

	-- 1. Live Online YouTube Search (Real Titles, Artist & Exact Duration)
	function Z100.Music.SearchOnline(query)
		local cleanQ = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if cleanQ == "" then
			return false, {}, "Enter a song name or artist to search online."
		end

		if not Util.IsAdmin() and (os.clock() - State.LastMusicSearchClock < Z100.Config.Limits.SearchCooldown) then
			return false, State.MusicSearchResults, "Please wait 2s between searches."
		end
		State.LastMusicSearchClock = os.clock()

		local encodedQ = Util.URLEncode(cleanQ)
		local results, seenIds = {}, {}

		local function addResult(vid, title, artist, dur, thumb, mp3)
			vid = tostring(vid or ""):gsub("[^%w_%-]", "")
			if #vid ~= 11 or seenIds[vid] then return end
			seenIds[vid] = true
			table.insert(results, {
				videoId = vid,
				title = cleanJsonStr(title ~= "" and title or "YouTube Track"):sub(1, 68),
				artist = cleanJsonStr(artist ~= "" and artist or "YouTube"):sub(1, 44),
				duration = parseDurationSeconds(dur or 0),
				thumbnail = (type(thumb) == "string" and thumb ~= "") and thumb or ("https://i.ytimg.com/vi/" .. vid .. "/hqdefault.jpg"),
				mp3Url = tostring(mp3 or ""),
			})
		end

		local ytRes = DB.RawRequest("https://www.youtube.com/results?search_query=" .. encodedQ, "GET", nil, {
			["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
			["Accept-Language"] = "en-US,en;q=0.9",
		}, 14)

		if ytRes.StatusCode == 200 and #ytRes.Body > 1000 then
			local body = ytRes.Body
			local pos = 1
			while #results < Z100.Config.MusicAPI.MaxResults do
				local sIdx, eIdx, vid = body:find('"videoRenderer":%{"videoId":"([%w_%-]+)"', pos)
				if not sIdx then break end
				pos = eIdx + 1
				local chunk = body:sub(eIdx, math.min(#body, eIdx + 2600))
				local title = chunk:match('"title":%{"runs":%[%{"text":"(.-)"%}')
					or chunk:match('"title":%{"simpleText":"(.-)"')
				local artist = chunk:match('"ownerText":%{"runs":%[%{"text":"(.-)"')
					or chunk:match('"longBylineText":%{"runs":%[%{"text":"(.-)"')
					or "YouTube"
				local dur = chunk:match('"lengthText":%{"accessibility":.-"simpleText":"([%d:]+)"')
					or chunk:match('"lengthText":%{"simpleText":"([%d:]+)"')
					or "0:00"
				if title and title ~= "" then
					addResult(vid, title, artist, dur, "https://i.ytimg.com/vi/" .. vid .. "/hqdefault.jpg", "")
				end
			end
		end

		if #results == 0 then
			return false, {}, "No online songs found (YT HTTP " .. tostring(ytRes.StatusCode) .. "). Try another song title."
		end

		State.MusicSearchResults = results
		return true, results, nil
	end

	-- 2. Resolve Direct MP3 Link via RapidAPI
	function Z100.Music.ResolveMP3Link(videoId)
		local vid = tostring(videoId or ""):gsub("[^%w_%-]", "")
		if vid == "" then return false, nil, "Missing YouTube videoId." end

		local apiKey = Z100.Config.MusicAPI.RapidAPIKey
		local ytWatch = Util.URLEncode("https://www.youtube.com/watch?v=" .. vid)

		local endpoints = {
			{ url = "https://" .. Z100.Config.MusicAPI.AltMp3Host .. "/mp3?url=" .. ytWatch, host = Z100.Config.MusicAPI.AltMp3Host },
			{ url = "https://" .. Z100.Config.MusicAPI.AltMp3Host .. "/mp3?id=" .. vid,      host = Z100.Config.MusicAPI.AltMp3Host },
			{ url = "https://" .. Z100.Config.MusicAPI.Mp3Host .. "/dl?id=" .. vid,          host = Z100.Config.MusicAPI.Mp3Host },
		}

		local lastCode = 0
		for _, ep in ipairs(endpoints) do
			local res = DB.RawRequest(ep.url, "GET", nil, {
				["x-rapidapi-key"] = apiKey,
				["x-rapidapi-host"] = ep.host,
			}, 18)
			lastCode = res.StatusCode

			if res.StatusCode == 200 and res.Body ~= "" then
				local ok, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
				if ok and type(d) == "table" then
					local link = tostring(d.link or d.downloadUrl or d.download_url or d.url or "")
					if link:match("^https?://") then
						return true, { link = link, title = tostring(d.title or ""), duration = tonumber(d.duration) or 0 }, nil
					end
				end
			end
		end

		return false, nil, "MP3 stream failed (HTTP " .. tostring(lastCode) .. ")."
	end

	-- 3. Universal Executor MP3 Player (Supports Custom StartTime + ClipDuration)
	function Z100.Music.StopAudio(soundName)
		Z100.Music.PlaySession = Z100.Music.PlaySession + 1
		local targets = soundName and { soundName } or { "ZaynV100_MusicAudio", "ZaynV100_StoryAudio" }
		for _, sName in ipairs(targets) do
			pcall(function()
				local existing = SoundService:FindFirstChild(sName)
				if existing then existing:Stop(); existing:Destroy() end
			end)
		end
		if not soundName or soundName == "ZaynV100_MusicAudio" then
			Z100.Music.ActiveSound = nil
			Z100.Music.ActiveTrack = nil
		end
	end

	function Z100.Music.PlayOnlineTrack(trackObj, soundName, onStateChange)
		local sName = soundName or "ZaynV100_MusicAudio"
		Z100.Music.StopAudio()

		if State.Prefs.MuteAllAudio then
			if type(onStateChange) == "function" then onStateChange("muted", "Audio is muted in Settings.") end
			return
		end
		if type(trackObj) ~= "table" or tostring(trackObj.videoId or "") == "" then
			if type(onStateChange) == "function" then onStateChange("error", "Invalid track.") end
			return
		end

		local mySession = Z100.Music.PlaySession
		if type(onStateChange) == "function" then onStateChange("loading", "Fetching MP3 stream...") end

		task.spawn(function()
			local mp3Link = tostring(trackObj.mp3Url or "")
			if not mp3Link:match("^https?://") then
				local okRes, meta, errRes = Z100.Music.ResolveMP3Link(trackObj.videoId)
				if Z100.Music.PlaySession ~= mySession then return end
				if not okRes or not meta then
					if type(onStateChange) == "function" then onStateChange("error", tostring(errRes or "MP3 unavailable")) end
					return
				end
				mp3Link = meta.link
				trackObj.mp3Url = mp3Link
				if meta.duration and meta.duration > 0 then trackObj.duration = meta.duration end
			end

			if type(onStateChange) == "function" then onStateChange("loading", "Caching MP3...") end
			local okAsset, assetUrl, errAsset = Util.DownloadAudioToAsset(mp3Link, trackObj.videoId)
			if Z100.Music.PlaySession ~= mySession then return end

			if not okAsset then
				local okRes2, meta2 = Z100.Music.ResolveMP3Link(trackObj.videoId)
				if Z100.Music.PlaySession ~= mySession then return end
				if okRes2 and meta2 and meta2.link then
					trackObj.mp3Url = meta2.link
					okAsset, assetUrl, errAsset = Util.DownloadAudioToAsset(meta2.link, trackObj.videoId)
				end
			end

			if Z100.Music.PlaySession ~= mySession then return end
			if not okAsset or not assetUrl then
				if type(onStateChange) == "function" then onStateChange("error", tostring(errAsset or "Audio cache failed")) end
				return
			end

			local snd = Instance.new("Sound")
			snd.Name = sName
			snd.SoundId = assetUrl
			snd.Volume = math.clamp(tonumber(trackObj.volume) or tonumber(State.Prefs.MusicVolume) or 0.7, 0, 1)
			snd.Looped = (sName ~= "ZaynV100_StoryAudio")
			snd.Parent = SoundService

			if sName == "ZaynV100_MusicAudio" then
				Z100.Music.ActiveSound = snd
				Z100.Music.ActiveTrack = trackObj
			end

			local t0 = os.clock()
			while snd and snd.Parent and Z100.Music.PlaySession == mySession and os.clock() - t0 < 4.0 do
				if snd.IsLoaded or snd.TimeLength > 0 then break end
				task.wait(0.1)
			end
			if Z100.Music.PlaySession ~= mySession or not snd or not snd.Parent then return end

			local stPos = math.max(0, tonumber(trackObj.startTime) or 0)
			if snd.TimeLength > 0 and stPos >= snd.TimeLength then stPos = 0 end
			pcall(function()
				snd.TimePosition = stPos
				snd:Play()
			end)

			if type(onStateChange) == "function" then
				onStateChange("playing", snd.TimeLength > 0 and snd.TimeLength or (tonumber(trackObj.duration) or 0))
			end
		end)
	end

	-- 4. Same-Server Music Broadcast (Sirf Same JobId Server Ke Users Ko Sunai Dega)
	function Z100.Music.BroadcastToServer(trackObj, startTime, volume)
		if type(trackObj) ~= "table" or tostring(trackObj.videoId or "") == "" then
			return false, "Play or select a song first."
		end
		local bId = "SB_" .. tostring(Util.Now()) .. "_" .. tostring(math.random(100, 999))
		Z100.Music.LastServerBroadcastId = bId
		local payload = {
			id = bId,
			playing = true,
			videoId = tostring(trackObj.videoId),
			title = tostring(trackObj.title or "Server Song"):sub(1, 68),
			artist = tostring(trackObj.artist or "YouTube"):sub(1, 44),
			duration = tonumber(trackObj.duration) or 0,
			thumbnail = tostring(trackObj.thumbnail or ""),
			startTime = math.max(0, tonumber(startTime) or 0),
			volume = math.clamp(tonumber(volume) or 0.7, 0, 1),
			sender = Z100.MyName,
			senderUid = Z100.MyUid,
			startedAt = Util.Now(),
		}
		DB.PutAsync(Nodes.ServerMusic .. "/" .. State.JobId, payload)
		return true, payload
	end

	function Z100.Music.StopServerBroadcast()
		local bId = "STOP_" .. tostring(Util.Now())
		Z100.Music.LastServerBroadcastId = bId
		DB.PutAsync(Nodes.ServerMusic .. "/" .. State.JobId, {
			id = bId,
			playing = false,
			sender = Z100.MyName,
			startedAt = Util.Now(),
		})
	end

	-- 5. Cloud My Music Library
	function Backend.FetchMyMusicLibrary(forceRefresh)
		if not forceRefresh and #State.MusicLibrary > 0 then return State.MusicLibrary end
		local raw = DB.Get(Nodes.MusicLib .. "/" .. Z100.MyUid)
		local out = {}
		if type(raw) == "table" then
			for id, tr in pairs(raw) do
				if type(tr) == "table" and tr.videoId then
					tr.id = tr.id or id
					table.insert(out, tr)
				end
			end
		end
		table.sort(out, function(a, b) return (tonumber(a.savedAt) or 0) > (tonumber(b.savedAt) or 0) end)
		State.MusicLibrary = out
		return out
	end

	function Backend.SaveTrackToLibrary(trackObj, startTime, volume)
		if type(trackObj) ~= "table" or tostring(trackObj.videoId or "") == "" then
			return false, "Invalid track."
		end
		local tId = "TR_" .. tostring(trackObj.videoId)
		local payload = {
			id = tId,
			videoId = tostring(trackObj.videoId),
			title = tostring(trackObj.title or "Track"):sub(1, 68),
			artist = tostring(trackObj.artist or "YouTube"):sub(1, 44),
			duration = tonumber(trackObj.duration) or 0,
			thumbnail = tostring(trackObj.thumbnail or ""),
			startTime = math.max(0, math.floor(tonumber(startTime) or 0)),
			clipDuration = Z100.Config.Limits.StoryMaxClipSec,
			volume = math.clamp(tonumber(volume) or 0.7, 0, 1),
			savedAt = Util.Now(),
		}
		local ok, err = DB.Put(Nodes.MusicLib .. "/" .. Z100.MyUid .. "/" .. tId, payload)
		if not ok then return false, err end
		return true, payload
	end

	function Backend.RemoveTrackFromLibrary(trackId)
		if not trackId then return false end
		return DB.Delete(Nodes.MusicLib .. "/" .. Z100.MyUid .. "/" .. tostring(trackId))
	end
end
