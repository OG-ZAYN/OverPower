		headLbl.TextColor3 = isSystem and p.Gold or (isMe and Color3.fromRGB(235, 224, 255) or p.Accent)
		headLbl.RichText = true
		headLbl.LayoutOrder = 1
		headLbl.ZIndex = bubble.ZIndex + 1
		headLbl.Text = string.format("%s  <font color='#%s' size='9'>%s</font>",
			Util.EscapeRichText(isSystem and "ZAYN SYSTEM" or acc.DisplayName),
			isMe and "D0C4EE" or p.TextMuted:ToHex(),
			Util.TimeAgo(ts))

		if rplUser then
			local rAcc = Util.GetAccount(rplUser)
			local rBox = Instance.new("Frame", bubble)
			rBox.AutomaticSize = Enum.AutomaticSize.XY; rBox.BackgroundColor3 = p.BgRoot; rBox.BackgroundTransparency = 0.45
			rBox.LayoutOrder = 2; rBox.ZIndex = bubble.ZIndex + 1
			C.Corner(rBox, Z100.Theme.Tokens.Radius.XS); C.Padding(rBox, 2, 6, 2, 6)
