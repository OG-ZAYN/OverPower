	function Z100.Crypto.B64Decode(str)
		local clean = tostring(str or ""):gsub("[^" .. B64 .. "=]", "")
		return clean:gsub(".", function(c)
			if c == "=" then return "" end
			local r, f = "", (B64:find(c) - 1)
			for idx = 6, 1, -1 do r = r .. (f % 2^idx - f % 2^(idx - 1) > 0 and "1" or "0") end
			return r
		end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(bits)
			if #bits ~= 8 then return "" end
			local val = 0
			for idx = 1, 8 do val = val + (bits:sub(idx, idx) == "1" and 2^(8 - idx) or 0) end
			return string.char(val)
		end)
