function ZS.Backend.SaveTrackToMyMusic(rawAssetId, customTitle, customArtist, startTime, volume)
    ZS.Backend.FetchEntitlements(ZS.MyUid, true)
    if not ZS.Backend.HasMusicStudioPass(ZS.MyUid) then
        return false, "Music Studio is a PAID feature (₹" .. tostring(ZS.Backend.GetMusicPassPrice()) .. "). Unlock it in the Paid Store."
    end

    local valid, meta, errMsg = ZS.Backend.ValidateRobloxAudioAsset(rawAssetId)
    if not valid then return false, errMsg end

    local tId = "TRK_" .. tostring(ZS.Util.Now()) .. "_" .. tostring(math.random(100, 999))
    local record = {
        id = tId,
        assetId = meta.assetId,
        title = (customTitle and customTitle ~= "") and tostring(customTitle):sub(1, 60) or meta.title,
        artist = (customArtist and customArtist ~= "") and tostring(customArtist):sub(1, 40) or meta.artist,
        duration = tonumber(meta.duration) or 0,
        startTime = math.max(0, tonumber(startTime) or 0),
        volume = math.clamp(tonumber(volume) or 0.65, 0, 1),
        savedAt = ZS.Util.Now()
    }

    local ok, dbErr = ZS.DB.Put(ZS.Nodes.MusicLib .. "/" .. ZS.MyUid .. "/" .. tId, record)
    if not ok then return false, dbErr end

    table.insert(ZS.State.MusicTracks, 1, record)
    return true, record
end

function ZS.Backend.RemoveTrackFromMyMusic(trackId)
    if not trackId then return false, "Invalid track" end
    local ok, errMsg = ZS.DB.Delete(ZS.Nodes.MusicLib .. "/" .. ZS.MyUid .. "/" .. tostring(trackId))
    if ok then
        for idx, tr in ipairs(ZS.State.MusicTracks) do
            if tr.id == trackId then table.remove(ZS.State.MusicTracks, idx); break end
        end
    end
    return ok, ok and "Track removed." or errMsg
end

