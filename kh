function ZS.UI.ApplyChatTheme()
    local theme = ZS.Catalog.GetChatTheme()
    local tw = TweenInfo.new(0.28, Enum.EasingStyle.Sine)
    if ZS.UI.MainBg then TweenService:Create(ZS.UI.MainBg, tw, { BackgroundColor3 = theme.MainBg, BackgroundTransparency = theme.BgTrans }):Play() end
    if ZS.UI.MainStroke then TweenService:Create(ZS.UI.MainStroke, tw, { Color = theme.StrokeColor }):Play() end
    if ZS.UI.HeaderBg then TweenService:Create(ZS.UI.HeaderBg, tw, { BackgroundColor3 = theme.HeaderBg, BackgroundTransparency = theme.HeadTrans }):Play() end
    if ZS.UI.NavBar then TweenService:Create(ZS.UI.NavBar, tw, { BackgroundColor3 = theme.HeaderBg }):Play() end
    if ZS.UI.InputWrapper then TweenService:Create(ZS.UI.InputWrapper, tw, { BackgroundColor3 = theme.InputBg }):Play() end
    if ZS.UI.TextBox then ZS.UI.TextBox.TextColor3 = theme.TextColor; ZS.UI.TextBox.PlaceholderColor3 = theme.SubText end
    if ZS.UI.SendBtn then ZS.UI.SendBtn.BackgroundColor3 = theme.Accent; ZS.UI.SendBtn.TextColor3 = theme.SendText end
    ZS.UI.UpdateNavActiveState(ZS.State.Mode)
end

