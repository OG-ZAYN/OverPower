function ZS.Backend.HeartbeatPresence()
    local ts = ZS.Util.Now()
    ZS.State.Presence[ZS.MyUid] = { online = true, lastSeen = ts, jobId = ZS.State.JobId }
    ZS.DB.PutAsync(ZS.Nodes.Presence .. "/" .. ZS.MyUid, {
        online = true,
        lastSeen = ts,
        username = ZS.MyName,
        jobId = ZS.State.JobId
    })
end

function ZS.Backend.FetchPresence(uid)
    local uidStr = ZS.Util.NormalizeUid(uid)
    if not uidStr then return false, 0 end
    if ZS.Services.Players:GetPlayerByUserId(tonumber(uidStr)) then
        ZS.State.Presence[uidStr] = { online = true, lastSeen = ZS.Util.Now() }
        return true, ZS.Util.Now()
    end
    local raw = ZS.DB.Get(ZS.Nodes.Presence .. "/" .. uidStr)
    if type(raw) == "table" then
        local ls = tonumber(raw.lastSeen) or 0
        local on = (raw.online == true) and ((ZS.Util.Now() - ls) <= 75)
        ZS.State.Presence[uidStr] = { online = on, lastSeen = ls }
        return on, ls
    end
    ZS.State.Presence[uidStr] = { online = false, lastSeen = 0 }
    return false, 0
end

function ZS.Backend.IsOnlineCached(uid)
    local uidStr = ZS.Util.NormalizeUid(uid)
    if not uidStr then return false end
    if ZS.Services.Players:GetPlayerByUserId(tonumber(uidStr)) then return true end
    local p = ZS.State.Presence[uidStr]
    return p ~= nil and p.online == true and (ZS.Util.Now() - (p.lastSeen or 0)) <= 75
end

function ZS.Backend.PushNotif(targetUid, nType, title, msg, fromUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    if not tUid then return end
    local ts = ZS.Util.Now()
    local nId = "N_" .. tostring(ts) .. "_" .. tostring(math.random(1000, 9999))
    ZS.DB.PutAsync(ZS.Nodes.Notifs .. "/" .. tUid .. "/" .. nId, {
        id = nId,
        type = tostring(nType or "social"),
        title = tostring(title or "Notification"):sub(1, 80),
        message = tostring(msg or ""):sub(1, 180),
        fromUid = ZS.Util.NormalizeUid(fromUid) or ZS.MyUid,
        read = false,
        timestamp = ts
    })
end

function ZS.Backend.FetchMyNotifs(silentInitial)
    local raw = ZS.DB.Get(ZS.Nodes.Notifs .. "/" .. ZS.MyUid)
    if type(raw) ~= "table" then return ZS.State.Notifs end

    local list, unread = {}, 0
    for nId, item in pairs(raw) do
        if type(item) == "table" and item.title then
            item.id = item.id or nId
            table.insert(list, item)
            if item.read ~= true then unread = unread + 1 end
            if not ZS.State.SeenNotifIds[item.id] then
                ZS.State.SeenNotifIds[item.id] = true
                if not silentInitial and item.read ~= true and ZS.UI.ShowToast then
                    ZS.UI.ShowToast(item.title, item.message, Color3.fromRGB(165, 75, 255), item.fromUid)
                end
            end
        end
    end

    table.sort(list, function(a, b) return (tonumber(a.timestamp) or 0) > (tonumber(b.timestamp) or 0) end)
    while #list > 45 do
        local old = table.remove(list)
        if old and old.id then
            ZS.DB.DeleteAsync(ZS.Nodes.Notifs .. "/" .. ZS.MyUid .. "/" .. old.id)
        end
    end

    ZS.State.Notifs = list
    ZS.State.UnreadNotifs = unread
    if ZS.UI.UpdateNotifBadge then ZS.UI.UpdateNotifBadge() end
    return list
end

function ZS.Backend.MarkAllNotifsRead()
    for _, item in ipairs(ZS.State.Notifs) do
        if item.read ~= true then
            item.read = true
            if item.id then
                ZS.DB.PutAsync(ZS.Nodes.Notifs .. "/" .. ZS.MyUid .. "/" .. item.id .. "/read", true)
            end
        end
    end
    ZS.State.UnreadNotifs = 0
    if ZS.UI.UpdateNotifBadge then ZS.UI.UpdateNotifBadge() end
end

function ZS.Backend.FetchMyBlocks()
    local raw = ZS.DB.Get(ZS.Nodes.Blocks .. "/" .. ZS.MyUid)
    ZS.State.Blocks = type(raw) == "table" and raw or {}
    return ZS.State.Blocks
end

function ZS.Backend.IsBlocked(targetUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    return tUid ~= nil and ZS.State.Blocks[tUid] == true
end

function ZS.Backend.IsBlockedBy(targetUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    if not tUid then return false end
    if ZS.State.BlockedBy[tUid] ~= nil then return ZS.State.BlockedBy[tUid] == true end
    local res = ZS.DB.Get(ZS.Nodes.Blocks .. "/" .. tUid .. "/" .. ZS.MyUid)
    local blocked = (res == true or res == "true")
    ZS.State.BlockedBy[tUid] = blocked
    return blocked
end

function ZS.Backend.BlockUser(targetUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    if not tUid or tUid == ZS.MyUid then return false, "Cannot block yourself" end
    local ok, errMsg = ZS.DB.Put(ZS.Nodes.Blocks .. "/" .. ZS.MyUid .. "/" .. tUid, true)
    if not ok then return false, errMsg end
    ZS.State.Blocks[tUid] = true

    -- Clean up all follow relationships & requests bidirectionally
    ZS.DB.DeleteAsync(ZS.Nodes.Following .. "/" .. ZS.MyUid .. "/" .. tUid)
    ZS.DB.DeleteAsync(ZS.Nodes.Followers .. "/" .. tUid .. "/" .. ZS.MyUid)
    ZS.DB.DeleteAsync(ZS.Nodes.Following .. "/" .. tUid .. "/" .. ZS.MyUid)
    ZS.DB.DeleteAsync(ZS.Nodes.Followers .. "/" .. ZS.MyUid .. "/" .. tUid)
    ZS.DB.DeleteAsync(ZS.Nodes.FollowRequests .. "/" .. ZS.MyUid .. "/" .. tUid)
    ZS.DB.DeleteAsync(ZS.Nodes.FollowRequests .. "/" .. tUid .. "/" .. ZS.MyUid)

    if ZS.State.Following[ZS.MyUid] then ZS.State.Following[ZS.MyUid][tUid] = nil end
    if ZS.State.Followers[tUid] then ZS.State.Followers[tUid][ZS.MyUid] = nil end
    if ZS.State.Followers[ZS.MyUid] then ZS.State.Followers[ZS.MyUid][tUid] = nil end
    if ZS.State.Following[tUid] then ZS.State.Following[tUid][ZS.MyUid] = nil end
    ZS.State.Requests[tUid] = nil
    ZS.State.SentRequests[tUid] = nil

    return true, "User blocked."
end

function ZS.Backend.UnblockUser(targetUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    if not tUid then return false, "Invalid user" end
    ZS.State.Blocks[tUid] = nil
    local ok, errMsg = ZS.DB.Delete(ZS.Nodes.Blocks .. "/" .. ZS.MyUid .. "/" .. tUid)
    return ok, ok and "User unblocked." or errMsg
end

function ZS.Backend.FetchGraph(uid, forceRefresh)
    local uidStr = ZS.Util.NormalizeUid(uid)
    if not uidStr then return {}, {} end
    if forceRefresh or not ZS.State.Followers[uidStr] then
        local f = ZS.DB.Get(ZS.Nodes.Followers .. "/" .. uidStr)
        ZS.State.Followers[uidStr] = type(f) == "table" and f or {}
    end
    if forceRefresh or not ZS.State.Following[uidStr] then
        local g = ZS.DB.Get(ZS.Nodes.Following .. "/" .. uidStr)
        ZS.State.Following[uidStr] = type(g) == "table" and g or {}
    end
    return ZS.State.Followers[uidStr], ZS.State.Following[uidStr]
end

function ZS.Backend.FetchMyRequests()
    local raw = ZS.DB.Get(ZS.Nodes.FollowRequests .. "/" .. ZS.MyUid)
    ZS.State.Requests = type(raw) == "table" and raw or {}
    return ZS.State.Requests
end

function ZS.Backend.GetFollowerCount(uid)
    local uidStr = ZS.Util.NormalizeUid(uid)
    return uidStr and ZS.Util.CountKeys(ZS.State.Followers[uidStr]) or 0
end

function ZS.Backend.GetFollowingCount(uid)
    local uidStr = ZS.Util.NormalizeUid(uid)
    return uidStr and ZS.Util.CountKeys(ZS.State.Following[uidStr]) or 0
end

function ZS.Backend.IsFollowing(targetUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    local myF = ZS.State.Following[ZS.MyUid]
    return tUid ~= nil and type(myF) == "table" and myF[tUid] ~= nil and myF[tUid] ~= false
end

function ZS.Backend.IsFollowedBy(targetUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    local myF = ZS.State.Followers[ZS.MyUid]
    return tUid ~= nil and type(myF) == "table" and myF[tUid] ~= nil and myF[tUid] ~= false
end

function ZS.Backend.IsMutual(targetUid)
    return ZS.Backend.IsFollowing(targetUid) and ZS.Backend.IsFollowedBy(targetUid)
end

function ZS.Backend.HasSentRequestTo(targetUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    if not tUid then return false end
    if ZS.State.SentRequests[tUid] then return true end
    local raw = ZS.DB.Get(ZS.Nodes.FollowRequests .. "/" .. tUid .. "/" .. ZS.MyUid)
    if type(raw) == "table" then
        ZS.State.SentRequests[tUid] = true
        return true
    end
    return false
end

function ZS.Backend.FollowUser(targetUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    if not tUid then return false, "Invalid user ID" end
    if tUid == ZS.MyUid then return false, "You cannot follow yourself" end
    if ZS.Backend.IsBlocked(tUid) then return false, "Unblock this user before following" end
    if ZS.Backend.IsBlockedBy(tUid) then return false, "Cannot follow this user" end
    if ZS.Backend.IsFollowing(tUid) then return false, "Already following" end

    local tProf = ZS.Backend.FetchProfile(tUid, true)
    if tProf and tProf.privacy and tProf.privacy.allowFollows == false then
        return false, "This user disabled new followers"
    end

    local ts = ZS.Util.Now()
    if tProf and tProf.privacy and tProf.privacy.isPrivate == true then
        if ZS.Backend.HasSentRequestTo(tUid) then return false, "Follow request already pending" end
        local ok, errMsg = ZS.DB.Put(ZS.Nodes.FollowRequests .. "/" .. tUid .. "/" .. ZS.MyUid, {
            uid = ZS.MyUid,
            username = ZS.MyName,
            displayName = (ZS.State.Profiles[ZS.MyUid] and ZS.State.Profiles[ZS.MyUid].displayName) or ZS.Player.DisplayName,
            time = ts
        })
        if not ok then return false, errMsg end
        ZS.State.SentRequests[tUid] = true
        ZS.Backend.PushNotif(tUid, "follow_request", "📩 Follow Request", ZS.Player.DisplayName .. " (@" .. ZS.MyName .. ") requested to follow you.", ZS.MyUid)
        return true, "Follow request sent!"
    end

    local ok1, err1 = ZS.DB.Put(ZS.Nodes.Following .. "/" .. ZS.MyUid .. "/" .. tUid, ts)
    if not ok1 then return false, err1 end
    local ok2, err2 = ZS.DB.Put(ZS.Nodes.Followers .. "/" .. tUid .. "/" .. ZS.MyUid, ts)
    if not ok2 then return false, err2 end

    ZS.State.Following[ZS.MyUid] = ZS.State.Following[ZS.MyUid] or {}
    ZS.State.Following[ZS.MyUid][tUid] = ts
    ZS.State.Followers[tUid] = ZS.State.Followers[tUid] or {}
    ZS.State.Followers[tUid][ZS.MyUid] = ts

    ZS.Backend.PushNotif(tUid, "follow", "👤 New Follower", ZS.Player.DisplayName .. " (@" .. ZS.MyName .. ") followed you!", ZS.MyUid)
    return true, "Following!"
end

function ZS.Backend.UnfollowUser(targetUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    if not tUid then return false, "Invalid user" end
    ZS.DB.Delete(ZS.Nodes.Following .. "/" .. ZS.MyUid .. "/" .. tUid)
    ZS.DB.Delete(ZS.Nodes.Followers .. "/" .. tUid .. "/" .. ZS.MyUid)
    if ZS.State.Following[ZS.MyUid] then ZS.State.Following[ZS.MyUid][tUid] = nil end
    if ZS.State.Followers[tUid] then ZS.State.Followers[tUid][ZS.MyUid] = nil end
    return true, "Unfollowed"
end

function ZS.Backend.CancelFollowRequest(targetUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    if not tUid then return false, "Invalid user" end
    ZS.DB.Delete(ZS.Nodes.FollowRequests .. "/" .. tUid .. "/" .. ZS.MyUid)
    ZS.State.SentRequests[tUid] = nil
    return true, "Request cancelled"
end

function ZS.Backend.AcceptFollowRequest(requesterUid)
    local rUid = ZS.Util.NormalizeUid(requesterUid)
    if not rUid or rUid == ZS.MyUid then return false, "Invalid requester" end
    local ts = ZS.Util.Now()
    ZS.DB.Delete(ZS.Nodes.FollowRequests .. "/" .. ZS.MyUid .. "/" .. rUid)
    ZS.DB.Put(ZS.Nodes.Followers .. "/" .. ZS.MyUid .. "/" .. rUid, ts)
    ZS.DB.Put(ZS.Nodes.Following .. "/" .. rUid .. "/" .. ZS.MyUid, ts)
    ZS.State.Requests[rUid] = nil
    ZS.State.Followers[ZS.MyUid] = ZS.State.Followers[ZS.MyUid] or {}
    ZS.State.Followers[ZS.MyUid][rUid] = ts
    ZS.State.Following[rUid] = ZS.State.Following[rUid] or {}
    ZS.State.Following[rUid][ZS.MyUid] = ts
    ZS.Backend.PushNotif(rUid, "request_accepted", "✅ Request Accepted", ZS.Player.DisplayName .. " accepted your follow request!", ZS.MyUid)
    return true, "Request accepted"
end

function ZS.Backend.DeclineFollowRequest(requesterUid)
    local rUid = ZS.Util.NormalizeUid(requesterUid)
    if not rUid then return false, "Invalid requester" end
    ZS.DB.Delete(ZS.Nodes.FollowRequests .. "/" .. ZS.MyUid .. "/" .. rUid)
    ZS.State.Requests[rUid] = nil
    return true, "Request declined"
end

function ZS.Backend.RemoveFollower(followerUid)
    local fUid = ZS.Util.NormalizeUid(followerUid)
    if not fUid then return false, "Invalid user" end
    ZS.DB.Delete(ZS.Nodes.Followers .. "/" .. ZS.MyUid .. "/" .. fUid)
    ZS.DB.Delete(ZS.Nodes.Following .. "/" .. fUid .. "/" .. ZS.MyUid)
    if ZS.State.Followers[ZS.MyUid] then ZS.State.Followers[ZS.MyUid][fUid] = nil end
    if ZS.State.Following[fUid] then ZS.State.Following[fUid][ZS.MyUid] = nil end
    return true, "Follower removed"
end

function ZS.Backend.CanMessageUser(targetUid)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    if not tUid or tUid == ZS.MyUid then return false, "Cannot message yourself" end
    if ZS.Backend.IsBlocked(tUid) then return false, "You blocked this user" end
    if ZS.Backend.IsBlockedBy(tUid) then return false, "You cannot message this user" end
    local prof = ZS.Backend.FetchProfile(tUid, false)
    local perm = (prof and prof.privacy and prof.privacy.dmPermission) or "Everyone"
    if perm == "None" then return false, "This user disabled DMs"
    elseif perm == "Followers" and not ZS.Backend.IsFollowing(tUid) then return false, "Only followers can DM this user"
    elseif perm == "Mutuals" and not ZS.Backend.IsMutual(tUid) then return false, "Only mutual followers can DM this user" end
    return true, "Allowed"
end

function ZS.Backend.ReportUser(targetUid, reason)
    local tUid = ZS.Util.NormalizeUid(targetUid)
    if not tUid or tUid == ZS.MyUid then return false, "Invalid target" end
    local clean = tostring(reason or "Inappropriate behavior"):gsub("^%s+", ""):gsub("%s+$", ""):sub(1, 200)
    if clean == "" then clean = "Inappropriate behavior" end
    local repId = "REP_" .. tostring(ZS.Util.Now()) .. "_" .. tostring(math.random(1000, 9999))
    return ZS.DB.Put(ZS.Nodes.Reports .. "/" .. repId, {
        id = repId,
        reporterUid = ZS.MyUid,
        reporterName = ZS.MyName,
        targetUid = tUid,
        reason = clean,
        timestamp = ZS.Util.Now()
    })
end

