function ZS.Backend.CanViewStory(story)
    if type(story) ~= "table" or not story.ownerUid then return false end
    local ownerUid = tostring(story.ownerUid)
    if ownerUid == ZS.MyUid or ZS.Util.IsAdmin() then return true end
    if ZS.Backend.IsBlocked(ownerUid) or ZS.Backend.IsBlockedBy(ownerUid) then return false end
    local priv = tostring(story.privacy or "Public")
    if priv == "Private" then return false end
    if priv == "Followers" then return ZS.Backend.IsFollowing(ownerUid) end
    return true
end

function ZS.Backend.FetchUserStories(uid, forceRefresh)
    local uidStr = ZS.Util.NormalizeUid(uid)
    if not uidStr then return {} end

    if not forceRefresh and ZS.State.StoriesByUid[uidStr] then
        local cached, nowTs = {}, ZS.Util.Now()
        for _, st in ipairs(ZS.State.StoriesByUid[uidStr]) do
            if (tonumber(st.expiresAt) or 0) > nowTs and ZS.Backend.CanViewStory(st) then
                table.insert(cached, st)
            end
        end
        return cached
    end

    local raw = ZS.DB.Get(ZS.Nodes.Stories .. "/" .. uidStr)
    local active, nowTs = {}, ZS.Util.Now()
    if type(raw) == "table" then
        for sId, st in pairs(raw) do
            if type(st) == "table" and st.imageRef then
                st.id = st.id or sId
                st.ownerUid = tostring(st.ownerUid or uidStr)
                local exp = tonumber(st.expiresAt) or ((tonumber(st.createdAt) or 0) + ZS.Config.StoryTTL)
                if exp <= nowTs then
                    -- Auto-cleanup expired 24h stories
                    ZS.DB.DeleteAsync(ZS.Nodes.Stories .. "/" .. uidStr .. "/" .. st.id)
                    ZS.DB.DeleteAsync(ZS.Nodes.StoryViews .. "/" .. st.id)
                elseif ZS.Backend.CanViewStory(st) then
                    table.insert(active, st)
                end
            end
        end
    end

    table.sort(active, function(a, b) return (tonumber(a.createdAt) or 0) < (tonumber(b.createdAt) or 0) end)
    ZS.State.StoriesByUid[uidStr] = active
    return active
end

function ZS.Backend.GetStoryRingState(uid)
    local uidStr = ZS.Util.NormalizeUid(uid)
    if not uidStr then return "none" end
    local stories = ZS.State.StoriesByUid[uidStr]
    if type(stories) ~= "table" or #stories == 0 then return "none" end
    local nowTs, hasActive, hasUnseen = ZS.Util.Now(), false, false
    for _, st in ipairs(stories) do
        if (tonumber(st.expiresAt) or 0) > nowTs and ZS.Backend.CanViewStory(st) then
            hasActive = true
            if not ZS.State.SeenStoryIds[st.id] then
                hasUnseen = true
            end
        end
    end
    if not hasActive then return "none" end
    return hasUnseen and "unseen" or "seen"
end

function ZS.Backend.PublishStory(draft)
    local img = tostring(draft.imageRef or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if img == "" then
        return false, "Please add a Roblox Image Asset ID or compatible image URL first."
    end
    if not (img:match("^%d+$") or img:match("^rbxassetid://%d+$") or img:match("^rbxthumb://") or img:match("^https?://")) then
        return false, "Unsupported photo format. Use Roblox Asset ID or direct image link."
    end

    local ts = ZS.Util.Now()
    local sId = "ST_" .. ZS.MyUid .. "_" .. tostring(ts) .. "_" .. tostring(math.random(100, 999))
    local priv = tostring(draft.privacy or "Public")
    if priv ~= "Public" and priv ~= "Followers" and priv ~= "Private" then priv = "Public" end

    local musicData = nil
    if type(draft.music) == "table" and tostring(draft.music.assetId or "") ~= "" then
        if not ZS.Backend.HasMusicStudioPass(ZS.MyUid) then
            return false, "Story Music requires the ₹" .. tostring(ZS.Backend.GetMusicPassPrice()) .. " Music Studio Pass."
        end
        musicData = {
            assetId = tostring(draft.music.assetId),
            title = tostring(draft.music.title or "Track"):sub(1, 60),
            artist = tostring(draft.music.artist or "Roblox Audio"):sub(1, 40),
            startTime = math.max(0, tonumber(draft.music.startTime) or 0),
            volume = math.clamp(tonumber(draft.music.volume) or 0.6, 0, 1)
        }
    end

    local storyObj = {
        id = sId,
        ownerUid = ZS.MyUid,
        ownerName = ZS.MyName,
        ownerDisplay = (ZS.State.Profiles[ZS.MyUid] and ZS.State.Profiles[ZS.MyUid].displayName) or ZS.Player.DisplayName,
        imageRef = img:sub(1, 240),
        caption = tostring(draft.caption or ""):gsub("[\r\n]+", " "):sub(1, 160),
        overlayText = tostring(draft.overlayText or ""):gsub("[\r\n]+", " "):sub(1, 80),
        sticker = tostring(draft.sticker or ""):sub(1, 24),
        bgHex = tostring(draft.bgHex or "obsidian"),
        music = musicData,
        privacy = priv,
        createdAt = ts,
        expiresAt = ts + ZS.Config.StoryTTL,
        reactions = {}
    }

    local ok, errMsg = ZS.DB.Put(ZS.Nodes.Stories .. "/" .. ZS.MyUid .. "/" .. sId, storyObj)
    if not ok then return false, errMsg end

    ZS.State.StoriesByUid[ZS.MyUid] = ZS.State.StoriesByUid[ZS.MyUid] or {}
    table.insert(ZS.State.StoriesByUid[ZS.MyUid], storyObj)
    return true, storyObj
end

