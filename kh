function ZS.Backend.AdminVerifyTicket(ticketObj, approveBool)
    if not ZS.Util.IsAdmin() then return false, "Admin only" end
    if type(ticketObj) ~= "table" or not ticketObj.id or not ticketObj.uid then
        return false, "Invalid ticket"
    end

    if approveBool then
        local ok, msg
        if ticketObj.itemType == "cosmetics_bundle" then
            ok, msg = ZS.Backend.AdminSetCosmeticsBundle(ticketObj.uid, true)
        elseif ticketObj.itemType == "music_studio" then
            ok, msg = ZS.Backend.AdminSetMusicStudioPass(ticketObj.uid, true)
        elseif ticketObj.itemType == "decoration" or ticketObj.itemType == "theme" then
            ok, msg = ZS.Backend.AdminSetSingleItem(ticketObj.uid, ticketObj.itemType, ticketObj.itemId, true)
        else
            return false, "Unknown ticket itemType"
        end
        if not ok then return false, msg end

        ZS.DB.Put(ZS.Nodes.PurchaseReqs .. "/" .. ticketObj.id .. "/status", '"approved"')
        ZS.DB.PutAsync(ZS.Nodes.PurchaseReqs .. "/" .. ticketObj.id .. "/verifiedBy", '"' .. ZS.MyName .. '"')
        return true, "Ticket verified & unlocked for @" .. tostring(ticketObj.username)
    else
        ZS.DB.Put(ZS.Nodes.PurchaseReqs .. "/" .. ticketObj.id .. "/status", '"rejected"')
        ZS.DB.PutAsync(ZS.Nodes.PurchaseReqs .. "/" .. ticketObj.id .. "/verifiedBy", '"' .. ZS.MyName .. '"')
        ZS.Backend.PushNotif(ticketObj.uid, "social", "❌ Ticket Rejected", "Ticket " .. ticketObj.id .. " could not be verified. Contact @" .. ZS.State.StoreConfig.discordContact .. " on Discord.", ZS.MyUid)
        return true, "Ticket marked rejected."
    end
end

