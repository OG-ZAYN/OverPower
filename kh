-- Parses external API metadata (e.g., {status, title, duration, filesize, link}) safely
-- NEVER falsely marks an external MP3 link as directly playable in Roblox Sound.
function ZS.Music.ExternalAdapter.InspectExternalPayload(rawText)
    local clean = tostring(rawText or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if clean == "" then
        return {
            playable = false,
            status = "empty",
            message = "Paste an approved Roblox Audio Asset ID (numbers) to play, or paste an external API JSON/link to inspect compatibility."
        }
    end

    -- Check if already a valid Roblox Asset ID
    local rbxId = clean:match("^rbxassetid://(%d+)$") or clean:match("^(%d+)$")
    if rbxId then
        return {
            playable = true,
            status = "roblox_compatible",
            assetId = rbxId,
            message = "Compatible Roblox Audio Asset ID (#" .. rbxId .. "). Ready for permission check & playback."
        }
    end

    -- Inspect JSON response structure (e.g., status, title, duration, filesize, link)
    if clean:sub(1, 1) == "{" then
        local ok, parsed = pcall(function() return HttpService:JSONDecode(clean) end)
        if ok and type(parsed) == "table" then
            local title = tostring(parsed.title or "External Track")
            local dur = tonumber(parsed.duration) or 0
            local fSize = tonumber(parsed.filesize) or 0
            local extLink = tostring(parsed.link or "")
            local statusStr = tostring(parsed.status or "ok")

            if extLink:match("^https?://") then
                return {
                    playable = false,
                    status = "external_mp3_incompatible",
                    title = title,
                    duration = dur,
                    filesize = fSize,
                    link = extLink,
                    rawStatus = statusStr,
                    message = string.format(
                        "Detected '%s' (%s, %.1f MB) — External MP3 links cannot play directly in Roblox Sound. Upload lawful/licensed audio via Roblox Creator Hub and enter the approved Roblox Asset ID.",
                        title:sub(1, 36),
                        ZS.Music.FormatDuration(dur),
                        fSize / (1024 * 1024)
                    )
                }
            end
        end
    end

    -- Direct external URL check
    if clean:match("^https?://") then
        return {
            playable = false,
            status = "external_url_incompatible",
            link = clean,
            message = "External MP3/HTTP URLs are not supported directly by Roblox Sound. Publish permitted audio through Roblox Creator Hub and paste the resulting Roblox Audio Asset ID."
        }
    end

    return {
        playable = false,
        status = "invalid",
        message = "Unrecognized input. Enter a numeric Roblox Audio Asset ID (example: 1848354536)."
    }
end

