    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 9.5
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Text = info.label
    lbl.ZIndex = pill.ZIndex + 1

    ZS.Anim.Register(pill, function(now)
        stGrad.Rotation = (now * 110) % 360
    end, false)

    return pill
end

function ZS.Anim.PlayEntrance(guiObj)
    if not guiObj then return end
    local sc = guiObj:FindFirstChild("V80EntranceScale") or Instance.new("UIScale", guiObj)
    sc.Name = "V80EntranceScale"
    if ZS.State.CinematicIntro and not ZS.State.PerformanceMode then
        sc.Scale = 0.88
        TweenService:Create(sc, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.0 }):Play()
    else
        sc.Scale = 1.0
    end
end
