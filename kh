    hTitle.ZIndex = 134

    local xBtn = Instance.new("TextButton", hdr)
    xBtn.Size = UDim2.new(0, 26, 0, 26)
    xBtn.Position = UDim2.new(1, -32, 0.5, -13)
    xBtn.BackgroundColor3 = Color3.fromRGB(185, 42, 55)
    xBtn.Font = Enum.Font.GothamBold
    xBtn.TextSize = 11
    xBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    xBtn.Text = "X"
    xBtn.ZIndex = 134
    Instance.new("UICorner", xBtn).CornerRadius = UDim.new(0, 6)
    xBtn.MouseButton1Click:Connect(closeModal)

    local tabRow = Instance.new("Frame", modal)
    tabRow.Size = UDim2.new(1, -20, 0, 28)
    tabRow.Position = UDim2.new(0, 10, 0, 38)
    tabRow.BackgroundTransparency = 1
    tabRow.ZIndex = 133
    local tLay = Instance.new("UIListLayout", tabRow)
    tLay.FillDirection = Enum.FillDirection.Horizontal
    tLay.HorizontalAlignment = Enum.HorizontalAlignment.Center
    tLay.Padding = UDim.new(0, 6)
    tLay.SortOrder = Enum.SortOrder.LayoutOrder

    local scroll = Instance.new("ScrollingFrame", modal)
    scroll.Size = UDim2.new(1, -20, 1, -78)
    scroll.Position = UDim2.new(0, 10, 0, 72)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 2
    scroll.ScrollBarImageColor3 = themeObj.accent
    scroll.ZIndex = 133

    local sLay = Instance.new("UIListLayout", scroll)
    sLay.Padding = UDim.new(0, 6)
    sLay.SortOrder = Enum.SortOrder.LayoutOrder
    Instance.new("UIPadding", scroll).PaddingTop = UDim.new(0, 2)
    sLay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, sLay.AbsoluteContentSize.Y + 14)
    end)

    local tabBtns = {}
    local function populate()
        followModalSeq = followModalSeq + 1
        local tok = followModalSeq

        for id, b in pairs(tabBtns) do
            if id == "Requests" then
                local rCnt = ZS.Util.CountKeys(ZS.State.Requests)
                b.Text = rCnt > 0 and ("Requests (" .. rCnt .. ")") or "Requests"
            end
            if id == activeTab then
                b.BackgroundColor3 = themeObj.accent
                b.TextColor3 = Color3.fromRGB(12, 12, 18)
            else
                b.BackgroundColor3 = themeObj.cardBg
                b.TextColor3 = themeObj.textColor
            end
        end

        for _, ch in ipairs(scroll:GetChildren()) do
            if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then ch:Destroy() end
        end

        local loading = Instance.new("TextLabel", scroll)
        loading.Size = UDim2.new(1, 0, 0, 44)
        loading.BackgroundTransparency = 1
        loading.Font = Enum.Font.GothamMedium
        loading.TextSize = 11
        loading.TextColor3 = themeObj.accent
        loading.Text = "◐ Loading " .. activeTab .. "..."
        loading.ZIndex = 134

        task.spawn(function()
            ZS.Backend.FetchGraph(ZS.MyUid, true)
            if not isMyProf then ZS.Backend.FetchGraph(uidStr, true) end

            local uids = {}
            if activeTab == "Followers" then
                for k, v in pairs(ZS.State.Followers[uidStr] or {}) do if v then table.insert(uids, tostring(k)) end end
            elseif activeTab == "Following" then
                for k, v in pairs(ZS.State.Following[uidStr] or {}) do if v then table.insert(uids, tostring(k)) end end
            elseif activeTab == "Requests" and isMyProf then
                local reqs = ZS.Backend.FetchMyRequests()
                for k, v in pairs(reqs) do
                    if type(v) == "table" then
                        if v.username then ZS.Util.RegisterAccount(v.username, v.displayName or v.username, tonumber(k) or 1) end
                        table.insert(uids, tostring(k))
                    end
                end
            end

            if followModalSeq ~= tok or not scroll or not scroll.Parent then return end
            if loading and loading.Parent then loading:Destroy() end

            if #uids == 0 then
                local empty = Instance.new("TextLabel", scroll)
                empty.Size = UDim2.new(1, 0, 0, 60)
                empty.BackgroundTransparency = 1
                empty.Font = Enum.Font.GothamMedium
                empty.TextSize = 11
                empty.TextColor3 = themeObj.subText
                empty.Text = activeTab == "Requests" and "No pending follow requests." or ("No users in " .. activeTab .. " yet.")
                empty.ZIndex = 134
                return
            end

            for idx, uId in ipairs(uids) do
                renderFollowModalRow(scroll, uId, activeTab, isMyProf, themeObj, idx, populate)
            end
        end)
    end

    local tabs = isMyProf and {
        { id = "Followers", lbl = "Followers", w = 0.32, ord = 1 },
        { id = "Following", lbl = "Following", w = 0.32, ord = 2 },
        { id = "Requests",  lbl = "Requests",  w = 0.32, ord = 3 }
    } or {
        { id = "Followers", lbl = "Followers", w = 0.48, ord = 1 },
        { id = "Following", lbl = "Following", w = 0.48, ord = 2 }
    }

    for _, td in ipairs(tabs) do
        local tb = Instance.new("TextButton", tabRow)
        tb.Size = UDim2.new(td.w, 0, 1, 0)
        tb.BackgroundColor3 = themeObj.cardBg
        tb.Font = Enum.Font.GothamBold
        tb.TextSize = 10
        tb.TextColor3 = themeObj.textColor
        tb.Text = td.lbl
        tb.LayoutOrder = td.ord
        tb.ZIndex = 134
        Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 7)
        tb.MouseButton1Click:Connect(function() activeTab = td.id; populate() end)
        tabBtns[td.id] = tb
    end

    populate()
end

