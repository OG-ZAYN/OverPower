                Instance.new("UICorner", decB).CornerRadius = UDim.new(0, 6)
                decB.MouseButton1Click:Connect(function()
                    task.spawn(function()
                        ZS.Backend.DeclineFollowRequest(r.uid)
                        ZS.UI.UpdateNotifBadge()
                        ZS.UI.RefreshNotifsPage()
                    end)
                end)
            end
        end

        -- 2. Activity & Store Notifications List
        if #notifs == 0 then
            local em = Instance.new("TextLabel", page)
            em.Size = UDim2.new(1, 0, 0, 64)
            em.BackgroundTransparency = 1
            em.Font = Enum.Font.GothamMedium
            em.TextSize = 11
            em.TextColor3 = Color3.fromRGB(145, 148, 175)
            em.Text = "🔔 You're all caught up! No notifications yet."
            em.LayoutOrder = ord
            em.ZIndex = 32
        else
            for idx, item in ipairs(notifs) do
                local unread = (item.read ~= true)
                local card = Instance.new("TextButton", page)
                card.Size = UDim2.new(1, 0, 0, 56)
                card.BackgroundColor3 = unread and Color3.fromRGB(26, 20, 46) or Color3.fromRGB(15, 14, 24)
                card.Text = ""
                card.LayoutOrder = ord + idx
                card.ZIndex = 32
                Instance.new("UICorner", card).CornerRadius = UDim.new(0, 11)
                local st = Instance.new("UIStroke", card)
                st.Color = unread and Color3.fromRGB(165, 75, 255) or Color3.fromRGB(48, 44, 72)
                ZS.Util.AttachButtonJuice(card, 1.02)

                local av = Instance.new("ImageLabel", card)
                av.Size = UDim2.new(0, 34, 0, 34)
                av.Position = UDim2.new(0, 10, 0.5, -17)
                av.BackgroundTransparency = 1
                av.ScaleType = Enum.ScaleType.Crop
                av.ZIndex = 33
                Instance.new("UICorner", av).CornerRadius = UDim.new(1, 0)
                ZS.Util.LoadAvatarHeadshot(av, item.fromUid)

                local txt = Instance.new("TextLabel", card)
                txt.Size = UDim2.new(1, -60, 1, -8)
                txt.Position = UDim2.new(0, 52, 0, 4)
                txt.BackgroundTransparency = 1
                txt.Font = Enum.Font.GothamMedium
                txt.TextSize = 10
                txt.TextColor3 = Color3.fromRGB(242, 244, 255)
                txt.TextXAlignment = Enum.TextXAlignment.Left
                txt.TextWrapped = true
                txt.RichText = true
                txt.ZIndex = 33
                txt.Text = string.format("<b>%s</b>  <font color='#9A9EC2' size='9'>• %s</font>\n<font color='#C2C5E0'>%s</font>",
                    tostring(item.title), ZS.Util.TimeAgo(item.timestamp), tostring(item.message))

                card.MouseButton1Click:Connect(function()
                    if unread and item.id then
                        item.read = true
                        ZS.DB.PutAsync(ZS.Nodes.Notifs .. "/" .. ZS.MyUid .. "/" .. item.id .. "/read", true)
                        ZS.State.UnreadNotifs = math.max(0, (ZS.State.UnreadNotifs or 1) - 1)
                        ZS.UI.UpdateNotifBadge()
                    end
                    if item.type == "purchase_approved" then
                        ZS.OpenStore("Decorations")
                    elseif item.fromUid and tonumber(item.fromUid) and tonumber(item.fromUid) > 1 then
                        ZS.OpenProfile(item.fromUid)
                    end
                end)
            end
        end
    end)
end

