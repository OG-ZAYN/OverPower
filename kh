function ZS.Backend.DefaultPrivacy()
    return {
        isPrivate = false,
        allowFollows = true,
        dmPermission = "Everyone", -- Everyone | Followers | Mutuals | None
        hideLists = false,
        storyPrivacy = "Public"    -- Public | Followers | Private
    }
end

function ZS.Backend.BuildDefaultProfile(uidStr, username, displayName)
    local acc = ZS.Util.GetAccountByUid(uidStr)
    local uName = (username and username ~= "") and username or acc.Username
    local dName = (displayName and displayName ~= "") and displayName or acc.DisplayName
    return {
        uid = uidStr,
        username = uName,
        displayName = dName,
        customAvatar = "",
        bio = "",
        theme = "default_base",
        decoration = "none",
        badges = {},
        privacy = ZS.Backend.DefaultPrivacy(),
        createdAt = ZS.Util.Now(),
        updatedAt = ZS.Util.Now()
    }
end

function ZS.Backend.NormalizeProfile(uidStr, raw)
    local base = ZS.Backend.BuildDefaultProfile(uidStr)
    local ent = ZS.Backend.FetchEntitlements(uidStr, false)
    local tbl = type(raw) == "table" and raw or {}

    local themeId = tostring(tbl.theme or "default_base")
    local decorId = tostring(tbl.decoration or "none")

    -- Strictly enforce paid ownership on display
    if themeId ~= "default_base" and not ZS.Backend.OwnsTheme(uidStr, themeId) then
        themeId = "default_base"
    end
    if decorId ~= "none" and not ZS.Backend.OwnsDecoration(uidStr, decorId) then
        decorId = "none"
    end

    local prof = {
        uid = uidStr,
        username = (type(tbl.username) == "string" and tbl.username ~= "") and tbl.username or base.username,
        displayName = (type(tbl.displayName) == "string" and tbl.displayName ~= "") and tbl.displayName or base.displayName,
        customAvatar = type(tbl.customAvatar) == "string" and tbl.customAvatar or "",
        bio = type(tbl.bio) == "string" and tbl.bio or "",
        theme = themeId,
        decoration = decorId,
        badges = {},
        privacy = ZS.Backend.DefaultPrivacy(),
        createdAt = tonumber(tbl.createdAt) or base.createdAt,
        updatedAt = tonumber(tbl.updatedAt) or ZS.Util.Now()
    }

    local seenB = {}
    local function pushB(k)
        local key = tostring(k or ""):upper()
        if ZS.Catalog.Badges[key] and not seenB[key] then
            seenB[key] = true
            table.insert(prof.badges, key)
        end
    end

    if ZS.Util.IsAdmin(uidStr, prof.username) then
        pushB("CREATOR"); pushB("VIP"); pushB("LEGEND"); pushB("OG")
    end
    if ent.cosmeticsBundle then
        pushB("VIP"); pushB("ELITE")
    end
    if ent.musicStudioPass then
        pushB("MUSIC")
    end
    if type(ent.badges) == "table" then
        for k, v in pairs(ent.badges) do
            if type(k) == "number" and type(v) == "string" then pushB(v)
            elseif v == true then pushB(k) end
        end
    end

    if type(tbl.privacy) == "table" then
        prof.privacy.isPrivate = tbl.privacy.isPrivate == true
        prof.privacy.allowFollows = tbl.privacy.allowFollows ~= false
        prof.privacy.hideLists = tbl.privacy.hideLists == true
        local dmP = tostring(tbl.privacy.dmPermission or "Everyone")
        if dmP == "Everyone" or dmP == "Followers" or dmP == "Mutuals" or dmP == "None" then
            prof.privacy.dmPermission = dmP
        end
        local stP = tostring(tbl.privacy.storyPrivacy or "Public")
        if stP == "Public" or stP == "Followers" or stP == "Private" then
            prof.privacy.storyPrivacy = stP
        end
    end

    ZS.Util.RegisterAccount(prof.username, prof.displayName, tonumber(uidStr) or 1)
    return prof
end

function ZS.Backend.FetchProfile(uid, forceRefresh)
    local uidStr = ZS.Util.NormalizeUid(uid)
    if not uidStr then return nil end

    if not forceRefresh and ZS.State.Profiles[uidStr] then
        return ZS.State.Profiles[uidStr]
    end

    ZS.Backend.FetchEntitlements(uidStr, forceRefresh == true)
    local raw = ZS.DB.Get(ZS.Nodes.Profiles .. "/" .. uidStr)
    local prof = ZS.Backend.NormalizeProfile(uidStr, raw)
    ZS.State.Profiles[uidStr] = prof

    if uidStr == ZS.MyUid and type(raw) ~= "table" then
        prof.username = ZS.MyName
        prof.displayName = ZS.Player.DisplayName
        ZS.State.Profiles[uidStr] = prof
        ZS.DB.PutAsync(ZS.Nodes.Profiles .. "/" .. uidStr, prof)
        ZS.DB.PutAsync(ZS.Nodes.UserIndex .. "/" .. ZS.MyNameLower, {
            uid = uidStr,
            username = ZS.MyName,
            displayName = prof.displayName,
            updatedAt = ZS.Util.Now()
        })
    end
    return prof
end

function ZS.Backend.SaveMyProfile(updates)
    local myUid = ZS.MyUid
    local current = ZS.Backend.FetchProfile(myUid, false)
    if not current then return false, "Profile failed to load" end

    -- Always refresh entitlements before validating paid cosmetics
    ZS.Backend.FetchEntitlements(myUid, true)

    if type(updates.displayName) == "string" then
        local clean = updates.displayName:gsub("^%s+", ""):gsub("%s+$", ""):sub(1, 28)
        if clean ~= "" then current.displayName = clean end
    end

    if type(updates.bio) == "string" then
        current.bio = updates.bio:gsub("[\r\n]+", " "):sub(1, 140)
    end

    if type(updates.customAvatar) == "string" then
        local av = updates.customAvatar:gsub("^%s+", ""):gsub("%s+$", ""):sub(1, 220)
        if av == "" or av:match("^%d+$") or av:match("^rbxassetid://%d+$") or av:match("^rbxthumb://") or av:match("^https?://") then
            current.customAvatar = av
        else
            return false, "Invalid profile image format. Use Roblox Asset ID or direct image link."
        end
    end

    if type(updates.theme) == "string" then
        local tId = updates.theme
        if tId ~= "default_base" then
            if not ZS.Catalog.ProfileThemeMap[tId] then
                return false, "Unknown theme ID"
            end
            if not ZS.Backend.IsThemeEnabled(tId) then
                return false, "Theme currently disabled by Admin"
            end
            if not ZS.Backend.OwnsTheme(myUid, tId) then
                return false, "Theme locked! Purchase it for ₹" .. tostring(ZS.Backend.GetThemePrice(tId)) .. " in Store."
            end
        end
        current.theme = tId
    end

    if type(updates.decoration) == "string" then
        local dId = updates.decoration
        if dId ~= "none" then
            if not ZS.Catalog.DecorationMap[dId] then
                return false, "Unknown decoration ID"
            end
            if not ZS.Backend.IsDecorationEnabled(dId) then
                return false, "Decoration currently disabled by Admin"
            end
            if not ZS.Backend.OwnsDecoration(myUid, dId) then
                return false, "Decoration locked! Purchase it for ₹" .. tostring(ZS.Backend.GetDecorationPrice(dId)) .. " in Store."
            end
        end
        current.decoration = dId
    end

    if type(updates.privacy) == "table" then
        local pr = updates.privacy
        if pr.isPrivate ~= nil then current.privacy.isPrivate = pr.isPrivate == true end
        if pr.allowFollows ~= nil then current.privacy.allowFollows = pr.allowFollows == true end
        if pr.hideLists ~= nil then current.privacy.hideLists = pr.hideLists == true end
        if pr.dmPermission == "Everyone" or pr.dmPermission == "Followers" or pr.dmPermission == "Mutuals" or pr.dmPermission == "None" then
            current.privacy.dmPermission = pr.dmPermission
        end
        if pr.storyPrivacy == "Public" or pr.storyPrivacy == "Followers" or pr.storyPrivacy == "Private" then
            current.privacy.storyPrivacy = pr.storyPrivacy
        end
    end

    -- Username strictly locked to Roblox account identity
    current.username = ZS.MyName
    current.updatedAt = ZS.Util.Now()
    ZS.State.Profiles[myUid] = current

    local ok, errMsg = ZS.DB.Put(ZS.Nodes.Profiles .. "/" .. myUid, current)
    if not ok then
        return false, errMsg or "Failed to write profile"
    end

    ZS.DB.PutAsync(ZS.Nodes.UserIndex .. "/" .. ZS.MyNameLower, {
        uid = myUid,
        username = ZS.MyName,
        displayName = current.displayName,
        updatedAt = current.updatedAt
    })

    return true, "Profile saved permanently!"
end

