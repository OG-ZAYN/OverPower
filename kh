        end
        badge.Text = unreadCnt >= 5 and "5+ New" or (tostring(unreadCnt) .. " New")
        card.BackgroundColor3 = theme.Accent
        card.BackgroundTransparency = 0.84
    else
        if badge then badge:Destroy() end
        card.BackgroundColor3 = theme.OtherBubble
        card.BackgroundTransparency = theme.BubOtherTrans
