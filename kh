function ZS.UI.UpdateNavActiveState(mode)
    if not ZS.UI.NavBtns then return end
    local theme = ZS.Catalog.GetChatTheme()
    local group = "Chat"
    if mode == "Profile" or mode == "EditProfile" then group = "Profile"
    elseif mode == "Stories" or mode == "CreateStory" then group = "Stories"
    elseif mode == "MusicStudio" then group = "Studio"
    elseif mode == "Store" then group = "Store" end

    for k, btn in pairs(ZS.UI.NavBtns) do
        local isAct = (k == group)
        local bar = btn:FindFirstChild("ActiveBar")
        local lbl = btn:FindFirstChild("Lbl")
        local ico = btn:FindFirstChild("Ico")
        if isAct then
            TweenService:Create(btn, TweenInfo.new(0.18), {
                BackgroundColor3 = Color3.fromRGB(28, 22, 48),
                BackgroundTransparency = 0.08
            }):Play()
            if bar then bar.Visible = true; bar.BackgroundColor3 = (k == "Store") and Color3.fromRGB(255, 205, 55) or theme.Accent end
            if lbl then lbl.TextColor3 = (k == "Store") and Color3.fromRGB(255, 215, 70) or theme.Accent end
            if ico then ico.TextTransparency = 0 end
        else
            TweenService:Create(btn, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
            if bar then bar.Visible = false end
            if lbl then lbl.TextColor3 = theme.SubText end
            if ico then ico.TextTransparency = 0.3 end
        end
    end
end

