local function hideAllPages()
    local pages = {
        ZS.UI.Scroll,
        ZS.UI.SearchWrapper,
        ZS.UI.InputWrapper,
        ZS.UI.ReplyPreview,
        ZS.UI.JumpBtn,
        ZS.UI.StickerTray,
        ZS.UI.ImageTray,
        ZS.UI.SlowdownLabel,
        ZS.UI.SettingsPage,
        ZS.UI.ProfilePage,
        ZS.UI.EditProfilePage,
        ZS.UI.StoriesPage,
        ZS.UI.CreateStoryPage,
        ZS.UI.MusicStudioPage,
        ZS.UI.StorePage,
        ZS.UI.NotifsPage,
        ZS.UI.AdminPage
    }
    for _, obj in ipairs(pages) do
        if obj then obj.Visible = false end
    end
end

local function clearChatScroll()
    if not ZS.UI.Scroll then return end
    for _, ch in ipairs(ZS.UI.Scroll:GetChildren()) do
        if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then
            ch:Destroy()
        end
    end
    table.clear(ZS.State.ActiveBubbles)
end

function ZS.OpenProfile(targetUid)
    local uidStr = ZS.Util.NormalizeUid(targetUid) or ZS.MyUid
    ZS.State.ViewingProfileUid = uidStr
    ZS.SwitchMode("Profile", uidStr)
end

function ZS.OpenStore(storeTab)
    ZS.State.StoreTab = storeTab or "Decorations"
    ZS.SwitchMode("Store", ZS.State.StoreTab)
end

function ZS.SwitchMode(newMode, param)
    if ZS.State.Mode == "MusicStudio" and newMode ~= "MusicStudio" and ZS.Music.StopPreview then
        ZS.Music.StopPreview()
    end
    if ZS.State.Mode == "CreateStory" and newMode ~= "CreateStory" and ZS.Stories.StopAudio then
        ZS.Stories.StopAudio()
    end

    ZS.State.Mode = newMode
    ZS.Chat.CancelActionBar()
    hideAllPages()

    local title = ZS.UI.Title
    local sub = ZS.UI.SubTitle
    local back = ZS.UI.BackBtn
    local hdp = ZS.UI.HeaderDP

    if sub then sub.Visible = false end
    if hdp then hdp.Visible = false end
    if back then back.Visible = (newMode ~= "Server") end
    if title then
        title.Position = (newMode == "Server") and UDim2.new(0, 12, 0, 0) or UDim2.new(0, 38, 0, 0)
    end

    if newMode == "Server" then
        ZS.State.ActiveDM = nil
        if title then title.Text = "ᴢ ᴀ ʏ ɴ  s ᴏ ᴄ ɪ ᴀ ʟ  ᴠ80" end
        if ZS.UI.Scroll then
            ZS.UI.Scroll.Position = UDim2.new(0, 0, 0, ZS.Layout.HeaderH)
            ZS.UI.Scroll.Size = UDim2.new(1, 0, 1, -(ZS.Layout.HeaderH + ZS.Layout.NavH + 48))
            ZS.UI.Scroll.Visible = true
        end
        if ZS.UI.InputWrapper then ZS.UI.InputWrapper.Visible = true end
        clearChatScroll()
        for _, msg in ipairs(ZS.State.Cache.Server) do
            ZS.Chat.RenderBubble(msg.Sender, msg.UserID, msg.Msg, msg.Time, msg.ID, msg.Edited, msg.Reactions)
        end
        ZS.Chat.HandleScroll(true)

    elseif newMode == "DM_Inbox" then
        ZS.State.ActiveDM = nil
        if title then title.Text = "📩 DIRECT MESSAGES" end
        if ZS.UI.SearchWrapper then ZS.UI.SearchWrapper.Visible = true end
        if ZS.UI.Scroll then
            ZS.UI.Scroll.Position = UDim2.new(0, 0, 0, ZS.Layout.HeaderH + 46)
            ZS.UI.Scroll.Size = UDim2.new(1, 0, 1, -(ZS.Layout.HeaderH + ZS.Layout.NavH + 48))
            ZS.UI.Scroll.Visible = true
        end
        clearChatScroll()
        ZS.Chat.LiveUpdateInboxSort()

    elseif newMode == "DM" and type(param) == "string" and param ~= "" then
        local partnerLow = param:lower()
        ZS.State.ActiveDM = partnerLow
        local acc = ZS.Util.GetAccount(partnerLow)
        if hdp then
            hdp.Visible = true
            ZS.Util.LoadAvatarHeadshot(hdp, acc.UserId)
        end
        if title then
            title.Position = UDim2.new(0, 66, 0, -4)
            title.Text = acc.DisplayName
        end
        if sub then
            sub.Visible = true
            sub.Text = "@" .. acc.Username .. " • Tap name for Profile"
        end
        if ZS.UI.Scroll then
            ZS.UI.Scroll.Position = UDim2.new(0, 0, 0, ZS.Layout.HeaderH)
            ZS.UI.Scroll.Size = UDim2.new(1, 0, 1, -(ZS.Layout.HeaderH + ZS.Layout.NavH + 48))
            ZS.UI.Scroll.Visible = true
        end
        if ZS.UI.InputWrapper then ZS.UI.InputWrapper.Visible = true end
        clearChatScroll()

        local msgs = ZS.State.Cache.DMs[partnerLow] or {}
        for _, msg in ipairs(msgs) do
            ZS.Chat.RenderBubble(msg.Sender, msg.UserID, msg.Msg, msg.Time, msg.ID, msg.Edited, msg.Reactions)
        end
        ZS.Chat.SetLastRead(partnerLow, ZS.Util.Now())
        ZS.DB.PutAsync(ZS.Nodes.ReadReceipts .. "/" .. partnerLow .. "/" .. ZS.MyNameLower, ZS.Util.Now())
        ZS.Chat.HandleScroll(true)

    elseif newMode == "CloseFriends" then
