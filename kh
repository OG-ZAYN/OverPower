function ZS.Chat.RenderBubble(senderName, senderUid, msgText, ts, msgId, edited, reactions)
    local scroll = ZS.UI.Scroll
    if not scroll then return end

    local theme = ZS.Catalog.GetChatTheme()
    local isMe = tostring(senderName):lower() == ZS.MyNameLower
    local isZara = (senderName == "ZARA")
    local uidNum = tonumber(senderUid) or 0

    if not isMe and not isZara and uidNum > 1 and ZS.Backend.IsBlocked(uidNum) then
        return
    end

    local rplUser, rplBody, body = tostring(msgText or ""):match("^%[RPL::(.-)::(.-)::RPL%]%s*(.*)")
    if not rplUser then body = tostring(msgText or "") end
    local isEdited = edited == true
    if body:sub(1, 5) == "[EDT]" then isEdited = true; body = body:sub(6) end

    local row = Instance.new("Frame", scroll)
    row.Size = UDim2.new(1, 0, 0, 0)
    row.AutomaticSize = Enum.AutomaticSize.Y
    row.BackgroundTransparency = 1
    if msgId then ZS.State.ActiveBubbles[msgId] = row end

    -- Avatar Holder (Clickable -> opens User's Instagram Profile)
    local avSize = isZara and 32 or 30
    local avWrap = Instance.new("Frame", row)
    avWrap.Name = "BubbleAvatarWrap"
    avWrap.Size = UDim2.new(0, avSize, 0, avSize)
    avWrap.BackgroundTransparency = 1
    avWrap.AnchorPoint = isMe and Vector2.new(1, 0) or Vector2.new(0, 0)
    avWrap.Position = isMe and UDim2.new(1, -2, 0, 2) or UDim2.new(0, 2, 0, 2)
    avWrap.ZIndex = 6

    local avBtn = Instance.new("ImageButton", avWrap)
    avBtn.Size = UDim2.new(1, 0, 1, 0)
    avBtn.BackgroundTransparency = 1
    avBtn.ScaleType = Enum.ScaleType.Crop
    avBtn.ZIndex = 7
    Instance.new("UICorner", avBtn).CornerRadius = UDim.new(1, 0)

    if isZara then
        avBtn.Image = "rbxthumb://type=Asset&id=81131373496932&w=150&h=150"
    else
        local prof = uidNum > 1 and ZS.State.Profiles[tostring(uidNum)] or nil
        ZS.Util.LoadAvatarHeadshot(avBtn, uidNum, prof and prof.customAvatar)
        if prof and prof.decoration and prof.decoration ~= "none" then
            ZS.Anim.ApplyAvatarDecoration(avWrap, prof.decoration, true)
        end
    end

    avBtn.MouseButton1Click:Connect(function()
        if isZara then return end
        if uidNum > 1 then
            ZS.OpenProfile(uidNum)
        else
            task.spawn(function()
                local res = ZS.Util.ResolveUser(senderName)
                if res and res.UserId then ZS.OpenProfile(res.UserId) end
            end)
        end
    end)

    local bubble = Instance.new("Frame", row)
    bubble.Name = "MessageBubble"
    bubble.AutomaticSize = Enum.AutomaticSize.XY
    bubble.AnchorPoint = isMe and Vector2.new(1, 0) or Vector2.new(0, 0)
    bubble.Position = isMe and UDim2.new(1, -40, 0, 0) or UDim2.new(0, 40, 0, 0)
    bubble.BackgroundColor3 = isMe and theme.MyBubble or theme.OtherBubble
    bubble.BackgroundTransparency = isMe and theme.BubMeTrans or theme.BubOtherTrans
    bubble.Active = true
    Instance.new("UICorner", bubble).CornerRadius = UDim.new(0, 14)
    Instance.new("UISizeConstraint", bubble).MaxSize = Vector2.new(335, 9999)
    bubble:SetAttribute("LiveText", body)
    bubble:SetAttribute("RawSender", senderName)

    local bLay = Instance.new("UIListLayout", bubble)
    bLay.Padding = UDim.new(0, 3)
    bLay.SortOrder = Enum.SortOrder.LayoutOrder
    local bPad = Instance.new("UIPadding", bubble)
    bPad.PaddingTop = UDim.new(0, 6); bPad.PaddingBottom = UDim.new(0, 6)
    bPad.PaddingLeft = UDim.new(0, 12); bPad.PaddingRight = UDim.new(0, 12)

    if not isMe then
        local acc = ZS.Util.GetAccount(senderName)
        local nLbl = Instance.new("TextLabel", bubble)
        nLbl.Name = "SenderName"
        nLbl.AutomaticSize = Enum.AutomaticSize.XY
        nLbl.BackgroundTransparency = 1
        nLbl.Font = Enum.Font.GothamBold
        nLbl.TextSize = isZara and 11.5 or 10
        nLbl.TextColor3 = isZara and Color3.fromRGB(190, 80, 255) or theme.NameColor
        nLbl.Text = isZara and "ZARA" or acc.DisplayName
        nLbl.LayoutOrder = 1
        if not isZara then ZS.Util.RegisterAccount(senderName, acc.DisplayName, uidNum, nLbl) end
    end

    if rplUser then
        local rAcc = ZS.Util.GetAccount(rplUser)
        local rBox = Instance.new("Frame", bubble)
        rBox.AutomaticSize = Enum.AutomaticSize.XY
        rBox.BackgroundColor3 = theme.TextColor
        rBox.BackgroundTransparency = 0.88
        rBox.LayoutOrder = 2
        Instance.new("UICorner", rBox).CornerRadius = UDim.new(0, 6)
        local rp = Instance.new("UIPadding", rBox)
        rp.PaddingLeft = UDim.new(0, 8); rp.PaddingRight = UDim.new(0, 8); rp.PaddingTop = UDim.new(0, 3); rp.PaddingBottom = UDim.new(0, 3)
        local rt = Instance.new("TextLabel", rBox)
        rt.AutomaticSize = Enum.AutomaticSize.XY
        rt.BackgroundTransparency = 1
        rt.Font = Enum.Font.GothamMedium
        rt.TextSize = 10
        rt.TextColor3 = theme.TextColor
        rt.RichText = true
        rt.Text = string.format("<b>%s</b>\n%s", rAcc.DisplayName, tostring(rplBody))
    end

    local stkId = body:match("%[STICKER://(%d+)%]")
    local mediaUrl = body:match("%[MEDIA::(.-)::MEDIA%]")
    if stkId then
        local img = Instance.new("ImageLabel", bubble)
        img.Size = UDim2.new(0, 110, 0, 110)
        img.BackgroundTransparency = 1
        img.Image = "rbxthumb://type=Asset&id=" .. stkId .. "&w=150&h=150"
        img.ScaleType = Enum.ScaleType.Fit
        img.LayoutOrder = 3
    elseif mediaUrl then
        local mBtn = Instance.new("ImageButton", bubble)
        mBtn.Size = UDim2.new(0, 195, 0, 145)
        mBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
        mBtn.ScaleType = Enum.ScaleType.Crop
        mBtn.LayoutOrder = 3
        Instance.new("UICorner", mBtn).CornerRadius = UDim.new(0, 8)
        ZS.Util.LoadImageSafe(mBtn, mediaUrl)
        mBtn.MouseButton1Click:Connect(function()
            if ScreenGui:FindFirstChild("ZaynV80_MediaViewer") then return end
            local blur = Instance.new("BlurEffect", Lighting); blur.Name = "ZaynV80_Blur"; blur.Size = 20
            local v = Instance.new("Frame", ScreenGui)
            v.Name = "ZaynV80_MediaViewer"; v.Size = UDim2.new(1, 0, 1, 0)
            v.BackgroundColor3 = Color3.fromRGB(0, 0, 0); v.BackgroundTransparency = 0.15; v.Active = true; v.ZIndex = 1500
            local full = Instance.new("ImageLabel", v)
            full.Size = UDim2.new(0.88, 0, 0.88, 0); full.Position = UDim2.new(0.5, 0, 0.5, 0); full.AnchorPoint = Vector2.new(0.5, 0.5)
            full.BackgroundTransparency = 1; full.ScaleType = Enum.ScaleType.Fit; full.ZIndex = 1501
            ZS.Util.LoadImageSafe(full, mediaUrl)
            local x = Instance.new("TextButton", v)
            x.Size = UDim2.new(0, 42, 0, 42); x.Position = UDim2.new(1, -24, 0, 36); x.AnchorPoint = Vector2.new(1, 0)
            x.BackgroundColor3 = Color3.fromRGB(190, 40, 52); x.Font = Enum.Font.GothamBold; x.TextSize = 18
            x.TextColor3 = Color3.fromRGB(255, 255, 255); x.Text = "X"; x.ZIndex = 1502
            Instance.new("UICorner", x).CornerRadius = UDim.new(1, 0)
            x.MouseButton1Click:Connect(function()
                if Lighting:FindFirstChild("ZaynV80_Blur") then Lighting.ZaynV80_Blur:Destroy() end
                v:Destroy()
            end)
        end)
    else
        local msgLbl = Instance.new("TextLabel", bubble)
        msgLbl.Name = "MainMessageText"
        msgLbl.AutomaticSize = Enum.AutomaticSize.XY
        msgLbl.BackgroundTransparency = 1
        msgLbl.Font = Enum.Font.GothamMedium
        msgLbl.TextSize = 12.5
        msgLbl.TextColor3 = theme.TextColor
        msgLbl.TextWrapped = true
        msgLbl.RichText = true
        msgLbl.TextXAlignment = Enum.TextXAlignment.Left
        msgLbl.Text = isEdited and (body .. "\n<font color='#9A9AB8' size='10'><i>(edited)</i></font>") or body
        msgLbl.LayoutOrder = 3
    end

    local rHold = Instance.new("Frame", bubble)
    rHold.Name = "ReactContainer"
    rHold.AutomaticSize = Enum.AutomaticSize.XY
    rHold.BackgroundTransparency = 1
    rHold.LayoutOrder = 4
    local rLay = Instance.new("UIListLayout", rHold)
    rLay.FillDirection = Enum.FillDirection.Horizontal
    rLay.Padding = UDim.new(0, 4)
    if reactions then ZS.Chat.UpdateBubbleReactions(msgId, reactions) end

    -- Long-press to open Bubble Action Menu
    local holding = false
    bubble.InputBegan:Connect(function(inp)
        if isZara then return end
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            holding = true
            task.delay(0.5, function()
                if holding and bubble.Parent then
                    holding = false
                    ZS.Chat.OpenBubbleMenu(senderName, uidNum, bubble:GetAttribute("LiveText") or body, msgId, isMe)
                end
            end)
        end
    end)
    bubble.InputEnded:Connect(function() holding = false end)

    ZS.Chat.HandleScroll(isMe)

    -- Cap rendered bubbles at 60 to maintain zero lag
    local frames = {}
    for _, ch in ipairs(scroll:GetChildren()) do
        if ch:IsA("Frame") and ch:FindFirstChild("MessageBubble") then table.insert(frames, ch) end
    end
    if #frames > 60 then
        table.sort(frames, function(a, b) return a.AbsolutePosition.Y < b.AbsolutePosition.Y end)
        for idx = 1, #frames - 60 do
            if frames[idx] then frames[idx]:Destroy() end
        end
    end
end

