function ZS.Stories.CloseViewer()
    viewerSessionSeq = viewerSessionSeq + 1
    ZS.Stories.StopAudio()
    if ZS.Stories._progressAnimId then
        ZS.Anim.Unregister(ZS.Stories._progressAnimId)
        ZS.Stories._progressAnimId = nil
    end
    if Lighting:FindFirstChild("ZaynV80_Blur") then
        Lighting.ZaynV80_Blur:Destroy()
    end
    local old = ZS.UI.ScreenGui and ZS.UI.ScreenGui:FindFirstChild("ZaynV80_StoryViewer")
    if old then old:Destroy() end
end

function ZS.Stories.OpenViewer(ownerUid, storiesList, startIndex)
    if type(storiesList) ~= "table" or #storiesList == 0 then return end
    ZS.Stories.CloseViewer()

    local mySession = viewerSessionSeq
    local uidStr = tostring(ownerUid)
    local isOwner = (uidStr == ZS.MyUid)
    local canModerate = isOwner or ZS.Util.IsAdmin()
    local curIdx = math.clamp(tonumber(startIndex) or 1, 1, #storiesList)
    local paused = false
    local storyStartClock = os.clock()
    local STORY_DURATION = 7.5

    local blur = Instance.new("BlurEffect", Lighting)
    blur.Name = "ZaynV80_Blur"
    blur.Size = 18

    local overlay = Instance.new("Frame", ZS.UI.ScreenGui)
