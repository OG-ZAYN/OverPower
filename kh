function ZS.Chat.LiveUpdateInboxSort()
    if ZS.State.Mode ~= "DM_Inbox" or not ZS.UI.Scroll then return end
    local rows = {}
    for dmKey, msgs in pairs(ZS.State.Cache.DMs) do
        local last = msgs[#msgs]
        table.insert(rows, {
            k = dmKey,
            t = last and last.Time or 0,
            s = last and last.Msg or "Start a conversation...",
            u = ZS.Chat.GetUnreadCount(dmKey)
        })
    end
    table.sort(rows, function(a, b) return a.t > b.t end)

    local keep = {}
    for idx, item in ipairs(rows) do
        keep["DM_Card_" .. item.k] = true
        local existing = ZS.UI.Scroll:FindFirstChild("DM_Card_" .. item.k)
        if existing then
            existing.LayoutOrder = idx
            ZS.Chat.DressInboxCard(existing, item.k, item.s, item.u)
        else
            local acc = ZS.Util.GetAccount(item.k)
            ZS.Chat.RenderInboxCard(acc.DisplayName, acc.Username, item.k, item.s)
            local created = ZS.UI.Scroll:FindFirstChild("DM_Card_" .. item.k)
            if created then created.LayoutOrder = idx end
        end
    end
    for _, ch in ipairs(ZS.UI.Scroll:GetChildren()) do
        if ch.Name:match("^DM_Card_") and not keep[ch.Name] then ch:Destroy() end
    end
end

