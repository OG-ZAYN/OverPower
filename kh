        if ZS.UI.ProfilePage then
            ZS.UI.ProfilePage.Visible = true
            ZS.UI.RefreshProfilePage(uidStr)
        end

    elseif newMode == "EditProfile" then
        if title then title.Text = "✏️ EDIT PROFILE" end
        if ZS.UI.EditProfilePage then
            ZS.UI.EditProfilePage.Visible = true
            ZS.UI.RefreshEditProfilePage()
        end

    elseif newMode == "Stories" then
        if title then title.Text = "📸 PHOTO STORIES (24H)" end
        if ZS.UI.StoriesPage then
            ZS.UI.StoriesPage.Visible = true
            ZS.UI.RefreshStoriesPage()
        end

    elseif newMode == "CreateStory" then
        if title then title.Text = "➕ CREATE STORY" end
        if ZS.UI.CreateStoryPage then
            ZS.UI.CreateStoryPage.Visible = true
            ZS.UI.RefreshCreateStoryPage()
