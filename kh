        goBtn.MouseButton1Click:Connect(doLookup)
        findIn.FocusLost:Connect(function(enter) if enter then doLookup() end end)

        -- 2. INSTAGRAM-STYLE HERO CARD (CLEAN IDENTITY + FULL PROFILE ANIMATIONS)
        local hero = Instance.new("Frame", page)
