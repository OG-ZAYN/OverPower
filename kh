    local rId = "SREP_" .. tostring(ZS.Util.Now()) .. "_" .. tostring(math.random(1000, 9999))
    return ZS.DB.Put(ZS.Nodes.StoryReports .. "/" .. rId, {
        id = rId,
        storyId = storyObj.id,
