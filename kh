    vGrid.CellSize = UDim2.new(0, 58, 0, 58)
    vGrid.CellPadding = UDim2.new(0, 8, 0, 8)

    function ZS.UI.RefreshVaultUI()
        for _, ch in ipairs(vScroll:GetChildren()) do
            if ch:IsA("ImageButton") or ch:IsA("TextLabel") then ch:Destroy() end
        end
        local items = ZS.Util.ReadLocalJSON(ZS.LocalFiles.Vault, {})
        if #items == 0 then
            local empty = Instance.new("TextLabel", vScroll)
            empty.Size = UDim2.new(1, 0, 0, 60)
            empty.BackgroundTransparency = 1
            empty.Font = Enum.Font.GothamMedium
            empty.TextSize = 11
            empty.TextColor3 = theme.SubText
            empty.Text = "Vault empty. Paste an image link or Asset ID above."
            empty.ZIndex = 84
            return
        end
        for idx, imgRef in ipairs(items) do
            local ib = Instance.new("ImageButton", vScroll)
            ib.BackgroundColor3 = Color3.fromRGB(26, 26, 36)
            ib.ScaleType = Enum.ScaleType.Crop
            ib.ZIndex = 84
            Instance.new("UICorner", ib).CornerRadius = UDim.new(0, 6)
            ZS.Util.LoadImageSafe(ib, imgRef)

            local del = Instance.new("TextButton", ib)
            del.Size = UDim2.new(0, 16, 0, 16)
            del.Position = UDim2.new(1, -14, 0, -2)
            del.BackgroundColor3 = Color3.fromRGB(200, 42, 52)
            del.Font = Enum.Font.GothamBold
            del.TextSize = 9
            del.TextColor3 = Color3.fromRGB(255, 255, 255)
            del.Text = "X"
            del.ZIndex = 85
            Instance.new("UICorner", del).CornerRadius = UDim.new(1, 0)
            del.MouseButton1Click:Connect(function()
                table.remove(items, idx)
                ZS.Util.WriteLocalJSON(ZS.LocalFiles.Vault, items)
                ZS.UI.RefreshVaultUI()
            end)

            ib.MouseButton1Click:Connect(function()
                if os.clock() - ZS.State.LastSendTime < ZS.Config.ChatCooldown then return end
                if ZS.Chat.Send then
                    ZS.Chat.Send("[MEDIA::" .. imgRef .. "::MEDIA]")
                    ZS.State.LastSendTime = os.clock()
                end
                vTray.Visible = false
            end)
        end
        vScroll.CanvasSize = UDim2.new(0, 0, 0, math.ceil(#items / 5) * 68)
    end

    saveBtn.MouseButton1Click:Connect(function()
        local raw = urlBox.Text:match("^%s*(.-)%s*$")
        if raw == "" then return end
        urlBox.Text = ""
        local items = ZS.Util.ReadLocalJSON(ZS.LocalFiles.Vault, {})
        table.insert(items, 1, raw)
        ZS.Util.WriteLocalJSON(ZS.LocalFiles.Vault, items)
        ZS.UI.RefreshVaultUI()
        ZS.UI.ShowToast("🖼️ Vault", "Image saved to vault!", theme.Accent)
    end)
end

