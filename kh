local function parseFirebaseError(bodyStr)
    if type(bodyStr) ~= "string" then return true, "Empty network response" end
    if bodyStr == "" or bodyStr:match("^%s*<") then
        return true, "Database returned HTML or empty body"
    end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(bodyStr) end)
    if ok and type(decoded) == "table" and decoded.error ~= nil then
        return true, tostring(decoded.error)
    end
    return false, nil
end

function ZS.DB.FormatError(errMsg)
    local msg = tostring(errMsg or "Network error")
    if msg:lower():find("permission") then
        return "Firebase Permission Denied — publish the V80 Rules from Part 10 in Firebase Console."
    end
    return msg
end

function ZS.DB.RawRequest(fullUrl, method, body)
    local req = {
        Url = fullUrl,
        Method = string.upper(method or "GET"),
        Timeout = 12,
        Headers = {
            ["Content-Type"] = "application/json"
        }
    }
    if body ~= nil and req.Method ~= "GET" and req.Method ~= "DELETE" then
        req.Body = type(body) == "string" and body or HttpService:JSONEncode(body)
    end

    local ok, res = pcall(function() return httpReq(req) end)
    if ok and type(res) == "table" then
        return {
            StatusCode = tonumber(res.StatusCode) or 200,
            Body = tostring(res.Body or "null")
        }
    end
    return { StatusCode = 500, Body = '{"error":"HTTP request failed"}' }
end

function ZS.DB.BuildUrl(nodePath, bustCache)
    local clean = tostring(nodePath or ""):gsub("^/+", ""):gsub("%.json$", "")
    local url = ZS.Config.FirebaseURL .. "/" .. clean .. ".json"
    if bustCache then
        url = url .. "?bust=" .. tostring(os.clock()):gsub("%.", "") .. "_" .. tostring(math.random(1000, 9999))
    end
    return url
end

function ZS.DB.Get(nodePath)
    local res = ZS.DB.RawRequest(ZS.DB.BuildUrl(nodePath, true), "GET")
    if (res.StatusCode == 200 or res.StatusCode == 304) and res.Body ~= "null" and res.Body ~= "" and not res.Body:match("^%s*<") then
        local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok then
            if type(data) == "table" and data.error ~= nil then
                return nil, tostring(data.error)
            end
            return data, nil
        end
    end
    return nil, nil
end

function ZS.DB.Put(nodePath, dataValue)
    local encoded = type(dataValue) == "string" and dataValue or HttpService:JSONEncode(dataValue)
    local res = ZS.DB.RawRequest(ZS.DB.BuildUrl(nodePath, false), "PUT", encoded)
    if res.StatusCode >= 400 then
        local _, errText = parseFirebaseError(res.Body)
        return false, ZS.DB.FormatError(errText or ("HTTP " .. tostring(res.StatusCode)))
    end
    local hasErr, errMsg = parseFirebaseError(res.Body)
    if hasErr then
        return false, ZS.DB.FormatError(errMsg)
    end
    return true, nil
end

function ZS.DB.PutAsync(nodePath, dataValue)
    local now = os.clock()
    if now - ZS._throttling.LastWindow < 1.0 then
        ZS._throttling.BurstCount = ZS._throttling.BurstCount + 1
        if ZS._throttling.BurstCount > 18 then return end
    else
        ZS._throttling.BurstCount = 1
        ZS._throttling.LastWindow = now
    end

    local encoded = type(dataValue) == "string" and dataValue or HttpService:JSONEncode(dataValue)
    task.spawn(function()
        local res = ZS.DB.RawRequest(ZS.DB.BuildUrl(nodePath, false), "PUT", encoded)
        if res.StatusCode >= 400 then
            task.wait(0.7)
            ZS.DB.RawRequest(ZS.DB.BuildUrl(nodePath, false), "PUT", encoded)
        end
    end)
end

function ZS.DB.Delete(nodePath)
    local res = ZS.DB.RawRequest(ZS.DB.BuildUrl(nodePath, false), "DELETE")
    if res.StatusCode >= 400 then
        local _, errText = parseFirebaseError(res.Body)
        return false, ZS.DB.FormatError(errText or ("HTTP " .. tostring(res.StatusCode)))
    end
    local hasErr, errMsg = parseFirebaseError(res.Body)
    if hasErr then
        return false, ZS.DB.FormatError(errMsg)
    end
    return true, nil
end

function ZS.DB.DeleteAsync(nodePath)
    task.spawn(function()
        ZS.DB.RawRequest(ZS.DB.BuildUrl(nodePath, false), "DELETE")
    end)
end

