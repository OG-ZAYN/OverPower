function ZS.Stories.StopAudio()
    pcall(function()
        local existing = SoundService:FindFirstChild("ZaynV80_StoryAudio")
        if existing then
            existing:Stop()
            existing:Destroy()
        end
    end)
end

-- Respects Roblox audio permissions & clearly reports unavailable assets
function ZS.Stories.PlayAudio(assetId, startTime, volume, statusLabel)
    ZS.Stories.StopAudio()
    local cleanId = tostring(assetId or ""):gsub("[^%d]", "")
    if cleanId == "" then
        if statusLabel and statusLabel.Parent then
            statusLabel.Text = "🔇 Audio unavailable (invalid Roblox Asset ID)"
        end
        return nil
    end

    local snd = Instance.new("Sound")
    snd.Name = "ZaynV80_StoryAudio"
    snd.SoundId = "rbxassetid://" .. cleanId
    snd.Volume = math.clamp(tonumber(volume) or 0.65, 0, 1)
    snd.Looped = true
    snd.Parent = SoundService

    task.spawn(function()
        local loaded = false
        local t0 = os.clock()
        while snd and snd.Parent and os.clock() - t0 < 4.0 do
            if snd.IsLoaded or snd.TimeLength > 0 then
                loaded = true
                break
            end
            task.wait(0.1)
        end

        if not snd or not snd.Parent then return end
        local ok = pcall(function()
            local st = math.max(0, tonumber(startTime) or 0)
            if snd.TimeLength > 0 and st >= snd.TimeLength then
                st = 0
            end
            snd.TimePosition = st
            snd:Play()
        end)

        if not ok or (not loaded and snd.TimeLength == 0) then
            if statusLabel and statusLabel.Parent then
                statusLabel.Text = "⚠️ Audio restricted or unavailable on Roblox"
            end
        end
    end)

    return snd
end

