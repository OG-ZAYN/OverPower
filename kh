function ZS.Chat.ProcessCommand(rawText)
    local cmd, arg = rawText:match("^/(%S+)%s*(.*)$")
    if not cmd then return false end
    cmd = cmd:lower()
    arg = tostring(arg or ""):match("^%s*(.-)%s*$")

    if cmd == "profile" or cmd == "p" then
        if arg == "" then
            ZS.OpenProfile(ZS.MyUid)
        else
            task.spawn(function()
                local res = ZS.Util.ResolveUser(arg)
                if res and res.UserId then
                    ZS.OpenProfile(res.UserId)
                else
                    ZS.UI.ShowToast("⚠️ Not Found", "No user found for '" .. arg .. "'", Color3.fromRGB(235, 65, 80))
                end
            end)
        end
        return true

    elseif cmd == "edit" then
        ZS.SwitchMode("EditProfile"); return true

    elseif cmd == "stories" or cmd == "story" then
        ZS.SwitchMode("Stories"); return true

    elseif cmd == "createstory" or cmd == "newstory" then
        ZS.SwitchMode("CreateStory"); return true

    elseif cmd == "studio" or cmd == "music" then
        ZS.SwitchMode("MusicStudio"); return true

    elseif cmd == "store" or cmd == "shop" then
        ZS.OpenStore("Decorations"); return true

    elseif cmd == "themes" then
        ZS.OpenStore("Themes"); return true

    elseif cmd == "inbox" or cmd == "dms" then
        ZS.SwitchMode("DM_Inbox"); return true

    elseif cmd == "dm" and arg ~= "" then
        task.spawn(function()
            local res = ZS.Util.ResolveUser(arg)
            if not res or not res.UserId then
                ZS.UI.ShowToast("⚠️ Not Found", "User '" .. arg .. "' not found.", Color3.fromRGB(235, 65, 80))
                return
            end
            local ok, reason = ZS.Backend.CanMessageUser(res.UserId)
            if not ok then
                ZS.UI.ShowToast("🔒 DM Blocked", reason, Color3.fromRGB(235, 65, 80))
                return
            end
            local key = res.Username:lower()
            ZS.State.Cache.DMs[key] = ZS.State.Cache.DMs[key] or {}
            ZS.SwitchMode("DM", key)
        end)
        return true

    elseif cmd == "admin" then
        ZS.SwitchMode("Admin"); return true

    elseif cmd == "clear" then
        clearChatScroll(); return true

    elseif cmd == "help" then
        ZS.Chat.RenderBubble("ZARA", 0,
            "<b>👑 ZAYN SOCIAL V80 COMMANDS:</b>\n" ..
            "/profile [user] • /edit • /stories • /createstory\n" ..
            "/studio • /store • /themes • /dm [user] • /inbox • /clear" ..
            (ZS.Util.IsAdmin() and "\n<b>Admin:</b> /admin • /lock • /unlock • /broadcast [msg] • /ban [user] • /unban [user]" or ""),
            ZS.Util.Now(), "HELP_" .. tostring(os.clock()), false, nil)
        return true

    -- Owner-Only Moderation Slash Commands
    elseif ZS.Util.IsAdmin() then
        if cmd == "lock" then
            ZS.DB.PutAsync(ZS.Nodes.Locks .. "/" .. ZS.State.JobId, true)
            ZS.Chat.SetLockState(true)
            ZS.UI.ShowToast("🔒 Chat Locked", "Server chat is now locked.", Color3.fromRGB(235, 65, 80))
            return true
        elseif cmd == "unlock" then
            ZS.DB.DeleteAsync(ZS.Nodes.Locks .. "/" .. ZS.State.JobId)
            ZS.Chat.SetLockState(false)
            ZS.UI.ShowToast("🔓 Chat Unlocked", "Server chat unlocked.", Color3.fromRGB(0, 225, 145))
            return true
        elseif cmd == "broadcast" and arg ~= "" then
            ZS.DB.PutAsync(ZS.Nodes.Broadcasts, { msg = arg, time = ZS.Util.Now() })
            ZS.UI.ShowGlobalBanner(arg)
            return true
        elseif cmd == "ban" and arg ~= "" then
            ZS.DB.PutAsync(ZS.Nodes.Blacklist .. "/Accs/" .. arg:lower(), '"true"')
            ZS.UI.ShowToast("⛔ Blacklisted", "@" .. arg .. " permanently restricted.", Color3.fromRGB(235, 55, 70))
            return true
        elseif cmd == "unban" and arg ~= "" then
            task.spawn(function()
                local low = arg:lower()
                local hw = ZS.DB.Get(ZS.Nodes.Blacklist .. "/Accs/" .. low)
                ZS.DB.Delete(ZS.Nodes.Blacklist .. "/Accs/" .. low)
                if type(hw) == "string" and hw ~= "" and hw ~= "true" then
                    ZS.DB.Delete(ZS.Nodes.Blacklist .. "/HWs/" .. hw)
                end
                ZS.UI.ShowToast("🔓 Unbanned", "@" .. arg .. " unbanned.", Color3.fromRGB(0, 225, 145))
            end)
            return true
        end
    end

    return false
end

function ZS.Chat.Send(rawMessage)
    local text = tostring(rawMessage or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" then return end

    if text:sub(1, 1) == "/" and ZS.Chat.ProcessCommand(text) then
        return
    end

    if ZS.State.IsLocked and not ZS.Util.IsAdmin() then
        ZS.UI.ShowToast("🔒 Locked", "Server chat is locked by Admin.", Color3.fromRGB(235, 65, 80))
        return
    end

    -- Rate limit & spam protection
    local nowClock = os.clock()
    if nowClock - ZS.State.LastSendTime < ZS.Config.ChatCooldown and not ZS.Util.IsAdmin() then
        return
    end
    if #text > 380 then text = text:sub(1, 380) end

    local finalBody = text
    local ts = ZS.Util.Now()
    local msgId = ZS.State.EditingMsgID or ("M_" .. tostring(ts) .. "_" .. ZS.Util.GenerateKey(6))

    if ZS.State.EditingMsgID then
        finalBody = "[EDT]" .. text
    elseif ZS.State.ReplyingTo then
        finalBody = string.format("[RPL::%s::%s::RPL] %s",
            tostring(ZS.State.ReplyingTo.Username),
            tostring(ZS.State.ReplyingTo.Text),
            text)
    end

    local isEdit = (ZS.State.EditingMsgID ~= nil)
    ZS.State.LastSendTime = nowClock
    ZS.State.LastSentMessage = text
    ZS.Chat.CancelActionBar()

    -- DM Mode Send (Encrypted E2E)
    if ZS.State.Mode == "DM" and ZS.State.ActiveDM then
        local partnerLow = ZS.State.ActiveDM
        local acc = ZS.Util.GetAccount(partnerLow)
        if acc and acc.UserId > 1 then
            local canDM, why = ZS.Backend.CanMessageUser(acc.UserId)
            if not canDM then
                ZS.UI.ShowToast("🔒 DM Restricted", why, Color3.fromRGB(235, 65, 80))
                return
            end
        end

        local dmKey = ZS.Crypto.GetDMKey(ZS.MyNameLower, partnerLow)
        local encMsg, sig = ZS.Crypto.Encrypt(dmKey, finalBody)
        local payload = {
            u = ZS.Player.UserId,
            s = ZS.MyName,
            m = encMsg,
            sign = sig,
            t = ts
        }

        ZS.State.SeenIDs[msgId] = true
        ZS.State.Cache.DMs[partnerLow] = ZS.State.Cache.DMs[partnerLow] or {}
        if isEdit then
            for _, item in ipairs(ZS.State.Cache.DMs[partnerLow]) do
                if item.ID == msgId then item.Msg = finalBody; item.Edited = true; break end
            end
            if ZS.State.ActiveBubbles[msgId] then ZS.State.ActiveBubbles[msgId]:Destroy() end
        else
            table.insert(ZS.State.Cache.DMs[partnerLow], {
                ID = msgId, Sender = ZS.MyName, UserID = ZS.Player.UserId,
                Msg = finalBody, Time = ts, Edited = false, Reactions = {}
            })
        end

        ZS.Chat.RenderBubble(ZS.MyName, ZS.Player.UserId, finalBody, ts, msgId, isEdit, nil)
        ZS.Chat.SetLastRead(partnerLow, ts)

        ZS.DB.PutAsync(ZS.Nodes.DMs .. "/" .. ZS.MyNameLower .. "/" .. partnerLow .. "/" .. msgId, payload)
        ZS.DB.PutAsync(ZS.Nodes.DMs .. "/" .. partnerLow .. "/" .. ZS.MyNameLower .. "/" .. msgId, payload)
        return
    end

    -- Server Chat Mode Send (Encrypted per JobId)
    local srvKey = ZS.Crypto.ServerSalt .. ZS.State.JobId
    local encMsg, sig = ZS.Crypto.Encrypt(srvKey, finalBody)
    local payload = {
        u = ZS.Player.UserId,
        s = ZS.MyName,
        m = encMsg,
        sign = sig,
        t = ts
    }

    ZS.State.SeenIDs[msgId] = true
    if isEdit then
        for _, item in ipairs(ZS.State.Cache.Server) do
            if item.ID == msgId then item.Msg = finalBody; item.Edited = true; break end
        end
        if ZS.State.ActiveBubbles[msgId] then ZS.State.ActiveBubbles[msgId]:Destroy() end
    else
        table.insert(ZS.State.Cache.Server, {
            ID = msgId, Sender = ZS.MyName, UserID = ZS.Player.UserId,
            Msg = finalBody, Time = ts, Edited = false, Reactions = {}
        })
    end

    ZS.Chat.RenderBubble(ZS.MyName, ZS.Player.UserId, finalBody, ts, msgId, isEdit, nil)
    ZS.DB.PutAsync(ZS.Nodes.ServerChat .. "/" .. ZS.State.JobId .. "/" .. msgId, payload)
end

