function ZS.Util.Now()
    return os.time()
end

function ZS.Util.NormalizeUid(uid)
    local str = tostring(uid or ""):gsub("[^%d]", "")
    local n = tonumber(str)
    if str == "" or not n or n <= 0 then return nil end
    return str
end

function ZS.Util.CountKeys(tbl)
    if type(tbl) ~= "table" then return 0 end
    local c = 0
    for _, v in pairs(tbl) do
        if v ~= nil and v ~= false then c = c + 1 end
    end
    return c
end

function ZS.Util.DeepEqual(a, b)
    local ta, tb = type(a), type(b)
    if ta ~= tb then return false end
    if ta ~= "table" then return a == b end
    for k, v in pairs(a) do
        if b[k] == nil or not ZS.Util.DeepEqual(v, b[k]) then return false end
    end
    for k, v in pairs(b) do
        if a[k] == nil or not ZS.Util.DeepEqual(v, a[k]) then return false end
    end
    return true
end

function ZS.Util.FormatNumber(n)
    local num = math.floor(tonumber(n) or 0)
    local s = tostring(num)
    while true do
        local k
        s, k = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return s
end

function ZS.Util.TimeAgo(ts)
    local diff = math.max(0, ZS.Util.Now() - (tonumber(ts) or ZS.Util.Now()))
    if diff < 60 then return "Just now"
    elseif diff < 3600 then return tostring(math.floor(diff / 60)) .. "m ago"
    elseif diff < 86400 then return tostring(math.floor(diff / 3600)) .. "h ago"
    else return tostring(math.floor(diff / 86400)) .. "d ago" end
end

function ZS.Util.GenerateKey(len)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    local out = {}
    for idx = 1, (len or 18) do
        local r = math.random(1, #chars)
        out[idx] = chars:sub(r, r)
    end
    return table.concat(out)
end

