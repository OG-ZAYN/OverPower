function ZS.UI.RefreshProfilePage(targetUid)
    local page = ZS.UI.ProfilePage
    if not page then return end

    profileRenderSeq = profileRenderSeq + 1
    local mySeq = profileRenderSeq
    local uidStr = ZS.Util.NormalizeUid(targetUid or ZS.State.ViewingProfileUid) or ZS.MyUid
    ZS.State.ViewingProfileUid = uidStr

    for _, ch in ipairs(page:GetChildren()) do
        if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") and not ch:IsA("UIGradient") then
            ch:Destroy()
        end
    end

    local loader = Instance.new("TextLabel", page)
    loader.Size = UDim2.new(1, 0, 0, 70)
    loader.BackgroundTransparency = 1
    loader.Font = Enum.Font.GothamBold
    loader.TextSize = 12
    loader.TextColor3 = Color3.fromRGB(175, 95, 255)
    loader.Text = "◐ Loading Profile..."
    loader.ZIndex = 32

    task.spawn(function()
        local isMe = (uidStr == ZS.MyUid)
        local prof = ZS.Backend.FetchProfile(uidStr, true)
        ZS.Backend.FetchGraph(uidStr, true)
        if not isMe then
            ZS.Backend.FetchGraph(ZS.MyUid, false)
        else
            ZS.Backend.FetchMyRequests()
        end
        local isOnline = ZS.Backend.FetchPresence(uidStr)
        local userStories = ZS.Backend.FetchUserStories(uidStr, true)
        local storyRingState = ZS.Backend.GetStoryRingState(uidStr)

        local isBlocked = (not isMe) and ZS.Backend.IsBlocked(uidStr)
        local isBlockedBy = (not isMe) and ZS.Backend.IsBlockedBy(uidStr)
        local isFollowing = (not isMe) and ZS.Backend.IsFollowing(uidStr)
        local isFollowedBy = (not isMe) and ZS.Backend.IsFollowedBy(uidStr)
        local hasPending = (not isMe) and (not isFollowing) and ZS.Backend.HasSentRequestTo(uidStr)

        if profileRenderSeq ~= mySeq or not page or not page.Parent then return end
        if loader and loader.Parent then loader:Destroy() end

        if not prof then
            local err = Instance.new("TextLabel", page)
            err.Size = UDim2.new(1, 0, 0, 60)
            err.BackgroundTransparency = 1
            err.Font = Enum.Font.GothamBold
            err.TextSize = 12
            err.TextColor3 = Color3.fromRGB(240, 75, 90)
            err.Text = "⚠️ Failed to load profile."
            err.ZIndex = 32
            return
        end

        local themeObj = ZS.Catalog.ResolveProfileTheme(prof.theme)
        local isPaidTheme = (themeObj.id ~= "default_base")
        local followerCnt = ZS.Backend.GetFollowerCount(uidStr)
        local followingCnt = ZS.Backend.GetFollowingCount(uidStr)
        local isPrivateLocked = (not isMe) and prof.privacy and prof.privacy.isPrivate and (not isFollowing)
        local canViewLists = isMe or (not isPrivateLocked and not (prof.privacy and prof.privacy.hideLists))

        -- Transform complete Profile Page background to active Theme
        page.BackgroundColor3 = themeObj.bg1
        page.ScrollBarImageColor3 = themeObj.accent
        if ZS.UI.ProfileCanvasGrad then
            ZS.UI.ProfileCanvasGrad.Color = ColorSequence.new(themeObj.bg1, themeObj.bg2)
        end
        if ZS.UI.Title then
            ZS.UI.Title.Text = isMe and "MY PROFILE" or ("@" .. tostring(prof.username))
        end

        -- 1. QUICK PROFILE FINDER BAR
        local findBar = Instance.new("Frame", page)
        findBar.Size = UDim2.new(1, 0, 0, 32)
        findBar.BackgroundColor3 = themeObj.cardBg
        findBar.LayoutOrder = 1
        findBar.ZIndex = 33
        Instance.new("UICorner", findBar).CornerRadius = UDim.new(0, 10)
        local fSt = Instance.new("UIStroke", findBar)
        fSt.Color = themeObj.border1
        fSt.Transparency = 0.55

        local findIn = Instance.new("TextBox", findBar)
        findIn.Size = UDim2.new(1, -66, 1, 0)
        findIn.Position = UDim2.new(0, 10, 0, 0)
        findIn.BackgroundTransparency = 1
        findIn.Font = Enum.Font.GothamMedium
        findIn.TextSize = 11
        findIn.TextColor3 = themeObj.textColor
        findIn.PlaceholderText = "Search user profile by Username or UserId..."
        findIn.PlaceholderColor3 = themeObj.subText
        findIn.TextXAlignment = Enum.TextXAlignment.Left
        findIn.ClearTextOnFocus = false
        findIn.Text = ""
        findIn.ZIndex = 34

        local goBtn = Instance.new("TextButton", findBar)
        goBtn.Size = UDim2.new(0, 52, 0, 24)
        goBtn.Position = UDim2.new(1, -56, 0.5, -12)
        goBtn.BackgroundColor3 = themeObj.buttonBg
        goBtn.Font = Enum.Font.GothamBold
        goBtn.TextSize = 10
        goBtn.TextColor3 = themeObj.buttonText
        goBtn.Text = "🔍 GO"
        goBtn.ZIndex = 34
        Instance.new("UICorner", goBtn).CornerRadius = UDim.new(0, 6)
        ZS.Util.AttachButtonJuice(goBtn, 1.05)

        local function doLookup()
            local q = findIn.Text:match("^%s*(.-)%s*$")
            if q == "" then return end
            goBtn.Text = "..."
            task.spawn(function()
                local res = ZS.Util.ResolveUser(q)
                if goBtn and goBtn.Parent then goBtn.Text = "🔍 GO" end
