function ZS.Chat.GetLastRead(dmKey)
    local tbl = ZS.Util.ReadLocalJSON(ZS.LocalFiles.LastRead, {})
    if not dmKey then return tbl end
    return tonumber(tbl[dmKey]) or 0
end

function ZS.Chat.SetLastRead(dmKey, ts)
    local tbl = ZS.Util.ReadLocalJSON(ZS.LocalFiles.LastRead, {})
    tbl[dmKey] = ts
    ZS.Util.WriteLocalJSON(ZS.LocalFiles.LastRead, tbl)
end

function ZS.Chat.GetUnreadCount(dmKey)
    local count, lr = 0, ZS.Chat.GetLastRead(dmKey)
    for _, msg in ipairs(ZS.State.Cache.DMs[dmKey] or {}) do
        if (tonumber(msg.Time) or 0) > lr and msg.UserID ~= ZS.Player.UserId then
            count = count + 1
        end
    end
    return count
end

function ZS.Chat.SetLockState(locked)
    ZS.State.IsLocked = locked == true
    if not ZS.UI.TextBox then return end
    local theme = ZS.Catalog.GetChatTheme()
    if ZS.State.IsLocked then
        ZS.UI.TextBox.TextEditable = false
        ZS.UI.TextBox.Text = ""
        ZS.UI.TextBox.PlaceholderText = "🔒 ZAYN CHAT LOCKED BY ADMIN"
        ZS.UI.TextBox.TextColor3 = Color3.fromRGB(255, 80, 90)
        ZS.UI.SendBtn.BackgroundColor3 = Color3.fromRGB(90, 22, 30)
    else
        ZS.UI.TextBox.TextEditable = true
        ZS.UI.TextBox.PlaceholderText = "Type message..."
        ZS.UI.TextBox.TextColor3 = theme.TextColor
        ZS.UI.SendBtn.BackgroundColor3 = theme.Accent
    end
end

function ZS.Chat.ToggleReaction(msgId, emoji)
    task.spawn(function()
        local myLow = ZS.MyNameLower
        local basePath = ZS.Nodes.ServerChat .. "/" .. ZS.State.JobId .. "/" .. msgId .. "/_rct"
        local isDM, partner = false, nil
        if ZS.State.Mode == "DM" and ZS.State.ActiveDM then
            isDM = true
            partner = ZS.State.ActiveDM
            basePath = ZS.Nodes.DMs .. "/" .. myLow .. "/" .. partner .. "/" .. msgId .. "/_rct"
        end

        local list = (ZS.State.Mode == "Server") and ZS.State.Cache.Server or (isDM and ZS.State.Cache.DMs[partner] or nil)
        local msgRef, rct = nil, {}
        if list then
            for _, item in ipairs(list) do
                if item.ID == msgId then msgRef = item; rct = item.Reactions or {}; break end
            end
        end

        local existingHex = nil
        for hexKey, users in pairs(rct) do
            if type(users) == "table" and users[myLow] then existingHex = hexKey; break end
        end

        local targetHex = ZS.Crypto.HexEncode(emoji)
        if not targetHex or targetHex == "" then return end

        if existingHex == targetHex then
            rct[existingHex][myLow] = nil
            if next(rct[existingHex]) == nil then rct[existingHex] = nil end
            ZS.DB.DeleteAsync(basePath .. "/" .. existingHex .. "/" .. myLow)
            if isDM then
                ZS.DB.DeleteAsync(ZS.Nodes.DMs .. "/" .. partner .. "/" .. myLow .. "/" .. msgId .. "/_rct/" .. existingHex .. "/" .. myLow)
            end
        else
            if existingHex then
                rct[existingHex][myLow] = nil
                if next(rct[existingHex]) == nil then rct[existingHex] = nil end
                ZS.DB.DeleteAsync(basePath .. "/" .. existingHex .. "/" .. myLow)
                if isDM then
                    ZS.DB.DeleteAsync(ZS.Nodes.DMs .. "/" .. partner .. "/" .. myLow .. "/" .. msgId .. "/_rct/" .. existingHex .. "/" .. myLow)
                end
            end
            rct[targetHex] = rct[targetHex] or {}
            rct[targetHex][myLow] = true
            ZS.DB.PutAsync(basePath .. "/" .. targetHex .. "/" .. myLow, true)
            if isDM then
                ZS.DB.PutAsync(ZS.Nodes.DMs .. "/" .. partner .. "/" .. myLow .. "/" .. msgId .. "/_rct/" .. targetHex .. "/" .. myLow, true)
            end
        end

        if msgRef then
            msgRef.Reactions = rct
            ZS.Chat.UpdateBubbleReactions(msgId, rct)
        end
    end)
end

function ZS.Chat.HandleScroll(forceBottom)
    task.spawn(function()
        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()
        local sc = ZS.UI.Scroll
        if not sc then return end
        local maxY = sc.CanvasSize.Y.Offset - sc.AbsoluteWindowSize.Y
        if maxY <= 0 then
            if ZS.UI.JumpBtn then ZS.UI.JumpBtn.Visible = false end
            return
        end
        local twInfo = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        if forceBottom or sc.CanvasPosition.Y >= maxY - 60 then
            TweenService:Create(sc, twInfo, { CanvasPosition = Vector2.new(0, maxY) }):Play()
            if ZS.UI.JumpBtn then ZS.UI.JumpBtn.Visible = false end
        else
            if ZS.UI.JumpBtn then ZS.UI.JumpBtn.Visible = true end
        end
    end)
end

