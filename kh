                            ZS.UI.RefreshAdminPage("Tickets")
                        end)
                    end)
                end
            end

        -- ================================================================= --
        -- [TAB 2 : USER SEARCH, OWNERSHIP INSPECTOR & GRANT / REVOKE]
        -- ================================================================= --
        elseif activeTab == "Users" then
            local regUsers = ZS.Backend.AdminFetchUsersList()
