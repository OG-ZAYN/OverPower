function ZS.Util.RegisterAccount(username, displayName, userId, targetLabel)
    if type(username) ~= "string" or username == "" then return end
    local low = username:lower()
    local uidNum = tonumber(userId) or 1
    if not ZS.AccountRegistry[low] then
        ZS.AccountRegistry[low] = {
            Username = username,
            DisplayName = (displayName and displayName ~= "") and displayName or username,
            UserId = uidNum,
            Verified = false
        }
    else
        if uidNum > 1 then ZS.AccountRegistry[low].UserId = uidNum end
        if displayName and displayName ~= "" then ZS.AccountRegistry[low].DisplayName = displayName end
    end

    if uidNum > 1 then
        local uidStr = tostring(uidNum)
        ZS.UsernameIdCache[low] = uidNum
        ZS.IdUsernameCache[uidStr] = ZS.AccountRegistry[low].Username
        ZS.DisplayNameCache[uidStr] = ZS.AccountRegistry[low].DisplayName
    end

    if targetLabel and ZS.AccountRegistry[low].Verified then
        targetLabel.Text = ZS.AccountRegistry[low].DisplayName .. " (@" .. ZS.AccountRegistry[low].Username .. ")"
    elseif not ZS.AccountRegistry[low].Verified and uidNum > 1 and UserService then
        task.spawn(function()
            local ok, arr = pcall(function() return UserService:GetUserInfosByUserIdsAsync({ uidNum }) end)
            if ok and type(arr) == "table" and arr[1] and arr[1].Username then
                local info = arr[1]
                ZS.AccountRegistry[low].Username = info.Username
                ZS.AccountRegistry[low].DisplayName = info.DisplayName or info.Username
                ZS.AccountRegistry[low].Verified = true
                ZS.IdUsernameCache[tostring(uidNum)] = info.Username
                ZS.DisplayNameCache[tostring(uidNum)] = info.DisplayName or info.Username
                if targetLabel and targetLabel.Parent then
                    targetLabel.Text = (info.DisplayName or info.Username) .. " (@" .. info.Username .. ")"
                end
            end
        end)
    end
end

function ZS.Util.GetAccount(username)
    if type(username) ~= "string" or username == "" then
        return { Username = "Unknown", DisplayName = "Unknown", UserId = 1, Verified = false }
    end
    local low = username:lower()
    if ZS.AccountRegistry[low] then return ZS.AccountRegistry[low] end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower() == low then
            ZS.Util.RegisterAccount(plr.Name, plr.DisplayName, plr.UserId)
            return ZS.AccountRegistry[low]
        end
    end
    return { Username = username, DisplayName = username, UserId = ZS.UsernameIdCache[low] or 1, Verified = false }
end

function ZS.Util.GetAccountByUid(uid)
    local uidStr = ZS.Util.NormalizeUid(uid)
    if not uidStr then return { Username = "Unknown", DisplayName = "Unknown", UserId = 0, Verified = false } end
    local uidNum = tonumber(uidStr)
    local livePlr = Players:GetPlayerByUserId(uidNum)
    if livePlr then
        ZS.Util.RegisterAccount(livePlr.Name, livePlr.DisplayName, livePlr.UserId)
        return ZS.AccountRegistry[livePlr.Name:lower()]
    end
    local prof = ZS.State.Profiles[uidStr]
    if prof and prof.username then
        ZS.Util.RegisterAccount(prof.username, prof.displayName or prof.username, uidNum)
        return { Username = prof.username, DisplayName = prof.displayName or prof.username, UserId = uidNum, Verified = true }
    end
    if ZS.IdUsernameCache[uidStr] then
        local u = ZS.IdUsernameCache[uidStr]
        return { Username = u, DisplayName = ZS.DisplayNameCache[uidStr] or u, UserId = uidNum, Verified = true }
    end
    return { Username = "User_" .. uidStr, DisplayName = "User " .. uidStr, UserId = uidNum, Verified = false }
end

function ZS.Util.ResolveUser(query)
    local clean = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("^@", "")
    if clean == "" then return nil end

    if clean:match("^%d+$") then
        local uidNum = tonumber(clean)
        if not uidNum or uidNum <= 0 then return nil end
        local livePlr = Players:GetPlayerByUserId(uidNum)
        if livePlr then
            ZS.Util.RegisterAccount(livePlr.Name, livePlr.DisplayName, livePlr.UserId)
            return { UserId = livePlr.UserId, Username = livePlr.Name, DisplayName = livePlr.DisplayName }
        end
        if ZS.IdUsernameCache[clean] then
            return { UserId = uidNum, Username = ZS.IdUsernameCache[clean], DisplayName = ZS.DisplayNameCache[clean] or ZS.IdUsernameCache[clean] }
        end
        if UserService then
            local ok, arr = pcall(function() return UserService:GetUserInfosByUserIdsAsync({ uidNum }) end)
            if ok and type(arr) == "table" and arr[1] and arr[1].Username then
                ZS.Util.RegisterAccount(arr[1].Username, arr[1].DisplayName or arr[1].Username, uidNum)
                return { UserId = uidNum, Username = arr[1].Username, DisplayName = arr[1].DisplayName or arr[1].Username }
            end
        end
        local okN, uname = pcall(function() return Players:GetNameFromUserIdAsync(uidNum) end)
        if okN and uname then
            ZS.Util.RegisterAccount(uname, uname, uidNum)
            return { UserId = uidNum, Username = uname, DisplayName = uname }
        end
        return nil
    end

    local low = clean:lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower() == low or plr.DisplayName:lower() == low then
            ZS.Util.RegisterAccount(plr.Name, plr.DisplayName, plr.UserId)
            return { UserId = plr.UserId, Username = plr.Name, DisplayName = plr.DisplayName }
        end
    end

    local okId, foundUid = pcall(function() return Players:GetUserIdFromNameAsync(clean) end)
    if okId and foundUid and foundUid > 0 then
        local uname, dname = clean, clean
        if UserService then
            pcall(function()
                local arr = UserService:GetUserInfosByUserIdsAsync({ foundUid })
                if arr and arr[1] then
                    uname = arr[1].Username or clean
                    dname = arr[1].DisplayName or uname
                end
            end)
        end
        ZS.Util.RegisterAccount(uname, dname, foundUid)
        return { UserId = foundUid, Username = uname, DisplayName = dname }
    end
    return nil
end

-- Safe Image Loader: Supports Roblox Asset IDs, rbxthumb, and direct URLs via getcustomasset
function ZS.Util.LoadImageSafe(imgObj, src, fallbackUid)
    if not imgObj or not imgObj.Parent then return end
    local s = tostring(src or ""):gsub("^%s+", ""):gsub("%s+$", "")

    if s == "" then
        if fallbackUid and tonumber(fallbackUid) and tonumber(fallbackUid) > 0 then
            imgObj.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(fallbackUid) .. "&w=150&h=150"
        else
            imgObj.Image = "rbxthumb://type=Asset&id=81131373496932&w=150&h=150"
        end
        return
    end

    if s:match("^%d+$") then
        imgObj.Image = "rbxthumb://type=Asset&id=" .. s .. "&w=420&h=420"
        return
    end

    if s:sub(1, 13):lower() == "rbxassetid://" or s:sub(1, 11):lower() == "rbxthumb://" then
        imgObj.Image = s
        return
    end

    if s:match("^https?://") then
        if not getcustomasset or not writefile or not isfile then
            imgObj.Image = "rbxthumb://type=Asset&id=81131373496932&w=150&h=150"
            return
        end
        local fileKey = "ZaynV80_Img_" .. ZS.Crypto.Hash(s) .. ".png"
        if pcall(isfile, fileKey) and isfile(fileKey) then
            pcall(function() imgObj.Image = getcustomasset(fileKey) end)
            return
        end
        task.spawn(function()
            local ok, res = pcall(function() return httpReq({ Url = s, Method = "GET", Timeout = 12 }) end)
            if ok and type(res) == "table" and res.StatusCode == 200 and res.Body and #res.Body > 100 then
                pcall(function()
                    writefile(fileKey, res.Body)
                    if imgObj and imgObj.Parent then
                        imgObj.Image = getcustomasset(fileKey)
                    end
                end)
            end
        end)
    end
end

function ZS.Util.LoadAvatarHeadshot(imgObj, uid, customAsset)
    if not imgObj then return end
    if type(customAsset) == "string" and customAsset ~= "" then
        ZS.Util.LoadImageSafe(imgObj, customAsset, uid)
        return
    end
    local n = tonumber(uid)
    if n and n > 0 then
        imgObj.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(n) .. "&w=150&h=150"
    else
        imgObj.Image = "rbxthumb://type=Asset&id=81131373496932&w=150&h=150"
    end
end

function ZS.Util.AttachButtonJuice(btn, hoverScale)
    if not btn or not btn:IsA("GuiObject") then return end
    local sc = btn:FindFirstChild("V80Scale") or Instance.new("UIScale")
    sc.Name = "V80Scale"
    sc.Scale = 1.0
    sc.Parent = btn
    local st = btn:FindFirstChildWhichIsA("UIStroke")

    btn.MouseEnter:Connect(function()
        TweenService:Create(sc, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = hoverScale or 1.04 }):Play()
        if st then TweenService:Create(st, TweenInfo.new(0.15), { Thickness = math.max(1.8, st.Thickness) }):Play() end
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(sc, TweenInfo.new(0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Scale = 1.0 }):Play()
        if st then TweenService:Create(st, TweenInfo.new(0.15), { Thickness = 1.3 }):Play() end
    end)
    if btn:IsA("TextButton") or btn:IsA("ImageButton") then
        btn.MouseButton1Down:Connect(function()
            TweenService:Create(sc, TweenInfo.new(0.08, Enum.EasingStyle.Quad), { Scale = 0.94 }):Play()
        end)
        btn.MouseButton1Up:Connect(function()
            TweenService:Create(sc, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = hoverScale or 1.04 }):Play()
        end)
    end
end

