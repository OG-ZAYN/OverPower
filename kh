function ZS.Chat.DressInboxCard(card, dmKey, lastMsg, unreadCnt)
    local theme = ZS.Catalog.GetChatTheme()
    local sub = card:FindFirstChild("Sub")
    if sub then
        local clean = ZS.Util.SanitizePreviewText(lastMsg)
        sub.Text = clean:sub(1, 34) .. (#clean > 34 and "..." or "")
    end
    local badge = card:FindFirstChild("UnreadBadge")
    if unreadCnt > 0 then
        if not badge then
            badge = Instance.new("TextLabel", card)
            badge.Name = "UnreadBadge"
            badge.Size = UDim2.new(0, 52, 0, 20)
            badge.Position = UDim2.new(1, -94, 0.5, -10)
            badge.BackgroundColor3 = theme.Accent
