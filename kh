function ZS.Backend.DeleteStory(ownerUid, storyId)
    local oUid = ZS.Util.NormalizeUid(ownerUid)
    if not oUid or not storyId then return false, "Invalid story" end
    if oUid ~= ZS.MyUid and not ZS.Util.IsAdmin() then
        return false, "Unauthorized: Only owner or Admin can delete stories"
    end
    local ok, errMsg = ZS.DB.Delete(ZS.Nodes.Stories .. "/" .. oUid .. "/" .. storyId)
    if ok then
        ZS.DB.DeleteAsync(ZS.Nodes.StoryViews .. "/" .. storyId)
        if ZS.State.StoriesByUid[oUid] then
            for idx, st in ipairs(ZS.State.StoriesByUid[oUid]) do
                if st.id == storyId then table.remove(ZS.State.StoriesByUid[oUid], idx); break end
            end
        end
    end
    return ok, ok and "Story deleted." or errMsg
end

