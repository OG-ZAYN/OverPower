function ZS.Chat.UpdateBubbleReactions(msgId, rctTbl)
    local row = ZS.State.ActiveBubbles[msgId]
    if not row or not row:FindFirstChild("MessageBubble") then return end
    local holder = row.MessageBubble:FindFirstChild("ReactContainer")
    if not holder then return end
    for _, ch in ipairs(holder:GetChildren()) do
        if ch:IsA("TextButton") then ch:Destroy() end
    end
    if type(rctTbl) ~= "table" then return end

    local theme = ZS.Catalog.GetChatTheme()
    for hexKey, users in pairs(rctTbl) do
        local emoji = ZS.Crypto.HexDecode(hexKey)
        if emoji and type(users) == "table" then
            local cnt, iReacted = 0, false
            for uKey, val in pairs(users) do
                if val then
                    cnt = cnt + 1
                    if uKey == ZS.MyNameLower then iReacted = true end
                end
            end
            if cnt > 0 then
                local pill = Instance.new("TextButton", holder)
                pill.Size = UDim2.new(0, 0, 0, 20)
                pill.AutomaticSize = Enum.AutomaticSize.X
                pill.BackgroundColor3 = iReacted and theme.Accent or Color3.fromRGB(34, 32, 48)
                pill.BackgroundTransparency = iReacted and 0.15 or 0.35
                pill.Font = Enum.Font.GothamBold
                pill.TextSize = 11
                pill.TextColor3 = Color3.fromRGB(255, 255, 255)
                pill.Text = emoji .. " " .. tostring(cnt)
                Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)
                local pPad = Instance.new("UIPadding", pill)
                pPad.PaddingLeft = UDim.new(0, 7); pPad.PaddingRight = UDim.new(0, 7)
                pill.MouseButton1Click:Connect(function() ZS.Chat.ToggleReaction(msgId, emoji) end)
            end
        end
    end
end

