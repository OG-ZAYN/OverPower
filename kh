-- ========================================================================= --
local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local SERVER_CIPHER_SALT = "MATRIX_QUANTUM_CORE_CIPHER_SHIELD_V59_"
local ADMIN_CMD_KEY = "NEXUS_MATRIX_CORE_OVERRIDE_SECURE_KEY"
local DM_SALT = "A7D9E4B2C1F03E5D8A91624B5C3D2E7F8A9B1C3D4E6F8A2B5C7D9E1F0A2B4C6D"

ZS.Crypto.ServerSalt = SERVER_CIPHER_SALT
ZS.Crypto.AdminCmdKey = ADMIN_CMD_KEY

function ZS.Crypto.B64Encode(str)
    return (str:gsub(".", function(c)
        local r, b = "", c:byte()
        for idx = 8, 1, -1 do
            r = r .. (b % 2^idx - b % 2^(idx - 1) > 0 and "1" or "0")
        end
        return r
    end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(bits)
        if #bits < 6 then return "" end
        local val = 0
        for idx = 1, 6 do
            val = val + (bits:sub(idx, idx) == "1" and 2^(6 - idx) or 0)
        end
        return B64_CHARS:sub(val + 1, val + 1)
    end) .. ({ "", "==", "=" })[#str % 3 + 1]
end

function ZS.Crypto.B64Decode(str)
    local clean = tostring(str or ""):gsub("[^" .. B64_CHARS .. "=]", "")
    return clean:gsub(".", function(c)
        if c == "=" then return "" end
        local r, f = "", (B64_CHARS:find(c) - 1)
        for idx = 6, 1, -1 do
            r = r .. (f % 2^idx - f % 2^(idx - 1) > 0 and "1" or "0")
        end
        return r
    end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(bits)
        if #bits ~= 8 then return "" end
        local val = 0
        for idx = 1, 8 do
            val = val + (bits:sub(idx, idx) == "1" and 2^(8 - idx) or 0)
        end
        return string.char(val)
    end)
end

function ZS.Crypto.HexEncode(str)
    return (tostring(str or ""):gsub(".", function(c)
        return string.format("%02X", string.byte(c))
    end))
end

function ZS.Crypto.HexDecode(hex)
    return (tostring(hex or ""):gsub("..", function(cc)
        return string.char(tonumber(cc, 16) or 32)
    end))
end

function ZS.Crypto.Hash(str)
    local h1, h2 = 5381, 2166136261
    for idx = 1, #str do
        local b = string.byte(str, idx)
        h1 = (h1 * 33 + b) % 4294967296
        h2 = bit32.bxor(h2, b) * 16777619 % 4294967296
    end
    return string.format("%08x%08x", h1, h2)
end

function ZS.Crypto.Sign(key, payload)
    return ZS.Crypto.Hash(key .. "::V80_SIGN::" .. payload .. "::" .. key)
end

function ZS.Crypto.GetDMKey(u1, u2)
    local a, b = tostring(u1):lower(), tostring(u2):lower()
    return (a < b) and (a .. "_" .. b .. "_" .. DM_SALT) or (b .. "_" .. a .. "_" .. DM_SALT)
end

local function xorStream(key, text)
    local out = {}
    local kLen = #key
    for idx = 1, #text do
        out[idx] = string.char(bit32.bxor(string.byte(text, idx), string.byte(key, (idx - 1) % kLen + 1)))
    end
    return table.concat(out)
end

function ZS.Crypto.Encrypt(key, plainText)
    local enc = ZS.Crypto.B64Encode(xorStream(key, tostring(plainText or "")))
    return enc, ZS.Crypto.Sign(key, enc)
end

function ZS.Crypto.Decrypt(key, encText, sig)
    if not encText or not sig or ZS.Crypto.Sign(key, encText) ~= sig then
        return nil
    end
    local ok, raw = pcall(ZS.Crypto.B64Decode, encText)
    if not ok or not raw then return nil end
    return xorStream(key, raw)
end

