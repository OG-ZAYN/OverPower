        ZS.DB.DeleteAsync(ZS.Nodes.DMs .. "/" .. myLow .. "/" .. partner .. "/" .. msgId)
        ZS.DB.DeleteAsync(ZS.Nodes.DMs .. "/" .. partner .. "/" .. myLow .. "/" .. msgId)
    else
        ZS.DB.DeleteAsync(ZS.Nodes.ServerChat .. "/" .. ZS.State.JobId .. "/" .. msgId)
    end
    if ZS.State.ActiveBubbles[msgId] then
        ZS.State.ActiveBubbles[msgId]:Destroy()
        ZS.State.ActiveBubbles[msgId] = nil
    end
    ZS.UI.ShowToast("🗑️ Unsent", "Message recalled.", Color3.fromRGB(220, 65, 80))
end

