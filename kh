local lastBroadcastTs = ZS.Util.Now()

local function syncServerChat(silentInitial)
    local raw = ZS.DB.Get(ZS.Nodes.ServerChat .. "/" .. ZS.State.JobId)
    if type(raw) ~= "table" then return end

    local srvKey = ZS.Crypto.ServerSalt .. ZS.State.JobId
    local nowTs = ZS.Util.Now()
    local parsed = {}

    for msgId, item in pairs(raw) do
        if type(item) == "table" and item.m and item.sign and item.s then
            local msgTs = tonumber(item.t) or 0
            if nowTs - msgTs > ZS.Config.ServerChatExpiry then
                ZS.DB.DeleteAsync(ZS.Nodes.ServerChat .. "/" .. ZS.State.JobId .. "/" .. msgId)
            else
                local plain = ZS.Crypto.Decrypt(srvKey, item.m, item.sign)
                if plain then
                    local uid = tonumber(item.u) or 1
                    ZS.Util.RegisterAccount(item.s, item.s, uid)
                    table.insert(parsed, {
                        ID = msgId,
                        Sender = tostring(item.s),
                        UserID = uid,
                        Msg = plain,
                        Time = msgTs,
                        Edited = (plain:sub(1, 5) == "[EDT]"),
                        Reactions = type(item._rct) == "table" and item._rct or {}
                    })
                end
            end
        end
    end

    table.sort(parsed, function(a, b) return a.Time < b.Time end)
    ZS.State.Cache.Server = parsed

    for _, msg in ipairs(parsed) do
        if not ZS.State.SeenIDs[msg.ID] then
            ZS.State.SeenIDs[msg.ID] = true
            if ZS.State.Mode == "Server" then
                ZS.Chat.RenderBubble(msg.Sender, msg.UserID, msg.Msg, msg.Time, msg.ID, msg.Edited, msg.Reactions)
            elseif not silentInitial and not ZS.State.MuteServerToasts and msg.UserID ~= ZS.Player.UserId then
                ZS.UI.ShowToast("💬 " .. ZS.Util.GetAccount(msg.Sender).DisplayName, msg.Msg, ZS.Catalog.GetChatTheme().Accent, msg.UserID, function()
                    ZS.SwitchMode("Server")
                end)
            end
        elseif ZS.State.Mode == "Server" and ZS.State.ActiveBubbles[msg.ID] then
            ZS.Chat.UpdateBubbleReactions(msg.ID, msg.Reactions)
        end
    end
end

local function syncDMs(silentInitial)
    local raw = ZS.DB.Get(ZS.Nodes.DMs .. "/" .. ZS.MyNameLower)
    if type(raw) ~= "table" then return end

    local nowTs = ZS.Util.Now()
    for partnerLow, convo in pairs(raw) do
        if type(convo) == "table" then
            local dmKey = ZS.Crypto.GetDMKey(ZS.MyNameLower, partnerLow)
            local list = {}

            -- Typing indicator in active DM
            if type(convo._typ) == "table" and ZS.State.Mode == "DM" and ZS.State.ActiveDM == partnerLow then
                local typTs = tonumber(convo._typ.t) or 0
                if ZS.UI.SubTitle then
                    if nowTs - typTs <= 4 then
                        ZS.UI.SubTitle.Text = "✍️ typing..."
                    else
                        ZS.UI.SubTitle.Text = "@" .. ZS.Util.GetAccount(partnerLow).Username .. " • Tap name for Profile"
                    end
                end
            end

            for msgId, item in pairs(convo) do
                if msgId ~= "_typ" and type(item) == "table" and item.m and item.sign and item.s then
                    local msgTs = tonumber(item.t) or 0
                    if nowTs - msgTs <= ZS.Config.DMExpiry then
                        local plain = ZS.Crypto.Decrypt(dmKey, item.m, item.sign)
                        if plain then
                            local uid = tonumber(item.u) or 1
                            ZS.Util.RegisterAccount(item.s, item.s, uid)
                            table.insert(list, {
                                ID = msgId,
                                Sender = tostring(item.s),
                                UserID = uid,
                                Msg = plain,
                                Time = msgTs,
                                Edited = (plain:sub(1, 5) == "[EDT]"),
                                Reactions = type(item._rct) == "table" and item._rct or {}
                            })
                        end
                    end
                end
            end

            table.sort(list, function(a, b) return a.Time < b.Time end)
            ZS.State.Cache.DMs[partnerLow] = list

            for _, msg in ipairs(list) do
                if not ZS.State.SeenIDs[msg.ID] then
                    ZS.State.SeenIDs[msg.ID] = true
                    if ZS.State.Mode == "DM" and ZS.State.ActiveDM == partnerLow then
                        ZS.Chat.RenderBubble(msg.Sender, msg.UserID, msg.Msg, msg.Time, msg.ID, msg.Edited, msg.Reactions)
                        ZS.Chat.SetLastRead(partnerLow, nowTs)
                    elseif not silentInitial and msg.UserID ~= ZS.Player.UserId then
                        ZS.UI.ShowToast("📩 DM • " .. ZS.Util.GetAccount(msg.Sender).DisplayName, msg.Msg, Color3.fromRGB(0, 220, 175), msg.UserID, function()
                            ZS.SwitchMode("DM", partnerLow)
                        end)
                    end
                elseif ZS.State.Mode == "DM" and ZS.State.ActiveDM == partnerLow and ZS.State.ActiveBubbles[msg.ID] then
                    ZS.Chat.UpdateBubbleReactions(msg.ID, msg.Reactions)
                end
            end
        end
    end

    if ZS.State.Mode == "DM_Inbox" then
        ZS.Chat.LiveUpdateInboxSort()
    end
end

