            ZS.UI.MusicStudioPage.Visible = true
            ZS.UI.RefreshMusicStudioPage()
        end

    elseif newMode == "Store" then
        if title then title.Text = "👑 ZAYN PAID STORE" end
        if ZS.UI.StorePage then
            ZS.UI.StorePage.Visible = true
            ZS.UI.RefreshPaidStorePage(param or ZS.State.StoreTab)
        end

    elseif newMode == "Notifications" then
