function ZS.Backend.ValidateRobloxAudioAsset(rawInput)
    local clean = tostring(rawInput or ""):gsub("^%s+", ""):gsub("%s+$", "")
    local numId = clean:match("^rbxassetid://(%d+)$") or clean:match("^(%d+)$")
    if not numId then
        if clean:match("^https?://") then
            return false, nil, "External MP3/HTTP URLs cannot play directly in Roblox Sound. Import or use an approved Roblox Audio Asset ID."
        end
        return false, nil, "Enter a valid numeric Roblox Audio Asset ID (e.g. 1848354536)."
    end

    local assetNum = tonumber(numId)
    local ok, info = pcall(function()
        return ZS.Services.Marketplace:GetProductInfo(assetNum, Enum.InfoType.Asset)
    end)

    if ok and type(info) == "table" then
        if tonumber(info.AssetTypeId) and tonumber(info.AssetTypeId) ~= 3 then
            return false, nil, "Asset ID " .. numId .. " is not an Audio asset (Type " .. tostring(info.AssetTypeId) .. ")."
        end
        return true, {
            assetId = numId,
            title = tostring(info.Name or ("Track #" .. numId)):sub(1, 60),
            artist = (type(info.Creator) == "table" and tostring(info.Creator.Name or "Roblox Audio")) or "Roblox Audio",
            duration = 0
        }, nil
    end

    -- Fallback metadata if MarketplaceService rate-limits, still tagged as Roblox Asset ID
    return true, {
        assetId = numId,
        title = "Roblox Audio #" .. numId,
        artist = "Roblox Catalog",
        duration = 0
    }, nil
end

