-- ========================================================================= --
function ZS.UI.RefreshAdminPage(tabOverride)
    local page = ZS.UI.AdminPage
    if not page then return end

    for _, ch in ipairs(page:GetChildren()) do
        if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then ch:Destroy() end
    end

    -- Strict Owner-Only Verification
    if not ZS.Util.IsAdmin() then
        local denied = Instance.new("TextLabel", page)
        denied.Size = UDim2.new(1, 0, 0, 80)
        denied.BackgroundTransparency = 1
        denied.Font = Enum.Font.GothamBold
        denied.TextSize = 13
        denied.TextColor3 = Color3.fromRGB(255, 65, 85)
        denied.Text = "⛔ ACCESS DENIED\nAuthorized Admin UID required."
        denied.ZIndex = 32
        ZS.Security.LogViolation("ADMIN_PANEL_ATTEMPT", "Unauthorized user tried opening Admin Panel")
        return
    end

    if type(tabOverride) == "string" and tabOverride ~= "" then
        ZS.Admin.ActiveTab = tabOverride
    end
    local activeTab = ZS.Admin.ActiveTab or "Tickets"

    adminRenderSeq = adminRenderSeq + 1
    local mySeq = adminRenderSeq

    -- Admin Tab Bar
    local tabBar = Instance.new("Frame", page)
    tabBar.Size = UDim2.new(1, 0, 0, 34)
    tabBar.BackgroundColor3 = Color3.fromRGB(16, 12, 24)
    tabBar.LayoutOrder = 1
    tabBar.ZIndex = 32
    Instance.new("UICorner", tabBar).CornerRadius = UDim.new(0, 10)
    Instance.new("UIStroke", tabBar).Color = Color3.fromRGB(220, 48, 88)

    local tLay = Instance.new("UIListLayout", tabBar)
    tLay.FillDirection = Enum.FillDirection.Horizontal
    tLay.HorizontalAlignment = Enum.HorizontalAlignment.Center
    tLay.VerticalAlignment = Enum.VerticalAlignment.Center
    tLay.Padding = UDim.new(0, 4)
    tLay.SortOrder = Enum.SortOrder.LayoutOrder

    local adminTabs = {
        { id = "Tickets",    lbl = "🎫 Tickets",  ord = 1, col = Color3.fromRGB(255, 195, 45) },
        { id = "Users",      lbl = "👤 Users",    ord = 2, col = Color3.fromRGB(165, 75, 255) },
        { id = "Store",      lbl = "⚙️ Store",    ord = 3, col = Color3.fromRGB(0, 210, 175) },
        { id = "Moderation", lbl = "🛡️ Mod",      ord = 4, col = Color3.fromRGB(235, 58, 88) }
    }

    for _, td in ipairs(adminTabs) do
        local isAct = (td.id == activeTab)
        local tb = Instance.new("TextButton", tabBar)
        tb.Size = UDim2.new(0.242, 0, 0, 26)
        tb.BackgroundColor3 = isAct and td.col or Color3.fromRGB(24, 20, 34)
        tb.Font = Enum.Font.GothamBold
        tb.TextSize = 9.5
        tb.TextColor3 = isAct and Color3.fromRGB(12, 10, 16) or Color3.fromRGB(225, 225, 245)
        tb.Text = td.lbl
        tb.LayoutOrder = td.ord
        tb.ZIndex = 33
        Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 7)
        ZS.Util.AttachButtonJuice(tb, 1.04)
        tb.MouseButton1Click:Connect(function() ZS.UI.RefreshAdminPage(td.id) end)
    end

    local loader = Instance.new("TextLabel", page)
    loader.Size = UDim2.new(1, 0, 0, 48)
    loader.BackgroundTransparency = 1
    loader.Font = Enum.Font.GothamBold
    loader.TextSize = 11.5
    loader.TextColor3 = Color3.fromRGB(255, 110, 145)
    loader.Text = "◐ Loading Admin " .. activeTab .. "..."
    loader.LayoutOrder = 2
    loader.ZIndex = 32

    task.spawn(function()
        -- ================================================================= --
        -- [TAB 1 : PURCHASE VERIFICATION TICKETS QUEUE (₹300 & ₹1500)]
        -- ================================================================= --
        if activeTab == "Tickets" then
            local tickets = ZS.Backend.AdminFetchPurchaseTickets()
            if adminRenderSeq ~= mySeq or not page or not page.Parent then return end
            if loader and loader.Parent then loader:Destroy() end

            local pendingCount = 0
            for _, tk in ipairs(tickets) do
                if tostring(tk.status) == "pending_verification" then pendingCount = pendingCount + 1 end
            end

            local box = makeAdminCard(page, "🎫 PURCHASE VERIFICATION QUEUE (" .. pendingCount .. " Pending / " .. #tickets .. " Total)", Color3.fromRGB(255, 205, 55), 2)

            if #tickets == 0 then
                local em = Instance.new("TextLabel", box)
                em.Size = UDim2.new(1, 0, 0, 34); em.BackgroundTransparency = 1; em.Font = Enum.Font.GothamMedium
                em.TextSize = 10.5; em.TextColor3 = Color3.fromRGB(150, 152, 178); em.Text = "No purchase tickets submitted yet."
                em.LayoutOrder = 2; em.ZIndex = 33
                return
            end

            for idx, tk in ipairs(tickets) do
                if idx > 25 then break end
                local st = tostring(tk.status or "pending_verification")
                local isPend = (st == "pending_verification")

                local card = Instance.new("Frame", box)
                card.Size = UDim2.new(1, 0, 0, isPend and 92 or 60)
                card.BackgroundColor3 = isPend and Color3.fromRGB(28, 22, 40) or Color3.fromRGB(20, 19, 30)
                card.LayoutOrder = idx + 1
                card.ZIndex = 33
                Instance.new("UICorner", card).CornerRadius = UDim.new(0, 9)
                local cSt = Instance.new("UIStroke", card)
                cSt.Color = isPend and Color3.fromRGB(255, 198, 45)
                    or (st == "approved" and Color3.fromRGB(0, 215, 140) or Color3.fromRGB(220, 58, 75))

                local info = Instance.new("TextLabel", card)
                info.Size = UDim2.new(1, -16, 0, 50)
                info.Position = UDim2.new(0, 8, 0, 4)
                info.BackgroundTransparency = 1
                info.Font = Enum.Font.GothamMedium
                info.TextSize = 10
                info.TextColor3 = Color3.fromRGB(242, 244, 255)
                info.TextXAlignment = Enum.TextXAlignment.Left
                info.TextWrapped = true
                info.RichText = true
                info.ZIndex = 34
                local noteStr = (tk.note and tk.note ~= "") and (" • Note: " .. tostring(tk.note)) or ""
                info.Text = string.format("<b>@%s</b> (UID: %s) — <font color='#FFD746'><b>₹%s %s</b></font>\nDiscord: <b>%s</b> • Status: <b>%s</b> • %s%s",
                    tostring(tk.username), tostring(tk.uid), tostring(tk.priceINR or 300),
                    tostring(tk.itemName or tk.itemId), tostring(tk.discordUser or "N/A"),
                    st:upper(), ZS.Util.TimeAgo(tk.createdAt), noteStr)

                if isPend then
                    local bRow = Instance.new("Frame", card)
                    bRow.Size = UDim2.new(1, -16, 0, 28)
                    bRow.Position = UDim2.new(0, 8, 1, -34)
                    bRow.BackgroundTransparency = 1
                    bRow.ZIndex = 34

                    local appBtn = Instance.new("TextButton", bRow)
                    appBtn.Size = UDim2.new(0.56, -3, 1, 0)
                    appBtn.BackgroundColor3 = Color3.fromRGB(0, 178, 122)
                    appBtn.Font = Enum.Font.GothamBold; appBtn.TextSize = 10; appBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    appBtn.Text = "✅ APPROVE & UNLOCK"
                    appBtn.ZIndex = 35
                    Instance.new("UICorner", appBtn).CornerRadius = UDim.new(0, 7)
                    ZS.Util.AttachButtonJuice(appBtn, 1.03)
                    appBtn.MouseButton1Click:Connect(function()
                        appBtn.Text = "◐ Granting..."
                        task.spawn(function()
                            local ok, msg = ZS.Backend.AdminVerifyTicket(tk, true)
                            ZS.UI.ShowToast(ok and "✅ Verified & Unlocked" or "⚠️ Error", msg, Color3.fromRGB(0, 225, 145))
                            ZS.UI.RefreshAdminPage("Tickets")
                        end)
                    end)

                    local rejBtn = Instance.new("TextButton", bRow)
                    rejBtn.Size = UDim2.new(0.44, -3, 1, 0)
                    rejBtn.Position = UDim2.new(0.56, 6, 0, 0)
                    rejBtn.BackgroundColor3 = Color3.fromRGB(185, 42, 56)
                    rejBtn.Font = Enum.Font.GothamBold; rejBtn.TextSize = 10; rejBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    rejBtn.Text = "❌ REJECT"
                    rejBtn.ZIndex = 35
                    Instance.new("UICorner", rejBtn).CornerRadius = UDim.new(0, 7)
                    ZS.Util.AttachButtonJuice(rejBtn, 1.03)
                    rejBtn.MouseButton1Click:Connect(function()
                        rejBtn.Text = "..."
                        task.spawn(function()
