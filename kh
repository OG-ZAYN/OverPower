function ZS.Backend.EmptyEntitlement()
    return {
        cosmeticsBundle = false, -- ₹300 Premium Cosmetics Package
        musicStudioPass = false, -- ₹1500 Music Studio Feature Pass
        ownedDecorations = {},
        ownedThemes = {},
        badges = {},
        grantedBy = "",
        grantedAt = 0,
        history = {}
    }
end

function ZS.Backend.FetchEntitlements(uid, forceRefresh)
    local uidStr = ZS.Util.NormalizeUid(uid)
    if not uidStr then return ZS.Backend.EmptyEntitlement() end

    if not forceRefresh and ZS.State.Entitlements[uidStr] then
        return ZS.State.Entitlements[uidStr]
    end

    local raw = ZS.DB.Get(ZS.Nodes.Entitlements .. "/" .. uidStr)
    local ent = ZS.Backend.EmptyEntitlement()
    if type(raw) == "table" then
        ent.cosmeticsBundle = raw.cosmeticsBundle == true
        ent.musicStudioPass = raw.musicStudioPass == true
        ent.ownedDecorations = type(raw.ownedDecorations) == "table" and raw.ownedDecorations or {}
        ent.ownedThemes = type(raw.ownedThemes) == "table" and raw.ownedThemes or {}
        ent.badges = type(raw.badges) == "table" and raw.badges or {}
        ent.grantedBy = tostring(raw.grantedBy or "")
        ent.grantedAt = tonumber(raw.grantedAt) or 0
        ent.history = type(raw.history) == "table" and raw.history or {}
    end

    -- Authorized Owner UID automatically has full privileges
    if ZS.Util.IsAdmin(uidStr, "") then
        ent.cosmeticsBundle = true
        ent.musicStudioPass = true
    end

    ZS.State.Entitlements[uidStr] = ent
    return ent
end

function ZS.Backend.HasCosmeticsBundle(uid)
    local uidStr = ZS.Util.NormalizeUid(uid) or ZS.MyUid
    if ZS.Util.IsAdmin(uidStr, "") then return true end
    local ent = ZS.State.Entitlements[uidStr]
    return type(ent) == "table" and ent.cosmeticsBundle == true
end

function ZS.Backend.HasMusicStudioPass(uid)
    local uidStr = ZS.Util.NormalizeUid(uid) or ZS.MyUid
    if ZS.Util.IsAdmin(uidStr, "") then return true end
    local ent = ZS.State.Entitlements[uidStr]
    return type(ent) == "table" and ent.musicStudioPass == true
end

-- NOTHING IS FREE: Only "none" (unequipped) is available without payment!
function ZS.Backend.OwnsDecoration(uid, decorId)
    if not decorId or decorId == "" or decorId == "none" then return true end
    local uidStr = ZS.Util.NormalizeUid(uid) or ZS.MyUid
    if ZS.Backend.HasCosmeticsBundle(uidStr) then return true end
    local ent = ZS.State.Entitlements[uidStr]
    return type(ent) == "table" and type(ent.ownedDecorations) == "table" and ent.ownedDecorations[decorId] == true
end

-- NOTHING IS FREE: Only "default_base" (unequipped) is available without payment!
function ZS.Backend.OwnsTheme(uid, themeId)
    if not themeId or themeId == "" or themeId == "default_base" then return true end
    local uidStr = ZS.Util.NormalizeUid(uid) or ZS.MyUid
    if ZS.Backend.HasCosmeticsBundle(uidStr) then return true end
    local ent = ZS.State.Entitlements[uidStr]
    return type(ent) == "table" and type(ent.ownedThemes) == "table" and ent.ownedThemes[themeId] == true
end

