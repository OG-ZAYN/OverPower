function ZS.Music.FormatDuration(sec)
    local s = math.max(0, math.floor(tonumber(sec) or 0))
    local m = math.floor(s / 60)
    local r = s % 60
    return string.format("%d:%02d", m, r)
end

function ZS.Music.StopPreview()
    previewSessionSeq = previewSessionSeq + 1
    if ZS.Music.ActivePreview.animId then
        ZS.Anim.Unregister(ZS.Music.ActivePreview.animId)
        ZS.Music.ActivePreview.animId = nil
    end
    pcall(function()
        if ZS.Music.ActivePreview.sound then
            ZS.Music.ActivePreview.sound:Stop()
            ZS.Music.ActivePreview.sound:Destroy()
        end
        local leftover = SoundService:FindFirstChild("ZaynV80_StudioPreview")
        if leftover then
            leftover:Stop()
            leftover:Destroy()
        end
    end)
    ZS.Music.ActivePreview.sound = nil
    ZS.Music.ActivePreview.track = nil
end

function ZS.Music.PlayPreview(trackObj, onStateUpdate)
    ZS.Stories.StopAudio()
    ZS.Music.StopPreview()

    local mySession = previewSessionSeq
    local cleanId = tostring(trackObj and trackObj.assetId or ""):gsub("[^%d]", "")
    if cleanId == "" then
        if type(onStateUpdate) == "function" then
            onStateUpdate("error", "Invalid Roblox Audio Asset ID — external URLs cannot play directly.")
        end
        return false
    end

    local snd = Instance.new("Sound")
    snd.Name = "ZaynV80_StudioPreview"
    snd.SoundId = "rbxassetid://" .. cleanId
    snd.Volume = math.clamp(tonumber(trackObj.volume) or 0.65, 0, 1)
    snd.Looped = true
    snd.Parent = SoundService

    ZS.Music.ActivePreview.sound = snd
    ZS.Music.ActivePreview.track = trackObj

    if type(onStateUpdate) == "function" then
        onStateUpdate("loading", "Checking Roblox audio asset permissions...")
    end

    task.spawn(function()
        local loaded = false
        local t0 = os.clock()
        while snd and snd.Parent and previewSessionSeq == mySession and os.clock() - t0 < 4.5 do
            if snd.IsLoaded and snd.TimeLength > 0 then
                loaded = true
                break
            end
            task.wait(0.1)
        end

        if previewSessionSeq ~= mySession or not snd or not snd.Parent then return end

        if not loaded or snd.TimeLength <= 0 then
            ZS.Music.StopPreview()
            if type(onStateUpdate) == "function" then
                onStateUpdate("error", "Audio asset #" .. cleanId .. " is restricted, private, or unavailable on Roblox.")
            end
            ZS.UI.ShowToast("⚠️ Audio Unavailable", "Roblox blocked or could not load asset #" .. cleanId .. ".", Color3.fromRGB(235, 75, 88))
            return
        end

        local startPos = math.max(0, tonumber(trackObj.startTime) or 0)
        if startPos >= snd.TimeLength then startPos = 0 end
        local okPlay = pcall(function()
            snd.TimePosition = startPos
            snd:Play()
        end)

        if not okPlay then
            ZS.Music.StopPreview()
            if type(onStateUpdate) == "function" then
                onStateUpdate("error", "Playback failed for asset #" .. cleanId .. ".")
            end
            return
        end

        if type(onStateUpdate) == "function" then
            onStateUpdate("playing", snd.TimeLength)
        end
    end)

    return true
end

